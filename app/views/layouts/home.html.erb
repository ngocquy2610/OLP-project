<!-- Hero Section -->
<section class="relative min-h-[700px] flex items-center overflow-hidden">
  <div class="absolute inset-0 bg-grid-pattern opacity-10 pointer-events-none"></div>
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-primary-container/10 blur-[120px] rounded-full"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-secondary-container/10 blur-[120px] rounded-full"></div>
  
  <div class="max-w-[1280px] mx-auto px-6 relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center py-20">
    <div class="space-y-6">
      <h1 class="font-headline-md text-3xl xl:text-5xl font-bold leading-tight text-on-surface">
        <%= simple_format(t('home.hero.title')) %>
      </h1>
      <p class="font-body-lg text-lg text-slate-text max-w-xl">
        <%= t('home.hero.subtitle') %>
      </p>
      <div class="flex flex-col sm:flex-row gap-4 pt-4">
        <%= link_to courses_path, class: "glow-button px-6 py-3.5 rounded-xl font-label-tech text-xs tracking-wider uppercase text-on-primary font-bold flex items-center justify-center gap-2 cursor-pointer" do %>
          <span><%= t('home.hero.cta_explore') %></span>
          <span class="material-symbols-outlined text-[16px]">terminal</span>
        <% end %>
        <% unless user_signed_in? %>
          <%= link_to new_user_session_path, class: "px-6 py-3.5 border border-outline-variant hover:border-primary-fixed-dim rounded-xl font-label-tech text-xs tracking-wider uppercase text-on-surface hover:text-primary-fixed-dim transition-all flex items-center justify-center gap-2 cursor-pointer" do %>
            <span><%= t('home.hero.cta_start') %></span>
            <span class="material-symbols-outlined text-[16px]">play_circle</span>
          <% end %>
        <% end %>
      </div>
      
      <div class="flex items-center gap-4 pt-6">
        <div class="flex -space-x-3">
          <img alt="User" class="w-10 h-10 rounded-full border-2 border-background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDHSB0lHsTtG399LXhrYxjMRVHBuAkmF5ylvUYBzDzBcwLBCv770d1U-SRx2e8gZj80sHAlBz8JQWR9gjTrWh80nCPfa2mXCSPQlxhHOwabmmYxjhjDwC7C43oQYtljySmeKF4L9ZuzXUyGe3OpDO23sG1WPPZKIUHBr71fAystYrTH9nMCRKDeESmQOCGSLiHROMlmmg2DmXY51rW6erFswT0yGSDWTbXbdFJgkAT6u6BXoumusU6UVtftZEeBfIPvAYdCDgL-tzc"/>
          <img alt="User" class="w-10 h-10 rounded-full border-2 border-background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD-jAlnH_R6hh90oheSCMfPuWodS9OUWNC18V1oSZA29IdbiarwjIcETYfHC-dww4bp2w2pNdtmhJXgsm1tvf3tJOuynM5GSdOtIYsNPsS-FurlCaw4NppsmNKsUQh9N_VyopcpdpswMSYmZl42y9x8IMN9jUg5jKr2KPLXW1j9p7uxamw-fDAcMaGrFDYGn7A2b8yFwgXXm3VlHlhYByIZC8XxbhqE7lciYTiWpyzuurSRS2UCh4lA531bfkvMCe5CEEmCdb9G6vM"/>
          <img alt="User" class="w-10 h-10 rounded-full border-2 border-background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDlsDt-pxyULohBUsasuMPiEJvNkMaUtmNlwHbO-fvjeuAZlaQn7ya278rTKcIAVEwVcwSTaXj2EmmdaEuLAiGGIg0VG7WQpShriBTicf-ihpDl2bJPSgEfjk-xwCLYmdxY-t9b6vD13T1v-O5AU-0s3fvM8JAbcruFiGzmm-eFEe43vyrKRLyw6zMPKE-a-ncZcHZ6qlGfhMFAyqfqjAnqhJlQMsugDAhk6lJ_mgnu-H0SAj_u6ze0-5JLWOkW7n7gbwh9o3AzadI"/>
