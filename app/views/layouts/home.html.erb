<section class="bg-purple-500 text-white">
  <div class="max-w-7xl mx-auto px-6 py-20 grid md:grid-cols-2 gap-10 items-center">
    <div>
      <h2 class="text-2xl md:text-3xl xl:text-5xl font-bold leading-tight">
        <%= simple_format(t('home.hero.title')) %>
      </h2>
      <p class="mt-6 text-lg text-blue-100">
        <%= t('home.hero.subtitle') %>
      </p>
      <div class="mt-8 space-x-4">
        <%= link_to t('home.hero.cta_explore'), courses_path, class: "bg-white text-blue-600 px-6 py-3 rounded-lg font-semibold hover:bg-gray-200" %>
        <% unless user_signed_in? %>
          <%= link_to t('home.hero.cta_start'), new_user_session_path, class: "bg-white text-blue-600 px-6 py-3 rounded-lg font-semibold hover:bg-gray-200" %>
        <% end %>
      </div>
    </div>
    <div>
      <%= optimized_static_image_tag("home/home-image.svg", alt: "Home Image", class_name: "rounded-xl shadow-lg", width: 600, height: 400) %>
    </div>
  </div>
</section>
<section class="py-16">
  <div class="max-w-7xl mx-auto px-6 text-center">
    <h3 class="text-3xl font-bold mb-12"><%= t('home.features.why_title', default: 'Why choose our platform') %></h3>
    <div class="grid md:grid-cols-3 gap-8">
      <div class="bg-white p-8 rounded-xl shadow hover:shadow-lg">
        <div class="text-4xl mb-4 flex justify-center"><%= optimized_static_image_tag("home/book.svg", alt: "Book Image", class_name: "rounded-xl shadow-lg w-15 h-15", width: 60, height: 60) %></div>
        <h4 class="text-xl font-semibold mb-2"><%= t('home.features.quality_courses.title') %></h4>
        <p class="text-gray-600">
          <%= t('home.features.quality_courses.desc') %>
        </p>
      </div>
      <div class="bg-white p-8 rounded-xl shadow hover:shadow-lg">
        <div class="text-4xl mb-4 flex justify-center"><%= optimized_static_image_tag("home/teacher.svg", alt: "Teacher Image", class_name: "rounded-xl shadow-lg w-15 h-15", width: 60, height: 60) %></div>
        <h4 class="text-xl font-semibold mb-2"><%= t('home.features.professional_instructors.title') %></h4>
        <p class="text-gray-600">
          <%= t('home.features.professional_instructors.desc') %>
        </p>
      </div>
      <div class="bg-white p-8 rounded-xl shadow hover:shadow-lg">
        <div class="text-4xl mb-4 flex justify-center"><%= optimized_static_image_tag("home/clock.svg", alt: "Clock Image", class_name: "rounded-xl shadow-lg w-15 h-15", width: 60, height: 60) %></div>
        <h4 class="text-xl font-semibold mb-2"><%= t('home.features.learn_anytime.title') %></h4>
        <p class="text-gray-600">
          <%= t('home.features.learn_anytime.desc') %>
        </p>
      </div>
    </div>
  </div>
</section>
<section class="bg-gray-100 py-16">
  <div class="max-w-7xl mx-auto px-6">
    <h3 class="text-3xl font-bold text-center mb-12"><%= t('home.popular_courses_title') %></h3>
    <div class="grid md:grid-cols-3 gap-8">
        <% if @featured_courses.present? %>
        <% @featured_courses.each do |course| %>
          <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex flex-col gap-3 justify-between items-center h-100">
            <div class="w-full h-48 bg-gray-100 rounded-lg overflow-hidden flex items-center justify-center">
              <% if course.course_image.attached? %>
                <%= optimized_course_image_tag(
                  course,
                  alt: course.name,
                  class_name: "w-full h-full object-cover",
                  width: 600,
                  height: 192,
                  sizes: "(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 33vw"
                ) %>
              <% else %>
                <svg class="w-20 h-20 text-gray-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7a4 4 0 014-4h10a4 4 0 014 4v10a4 4 0 01-4 4H7a4 4 0 01-4-4V7z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 13l2.5-3 3.5 4.5L16 11l4 6H4l4-4z" />
                </svg>
              <% end %>
            </div>

            <h4 class="font-bold text-gray-800 text-center"><%= course.name %></h4>
            <div class="text-gray-500 text-center h-16 flex items-start justify-center"><em><%= truncate(course.description, length: 100, separator: ' ', omission: "...") %></em></div>
            <div class="text-sm text-black text-center"><%= format_vnd(course.price) %></div>
            <%= link_to t('home.course.view_details'), course_path(course), class: "text-blue-500 hover:underline" %>

            <div class="mt-2 h-12 flex items-center justify-center w-full">
              <% if current_user&.owned_courses&.exists?(course.id) %>
                <%= link_to t('home.course.learn_now'),
                      learn_course_path(course),
                      class: "bg-green-600 text-white px-4 py-2 rounded-xl" %>
              <% elsif course.user_id == current_user&.id %>
                <div class="w-full h-10"></div>
              <% else %>
                <button data-controller="add-to-cart"
                        data-action="click->add-to-cart#add"
                        data-add-to-cart-course-id-value="<%= course.id %>"
                        class="w-fit bg-blue-500 text-white text-center py-2 px-4 rounded-full border-2 hover:bg-white hover:text-blue-500 hover:border-2 border-blue-500 transition">
                  <%= t('home.course.add_to_cart') %>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>
      <% else %>
        <p class="text-center col-span-3 text-gray-500"><%= t('home.no_courses') %></p>
      <% end %>
    </div>
  </div>
</section>
<section class="py-16">
  <div class="max-w-6xl mx-auto px-6 text-center">
    <h3 class="text-3xl font-bold mb-12"><%= t('home.testimonials_title') %></h3>
    <div class="grid md:grid-cols-2 gap-8">
      <div class="bg-white p-8 rounded-xl shadow">
        <p class="text-gray-600">
          "<%= t('home.testimonial_1') %>"
        </p>
        <div class="mt-4 font-semibold"><%= t('home.testimonial_1_author') %></div>
      </div>
      <div class="bg-white p-8 rounded-xl shadow">
        <p class="text-gray-600">
          "<%= t('home.testimonial_2') %>"
        </p>
        <div class="mt-4 font-semibold"><%= t('home.testimonial_2_author') %></div>
      </div>
    </div>
  </div>
</section>