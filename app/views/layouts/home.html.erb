<!-- Why Choose Us -->
<section class="py-20 relative">
  <div class="max-w-[1280px] mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="font-headline-md text-3xl font-bold tracking-tight text-on-surface mb-2"><%= t('missing_i18n.home.why_title') %></h2>
      <p class="font-body-md text-sm text-slate-text"><%= t('missing_i18n.home.why_subtitle') %></p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Card 1 -->
      <div class="glass-card p-8 rounded-xl flex flex-col justify-start">
        <div class="w-12 h-12 bg-primary-fixed-dim/10 rounded-xl flex items-center justify-center mb-6 border border-primary-fixed-dim/10">
          <span class="material-symbols-outlined text-primary-fixed-dim" style="font-variation-settings: 'FILL' 0;">verified</span>
        </div>
        <h3 class="font-headline-sm text-xl font-bold text-on-surface mb-3"><%= t('home.features.quality_courses.title') %></h3>
        <p class="font-body-md text-sm text-slate-text leading-relaxed">
          <%= t('home.features.quality_courses.desc') %>
        </p>
      </div>
      
      <!-- Card 2 -->
      <div class="glass-card p-8 rounded-xl flex flex-col justify-start">
        <div class="w-12 h-12 bg-primary-fixed-dim/10 rounded-xl flex items-center justify-center mb-6 border border-primary-fixed-dim/10">
          <span class="material-symbols-outlined text-primary-fixed-dim" style="font-variation-settings: 'FILL' 0;">psychology</span>
        </div>
        <h3 class="font-headline-sm text-xl font-bold text-on-surface mb-3"><%= t('home.features.professional_instructors.title') %></h3>
        <p class="font-body-md text-sm text-slate-text leading-relaxed">
          <%= t('home.features.professional_instructors.desc') %>
        </p>
      </div>
      
      <!-- Card 3 -->
      <div class="glass-card p-8 rounded-xl flex flex-col justify-start">
        <div class="w-12 h-12 bg-primary-fixed-dim/10 rounded-xl flex items-center justify-center mb-6 border border-primary-fixed-dim/10">
          <span class="material-symbols-outlined text-primary-fixed-dim" style="font-variation-settings: 'FILL' 0;">schedule</span>
        </div>
        <h3 class="font-headline-sm text-xl font-bold text-on-surface mb-3"><%= t('home.features.learn_anytime.title') %></h3>
        <p class="font-body-md text-sm text-slate-text leading-relaxed">
          <%= t('home.features.learn_anytime.desc') %>
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Popular Courses -->
<section class="py-20 bg-surface-container-low/40 relative">
  <div class="absolute inset-0 bg-grid-pattern opacity-5 pointer-events-none"></div>
  <div class="max-w-[1280px] mx-auto px-6">
    <div class="flex justify-between items-end mb-12">
      <div>
        <h2 class="font-headline-md text-3xl font-bold text-on-surface"><%= t('home.popular_courses_title') %></h2>
        <p class="font-body-md text-sm text-slate-text mt-1"><%= t('missing_i18n.home.popular_subtitle') %></p>
      </div>
      <%= link_to courses_path, class: "font-label-tech text-xs tracking-wider text-primary-fixed-dim hover:text-primary transition-all font-semibold uppercase" do %>
        <%= t('missing_i18n.home.view_archive') %> &rarr;
      <% end %>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <% if @featured_courses.present? %>
        <% @featured_courses.each do |course| %>
          <div class="glass-card p-5 rounded-2xl flex flex-col justify-between h-[480px]">
            <div class="w-full h-44 bg-surface-container rounded-xl overflow-hidden flex items-center justify-center border border-outline-variant/20 relative">
              <% if course.course_image.attached? %>
                <%= optimized_course_image_tag(
                  course,
                  alt: course.name,
                  class_name: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-500",
                  width: 600,
                  height: 176,
                  sizes: "(max-width: 768px) 100vw, (max-width: 1280px) 50vw, 33vw"
                ) %>
              <% else %>
                <span class="material-symbols-outlined text-outline-variant text-[50px]">auto_stories</span>
              <% end %>
            </div>

            <div class="flex-1 flex flex-col pt-4 gap-2">
              <h4 class="font-headline-sm text-lg font-bold text-on-surface leading-snug line-clamp-1"><%= course.name %></h4>
              <div class="text-slate-text text-xs line-clamp-3 leading-relaxed">
                <em><%= truncate(course.description, length: 120, separator: ' ', omission: "...") %></em>
              </div>
            </div>
            
            <div class="pt-4 border-t border-outline-variant/20 flex flex-col gap-4">
              <div class="flex items-center justify-between">
                <span class="font-label-tech text-xs text-slate-text"><%= t('missing_i18n.home.price_credit') %></span>
                <span class="font-label-tech text-sm text-primary font-bold"><%= format_vnd(course.price) %></span>
              </div>
              
              <div class="flex items-center justify-between gap-3">
                <%= link_to t('home.course.view_details'), course_path(course), class: "text-primary-fixed-dim hover:text-primary hover:underline font-label-tech text-xs tracking-wider" %>

                <div class="flex items-center justify-end">
                  <% if current_user&.owned_courses&.exists?(course.id) %>
                    <%= link_to t('home.course.learn_now'),
                          learn_course_path(course),
                          class: "glow-button px-4 py-2 text-xs rounded-lg shadow font-label-tech uppercase tracking-wider font-semibold",
                          data: { turbo_action: "advance" } %>
                  <% elsif course.user_id == current_user&.id %>
                    <span class="text-xs text-slate-text font-label-tech"><%= t('missing_i18n.home.instructor') %></span>
                  <% else %>
                    <button data-controller="add-to-cart"
                            data-action="click->add-to-cart#add"
                            data-add-to-cart-course-id-value="<%= course.id %>"
                            data-add-to-cart-added-message-value="<%= t('messages.cart_items.added') %>"
                            data-add-to-cart-failed-message-value="<%= t('messages.cart_items.already_in_cart') %>"
                            data-add-to-cart-error-message-value="<%= t('messages.common.unexpected_error') %>"
                            class="glow-button px-4 py-2 text-xs rounded-lg shadow font-label-tech uppercase tracking-wider font-semibold cursor-pointer">
                      <%= t('home.course.add_to_cart') %>
                    </button>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="col-span-3 py-16 flex flex-col items-center justify-center glass-card rounded-2xl border-dashed border-outline-variant border-2">
          <span class="material-symbols-outlined text-outline-variant text-[50px] mb-3">data_exploration</span>
          <h3 class="font-headline-sm text-lg text-on-surface-variant uppercase tracking-wider font-semibold"><%= t('missing_i18n.home.course_module_pending') %></h3>
          <p class="font-body-md text-xs text-slate-text mt-1"><%= t('home.no_courses') %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

