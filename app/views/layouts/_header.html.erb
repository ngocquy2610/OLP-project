<nav x-data="{ open: false }" class="sticky top-0 w-full h-24 bg-surface-glass backdrop-blur-xl border-b border-outline-variant/30 shadow-[0_0_15px_rgba(0,229,255,0.15)] z-50">
  <div class="flex justify-between items-center w-full h-full xl:px-20 px-5 max-w-[1280px] mx-auto">
    <div class="flex gap-8 items-center">
      <a class="flex items-center gap-3" href="/">
        <%= optimized_static_image_tag("logo-olp.svg", alt: "Logo OLP", class_name: "w-12 h-12 rounded-full border border-primary-fixed-dim/30 hover:border-primary-fixed-dim/60 transition-all", width: 48, height: 48) %>
        <span class="font-headline-sm text-headline-sm font-bold tracking-tighter text-primary-fixed-dim hover:text-primary transition-colors">OLP_ACADEMY</span>
      </a>
    </div>
    
    <div class="hidden xl:flex gap-6 items-center text-on-surface">
      <a class="font-body-md text-[16px] text-on-surface-variant hover:text-primary-fixed-dim hover:drop-shadow-[0_0_8px_rgba(0,229,255,0.4)] transition-all duration-300 py-2 px-3" href="/"><%= t('nav.home') %></a>
      <%= link_to t('nav.about'), about_path, class: "font-body-md text-[16px] text-on-surface-variant hover:text-primary-fixed-dim hover:drop-shadow-[0_0_8px_rgba(0,229,255,0.4)] transition-all duration-300 py-2 px-3" %>
      <a class="font-body-md text-[16px] text-on-surface-variant hover:text-primary-fixed-dim hover:drop-shadow-[0_0_8px_rgba(0,229,255,0.4)] transition-all duration-300 py-2 px-3" href="<%= courses_path %>"><%= t('nav.course') %></a>
      
      <%= link_to cart_path, class: "font-body-md text-[16px] text-on-surface-variant hover:text-primary-fixed-dim hover:drop-shadow-[0_0_8px_rgba(0,229,255,0.4)] transition-all duration-300 py-2 px-3 flex items-center gap-2" do %>
        <span><%= t('nav.cart') %></span>
        <%= turbo_frame_tag "cart-count-frame" do %>
          <span id="cart-count" class="bg-primary hover:bg-primary-container text-on-primary text-xs font-bold font-label-tech rounded px-2 py-0.5"><%= user_signed_in? ? (current_user.cart&.cart_items&.count || 0) : 0 %></span>
        <% end %>
      <% end %>

      <% if user_signed_in? %>
        <%= link_to current_user.fullname, profile_path, class: "font-body-md text-[16px] text-primary-fixed-dim border border-primary-fixed-dim/30 hover:bg-primary-fixed-dim/10 rounded px-4 py-2 transition-all" %>
      <% else %>
        <%= link_to t('nav.login') , new_user_session_path,
                            class: "glow-button font-label-tech text-xs tracking-wider uppercase px-4 py-2 rounded shadow" %>
      <% end %>
      
      <div class="ml-4">
        <%= form_with url: request.path, method: :get, local: true, class: "language-form" do |f| %>
          <%= f.select :locale, 
                      [['🇬🇧 EN', 'en'], ['🇻🇳 VI', 'vi']],
                      { selected: I18n.locale },
                      { onchange: "this.form.submit();", class: "bg-surface-container-high/80 border border-outline-variant text-[14px] text-on-surface rounded px-2 py-1 focus:ring-1 focus:ring-primary-fixed-dim outline-none cursor-pointer" } %>
          
          <% request.query_parameters.except(:locale).each do |key, value| %>
            <%= hidden_field_tag key, value %>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="relative xl:hidden flex items-center gap-4">
      <div class="xl:hidden">
        <%= form_with url: request.path, method: :get, local: true, class: "language-form" do |f| %>
          <%= f.select :locale, 
                      [['🇬🇧', 'en'], ['🇻🇳', 'vi']],
                      { selected: I18n.locale },
                      { onchange: "this.form.submit();", class: "bg-surface-container-high/80 border border-outline-variant text-[14px] text-on-surface rounded px-1.5 py-0.5 focus:ring-1 focus:ring-primary-fixed-dim outline-none" } %>
          
          <% request.query_parameters.except(:locale).each do |key, value| %>
            <%= hidden_field_tag key, value %>
          <% end %>
        <% end %>
      </div>

      <button @click="open = !open" class="text-on-surface hover:text-primary-fixed-dim focus:outline-none transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>

      <div x-show="open" @click.outside="open = false" x-transition class="absolute right-0 mt-64 w-64 bg-surface-container-high border border-outline-variant/50 text-on-surface shadow-2xl z-50 max-h-[80vh] overflow-auto rounded-xl backdrop-blur-xl">
        <div class="p-4 flex flex-col gap-2">
          <a href="/" class="px-3 py-2 rounded-lg hover:bg-primary-fixed-dim/10 text-on-surface-variant hover:text-primary-fixed-dim transition-all"> <%= t('nav.home') %> </a>
          <%= link_to t('nav.about'), about_path, class: "px-3 py-2 rounded-lg hover:bg-primary-fixed-dim/10 text-on-surface-variant hover:text-primary-fixed-dim transition-all" %>
          <a href="<%= courses_path %>" class="px-3 py-2 rounded-lg hover:bg-primary-fixed-dim/10 text-on-surface-variant hover:text-primary-fixed-dim transition-all"> <%= t('nav.course') %> </a>
          <%= link_to cart_path, class: "px-3 py-2 rounded-lg hover:bg-primary-fixed-dim/10 text-on-surface-variant hover:text-primary-fixed-dim transition-all flex items-center justify-between" do %>
            <span><%= t('nav.cart') %></span>
            <%= turbo_frame_tag "cart-count-mobile-frame" do %>
              <span id="cart-count-mobile" class="bg-primary text-on-primary text-xs font-bold font-label-tech rounded-full px-2 py-0.5"><%= user_signed_in? ? (current_user.cart&.cart_items&.count || 0) : 0 %></span>
            <% end %>
          <% end %>
          <% if user_signed_in? %>
            <%= link_to current_user.fullname, profile_path, class: "px-3 py-2 rounded-lg hover:bg-primary-fixed-dim/10 text-primary-fixed-dim font-bold transition-all border border-primary-fixed-dim/20" %>
          <% else %>
            <%= link_to t('nav.login') , new_user_session_path, class: "glow-button px-3 py-2 text-center rounded-lg shadow" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</nav>