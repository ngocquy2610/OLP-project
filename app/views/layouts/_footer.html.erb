<div class="bg-[#15a5ff] text-white py-8 px-4">
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-8 max-w-7xl mx-auto">
  <div class="flex flex-col items-center gap-4">
    <%= image_tag "logo-olp.svg" ,class: "w-[100px] h-[100px] rounded-full" %>
