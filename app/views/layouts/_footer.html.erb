<div class="bg-surface border-t border-outline-variant/30 text-on-surface py-12 px-6 relative mt-auto">
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-8 max-w-[1280px] mx-auto">
    <div class="flex flex-col items-center sm:items-start gap-4">
      <div class="flex items-center gap-3">
        <%= optimized_static_image_tag("logo-olp.svg", alt: "Logo OLP", class_name: "w-16 h-16 rounded-full border border-primary-fixed-dim/20", width: 64, height: 64) %>
        <span class="font-headline-sm text-headline-sm font-bold tracking-tighter text-primary-fixed-dim">OLP_ACADEMY</span>
      </div>
      <div class="text-sm text-slate-text italic text-center sm:text-left mt-2">
        <%= t('footer.tagline') %>
      </div>
    </div>
    
    <div class="flex flex-col items-center justify-center gap-2">
      <div class="flex flex-col gap-2 font-body-md text-sm text-on-surface-variant">
        <%= link_to t('nav.home'), root_path, class: "hover:text-primary-fixed-dim transition-colors" %>
        <%= link_to t('nav.about'), about_path, class: "hover:text-primary-fixed-dim transition-colors" %>
        <%= link_to t('nav.course'), courses_path, class: "hover:text-primary-fixed-dim transition-colors" %>
        <%= link_to t('footer.contact.link_label'), "https://zalo.me/0977692109", target: "_blank", rel: "noopener", class: "hover:text-primary-fixed-dim transition-colors" %>
      </div>
    </div>
    
    <div class="hidden xl:flex xl:flex-col items-center justify-center gap-4">
      <div class="flex flex-col gap-2 text-sm text-slate-text">
        <div class="text-on-surface">
          <%= t('footer.address.line1') %>
        </div>
        <div>
          <%= t('footer.address.line2') %>
        </div>
        <div>
          <span class="text-primary-fixed-dim"><%= t('footer.contact.email_label') %>:</span> support@onlinelearningplatform.com
        </div>
        <div>
          <span class="text-primary-fixed-dim"><%= t('footer.contact.phone_label') %>:</span> +84 123 456 789
        </div>
      </div>
    </div>
    
    <div class="hidden xl:flex flex-col items-center gap-4 sm:col-span-2 xl:col-span-1">
      <div class="w-full h-32 rounded-xl overflow-hidden border border-outline-variant/30">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3723.9643455107566!2d105.76271387610298!3d21.034112580616505!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31345506c00cce6b%3A0xcb752d789ddf773f!2sLTS%20Group%20-%20IT%20Outsourcing%20Firm%20in%20Vietnam!5e0!3m2!1sen!2s!4v1773996656034!5m2!1sen!2s"
          class="w-full h-full border-0"
          allowfullscreen=""
          loading="lazy">
        </iframe>
      </div>
    </div>
  </div>
  <div class="absolute bottom-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-primary-fixed-dim/30 to-transparent"></div>
</div>