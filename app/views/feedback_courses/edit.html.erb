<%= turbo_frame_tag "profile_content" do %>
  <div class="max-w-2xl mx-auto mt-10 bg-white p-6 rounded-lg shadow-md border border-gray-100">
    <h2 class="text-2xl font-bold mb-6 text-gray-800">Sửa đánh giá của bạn</h2>
    <p class="text-gray-600 mb-4">Khóa học: <strong><%= @course.name %></strong></p>

    <%= form_with(model: [@course, @feedback], local: true, class: "space-y-4") do |f| %>
      <div>
        <%= f.label :rate, "Số sao (1-5)", class: "block text-sm font-medium text-gray-700" %>
        <%= f.number_field :rate, in: 1..5, class: "mt-1 block w-32 rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :feedback, "Nhận xét của bạn", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_area :feedback, rows: 5, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>

      <div class="flex justify-end space-x-3 pt-4">
        <%= link_to "Hủy", course_path(@course), class: "px-4 py-2 text-gray-600 bg-gray-100 hover:bg-gray-200 rounded-md" %>
        <%= f.submit "Cập nhật", class: "px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>
<% end %>