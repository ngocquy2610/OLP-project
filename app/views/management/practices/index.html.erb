<%= turbo_frame_tag "profile_content" do %>
  <div class="flex flex-col lg:flex-row lg:justify-between lg:items-center gap-4 mb-6">
    <h1 class="text-2xl font-bold text-white font-headline-sm"><%= t('admin.management.practices.index.title') %></h1>
    <div class="flex w-full lg:w-auto flex-col lg:flex-row lg:items-center gap-3 lg:gap-4">
      <%= form_with url: management_practices_path, method: :get, local: false, data: { turbo_frame: 'profile_content' }, class: "flex w-full lg:w-auto flex-col lg:flex-row lg:items-center gap-2" do %>
        <%= text_field_tag :lesson_query,
          @lesson_query,
          placeholder: t('admin.management.practices.index.search_lesson_placeholder', default: 'Search by lesson'),
          class: "border border-outline-variant rounded-lg px-3 bg-[#171B24] py-2 bg-surface-container-high text-white focus:outline-none focus:border-primary-fixed-dim" %>
        <%= submit_tag t('admin.management.practices.index.search', default: 'Search'), class: "inline-flex items-center px-4 py-2 rounded-lg border border-sky-500/30 text-sky-300 bg-sky-500/10 hover:bg-sky-500/20 transition" %>
      <% end %>
      <%= link_to t('admin.management.practices.index.new'), new_management_practice_path,
          class: "glow-button font-label-tech px-4 py-2 rounded-xl flex items-center justify-center" %>
    </div>
  </div>
  <div class="overflow-x-auto glass-card-no-hover rounded-xl border border-white/10">
    <table class="min-w-[877px] xl:min-w-full divide-y divide-white/10">
      <thead class="bg-white/5">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.practices.index.table.lesson') %></th>
          <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.practices.index.table.question') %></th>
          <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.practices.index.table.answers') %></th>
          <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.practices.index.table.correct_answers') %></th>
          <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.practices.index.table.kind') %></th>
          <th class="px-6 py-3 text-right text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.practices.index.table.actions') %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/10">
        <% @practices.each do |practice| %>
          <tr class="hover:bg-white/5 transition">
            <td class="px-6 py-4">
              <div class="font-medium text-white"><%= practice.lesson.name %></div>
            </td>
            <td class="px-6 py-4">
              <div class="font-medium text-white"><%= practice.question %></div>
            </td>
            <td class="px-6 py-4">
              <div class="font-medium text-slate-300"><%= practice.answers %></div>
            </td>
            <td class="px-6 py-4">
              <div class="font-medium text-slate-300"><%= practice.correct_answers %></div>
            </td>
            <td class="px-6 py-4">
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium border border-sky-400/30 bg-sky-500/20 text-sky-300"><%= practice.type %></span>
            </td>
            <td class="px-6 py-4 text-right text-sm font-medium">
              <div class="flex flex-col items-end gap-2 sm:flex-row sm:justify-end sm:items-center sm:gap-3">
                <%= link_to t('admin.management.actions.edit'), edit_management_practice_path(practice, return_to: request.fullpath), class: "inline-flex items-center px-3 py-1.5 rounded-full border border-sky-500/30 text-sky-300 bg-sky-500/10 hover:bg-sky-500/20 transition",data: { turbo_frame: "profile_content" } %>
                <%= button_to t('admin.management.actions.delete'), management_practice_path(practice), method: :delete,
                  form: { data: { turbo_confirm: t('admin.management.delete_confirm') } },
                  class: "inline-flex items-center px-3 py-1.5 rounded-full border border-red-500/30 text-red-300 bg-red-500/10 hover:bg-red-500/20 transition" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>