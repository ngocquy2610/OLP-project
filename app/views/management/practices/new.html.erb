<%= turbo_frame_tag "profile_content" do %>
  <h1 class="text-2xl font-bold text-white font-headline-sm mb-6"><%= t('admin.management.practices.new.title') %></h1>
  <%= form_with url: management_practices_path, local: true do %>
    <div class="mb-4">
      <label class="block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest"><%= t('admin.management.practices.form.lesson') %></label>
      <%= select_tag :lesson_id, options_from_collection_for_select(@lessons, :id, :name, @practice&.lesson_id), include_blank: t('admin.management.forms.choose_lesson'), class: "w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim" %>
    </div>
    <div id="questions">
      <div class="question-row mb-4 p-4 rounded-xl border border-white/10 bg-surface-container-high/40">
        <div class="mb-2">
          <label class="block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest"><%= t('admin.management.practices.form.question') %></label>
          <input type="text" name="practices[][question]" class="w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim" />
        </div>
        <div class="mb-2">
          <label class="block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest"><%= t('admin.management.practices.form.answers_hint') %></label>
          <input type="text" name="practices[][answers]" class="w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim" />
        </div>
        <div class="mb-2">
          <label class="block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest"><%= t('admin.management.practices.form.correct_answers') %></label>
          <input type="text" name="practices[][correct_answers]" class="w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim" />
        </div>
        <div class="mb-2">
          <label class="block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest"><%= t('admin.management.practices.form.kind') %></label>
          <select name="practices[][type]" class="w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim">
            <option value=""><%= t('admin.management.forms.choose_type') %></option>
            <option value="multiple_choice"><%= t('admin.management.types.multiple_choice') %></option>
            <option value="true_false"><%= t('admin.management.types.true_false') %></option>
          </select>
        </div>
        <button type="button" class="remove-question mt-2 text-sm text-red-300 hover:text-red-200 font-label-tech"><%= t('admin.management.practices.actions.remove_question') %></button>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-3 pt-4">
      <button id="add-question" type="button" class="inline-flex items-center px-4 py-2 rounded-xl border border-emerald-500/30 bg-emerald-500/10 text-emerald-300 hover:bg-emerald-500/20 transition font-label-tech text-xs"><%= t('admin.management.practices.actions.add_question') %></button>
      <%= submit_tag t('admin.management.practices.new.submit'), class: "glow-button font-label-tech px-6 py-2 rounded-xl" %>
      <%= link_to t('admin.management.practices.form.cancel'), profile_path(current_user), class: "text-slate-400 hover:text-primary-fixed-dim transition font-label-tech text-sm" %>
    </div>
  <% end %>
  <template id="question-template">
    <div class="question-row mb-4 p-4 rounded-xl border border-white/10 bg-surface-container-high/40">
      <div class="mb-2">
        <label class="block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest"><%= t('admin.management.practices.form.question') %></label>
        <input type="text" name="practices[][question]" class="w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim" />
      </div>
      <div class="mb-2">
        <label class="block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest"><%= t('admin.management.practices.form.answers_hint') %></label>
        <input type="text" name="practices[][answers]" class="w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim" />
      </div>
      <div class="mb-2">
        <label class="block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest"><%= t('admin.management.practices.form.correct_answers') %></label>
        <input type="text" name="practices[][correct_answers]" class="w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim" />
      </div>
      <div class="mb-2">
        <label class="block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest"><%= t('admin.management.practices.form.kind') %></label>
        <select name="practices[][type]" class="w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim">
          <option value=""><%= t('admin.management.forms.choose_type') %></option>
          <option value="multiple_choice"><%= t('admin.management.types.multiple_choice') %></option>
          <option value="true_false"><%= t('admin.management.types.true_false') %></option>
        </select>
      </div>
      <button type="button" class="remove-question mt-2 text-sm text-red-300 hover:text-red-200 font-label-tech"><%= t('admin.management.practices.actions.remove_question') %></button>
    </div>
  </template>
  <script>
    (function(){
      const addBtn = document.getElementById('add-question')
      const container = document.getElementById('questions')
      const template = document.getElementById('question-template')

      addBtn.addEventListener('click', function(e){
        const clone = template.content.cloneNode(true)
        container.appendChild(clone)
      })

      document.addEventListener('click', function(e){
        if(e.target && e.target.classList.contains('remove-question')){
          const row = e.target.closest('.question-row')
          if(row) row.remove()
        }
      })
    })()
  </script>
<% end %>