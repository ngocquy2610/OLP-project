<%= turbo_frame_tag "profile_content" do %>
  <h1 class="text-2xl font-bold mb-6"><%= t('admin.management.practices.new.title') %></h1>
  <%= form_with url: management_practices_path, local: true do %>
    <div class="mb-4">
      <label class="block text-sm font-semibold text-gray-700 mb-1"><%= t('admin.management.practices.form.lesson') %></label>
      <%= select_tag :lesson_id, options_from_collection_for_select(@lessons, :id, :name, @practice&.lesson_id), include_blank: t('admin.management.forms.choose_lesson'), class: "w-full border rounded-lg p-2.5 bg-white" %>
    </div>
    <div id="questions">
      <div class="question-row mb-4 p-4 border rounded-lg">
        <div class="mb-2">
          <label class="block text-sm font-semibold text-gray-700"><%= t('admin.management.practices.form.question') %></label>
          <input type="text" name="practices[][question]" class="w-full border rounded-lg p-2.5" />
        </div>
        <div class="mb-2">
          <label class="block text-sm font-semibold text-gray-700"><%= t('admin.management.practices.form.answers_hint') %></label>
          <input type="text" name="practices[][answers]" class="w-full border rounded-lg p-2.5" />
        </div>
        <div class="mb-2">
          <label class="block text-sm font-semibold text-gray-700"><%= t('admin.management.practices.form.correct_answers') %></label>
          <input type="text" name="practices[][correct_answers]" class="w-full border rounded-lg p-2.5" />
        </div>
        <div class="mb-2">
          <label class="block text-sm font-semibold text-gray-700"><%= t('admin.management.practices.form.kind') %></label>
          <select name="practices[][type]" class="w-full border rounded-lg p-2.5 bg-white">
            <option value=""><%= t('admin.management.forms.choose_type') %></option>
            <option value="multiple_choice"><%= t('admin.management.types.multiple_choice') %></option>
            <option value="true_false"><%= t('admin.management.types.true_false') %></option>
          </select>
        </div>
        <button type="button" class="remove-question mt-2 text-sm text-red-600"><%= t('admin.management.practices.actions.remove_question') %></button>
      </div>
    </div>
    <div class="flex items-center space-x-3 pt-4">
      <button id="add-question" type="button" class="bg-green-600 text-white px-4 py-2 rounded-lg"><%= t('admin.management.practices.actions.add_question') %></button>
      <%= submit_tag t('admin.management.practices.new.submit'), class: "bg-indigo-600 text-white px-6 py-2 rounded-lg font-bold" %>
      <%= link_to t('admin.management.practices.form.cancel'), profile_path(current_user), class: "text-gray-500 hover:underline" %>
    </div>
  <% end %>
  <template id="question-template">
    <div class="question-row mb-4 p-4 border rounded-lg">
      <div class="mb-2">
        <label class="block text-sm font-semibold text-gray-700"><%= t('admin.management.practices.form.question') %></label>
        <input type="text" name="practices[][question]" class="w-full border rounded-lg p-2.5" />
      </div>
      <div class="mb-2">
        <label class="block text-sm font-semibold text-gray-700"><%= t('admin.management.practices.form.answers_hint') %></label>
        <input type="text" name="practices[][answers]" class="w-full border rounded-lg p-2.5" />
      </div>
      <div class="mb-2">
        <label class="block text-sm font-semibold text-gray-700"><%= t('admin.management.practices.form.correct_answers') %></label>
        <input type="text" name="practices[][correct_answers]" class="w-full border rounded-lg p-2.5" />
      </div>
      <div class="mb-2">
        <label class="block text-sm font-semibold text-gray-700"><%= t('admin.management.practices.form.kind') %></label>
          <select name="practices[][type]" class="w-full border rounded-lg p-2.5 bg-white">
            <option value=""><%= t('admin.management.forms.choose_type') %></option>
            <option value="multiple_choice"><%= t('admin.management.types.multiple_choice') %></option>
            <option value="true_false"><%= t('admin.management.types.true_false') %></option>
          </select>
      </div>
      <button type="button" class="remove-question mt-2 text-sm text-red-600"><%= t('admin.management.practices.actions.remove_question') %></button>
    </div>
  </template>
  <script>
    (function(){
      const addBtn = document.getElementById('add-question')
      const container = document.getElementById('questions')
      const template = document.getElementById('question-template')

      addBtn.addEventListener('click', function(e){
        const clone = template.content.cloneNode(true)
        container.appendChild(clone)
      })

      document.addEventListener('click', function(e){
        if(e.target && e.target.classList.contains('remove-question')){
          const row = e.target.closest('.question-row')
          if(row) row.remove()
        }
      })
    })()
  </script>
<% end %>