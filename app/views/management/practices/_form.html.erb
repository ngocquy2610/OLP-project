<%= form_with(model: [:management, practice], class: "space-y-6") do |f| %>
  <% if practice.errors.any? %>
    <div class="bg-red-50 p-4 rounded-lg text-red-700 text-sm mb-4">
      <h3 class="font-bold"><%= t('admin.management.errors.header', count: practice.errors.count) %></h3>
      <ul class="list-disc pl-5 mt-1">
        <% practice.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= f.label :lesson_id, t('admin.management.practices.form.lesson'), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.collection_select :lesson_id, Lesson.all, :id, :name, { prompt: t('admin.management.forms.choose_lesson') }, { class: "w-full border rounded-lg p-2.5 bg-white focus:ring-2 focus:ring-indigo-500 outline-none" } %>
  </div>
  <div>
    <%= f.label :question, t('admin.management.practices.form.question'), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.text_field :question, class: "w-full border rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500 outline-none" %>
  </div>
  <div>
    <%= f.label :answers, t('admin.management.practices.form.answers'), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <p class="text-gray-700"><em><%= t('admin.management.practices.form.answers_hint') %></em></p>
    <%= f.text_field :answers, class: "w-full border rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500 outline-none" %>
  </div>
  <div>
    <%= f.label :correct_answers, t('admin.management.practices.form.correct_answers'), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.text_field :correct_answers, class: "w-full border rounded-lg p-2.5 focus:ring-2 focus:ring-indigo-500 outline-none" %>
  </div>
  <div>
    <%= f.label :type, t('admin.management.practices.form.kind'), class: "block text-sm font-semibold text-gray-700 mb-1" %>
    <%= f.select :type, options_for_select([[t('admin.management.types.multiple_choice'), "multiple_choice"],[t('admin.management.types.true_false'), "true_false"]], f.object.type), { prompt: t('admin.management.forms.choose_type') }, { class: "w-full border rounded-lg p-2.5 bg-white focus:ring-2 focus:ring-indigo-500 outline-none" } %>
  </div>
  <div class="flex items-center space-x-3 pt-4">
    <%= f.submit t('admin.management.practices.form.submit'), class: "bg-indigo-600 text-white px-6 py-2 rounded-lg font-bold hover:bg-indigo-700 cursor-pointer" %>
    <%= link_to t('admin.management.practices.form.cancel'), profile_path(current_user), class: "text-gray-500 hover:underline" %>
  </div>
<% end %>