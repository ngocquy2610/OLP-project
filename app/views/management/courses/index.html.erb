<%= turbo_frame_tag "profile_content" do %>
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
      <h1 class="text-2xl font-bold text-white font-headline-sm"><%= t('admin.management.courses.index.title') %></h1>
      <%= link_to t('admin.management.courses.index.new'), new_management_course_path, 
          class: "glow-button font-label-tech text-sm px-4 py-2 rounded-xl flex items-center gap-1" %>
  </div>
    <div class="glass-card-no-hover rounded-xl overflow-x-auto">
      <table class="min-w-[990px] xl:min-w-full">
        <thead>
          <tr class="border-b border-white/10">
            <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.courses.index.table.image') %></th>
            <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.courses.index.table.name') %></th>
            <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.courses.index.table.description') %></th>
            <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.courses.index.table.price') %></th>
            <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.courses.index.table.status') %></th>
            <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.courses.index.table.actions') %></th>
          </tr>
        </thead>
        <tbody>
        <% @courses.each do |course| %>
          <tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
            <td class="px-6 py-4">
              <div class="w-16 h-16 bg-surface-container rounded-lg overflow-hidden flex items-center justify-center">
                <% if course.course_image.attached? %>
                  <%= optimized_course_thumb_tag(
                    course,
                    alt: course.name,
                    class_name: "w-full h-full object-cover",
                    width: 64,
                    height: 64
                  ) %>
                <% else %>
                  <svg class="w-8 h-8 text-slate-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7a4 4 0 014-4h10a4 4 0 014 4v10a4 4 0 01-4 4H7a4 4 0 01-4-4V7z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 13l2.5-3 3.5 4.5L16 11l4 6H4l4-4z" />
                  </svg>
                <% end %>
              </div>
            </td>
            <td class="px-6 py-4">
              <div class="font-medium text-white"><%= course.name %></div>
            </td>
            <td class="px-6 py-4 text-sm text-slate-400"><%= truncate(course.description, length: 100) %></td>
            <td class="px-6 py-4 text-sm text-primary-fixed-dim font-bold">
              <%= format_vnd(course.price) %>
            </td>
            <td class="px-6 py-4 text-sm">
              <% status_class = case course.status
                when 'published' then 'bg-emerald-500/20 text-emerald-400 border border-emerald-500/30'
                when 'pending' then 'bg-amber-500/20 text-amber-400 border border-amber-500/30'
                when 'rejected' then 'bg-red-500/20 text-red-400 border border-red-500/30'
                else 'bg-slate-500/20 text-slate-400 border border-slate-500/30'
              end %>
              <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-label-tech <%= status_class %>"><%= course.status.to_s.titleize %></span>
            </td>
            <td class="px-6 py-4 text-right text-sm font-medium">
              <div class="flex flex-col items-end gap-2 sm:flex-row sm:justify-end sm:items-center sm:gap-3">
                <%= link_to t('admin.courses.verify.details'), management_course_path(course), class: "px-3 py-1 rounded-full border border-sky-500/30 text-sky-400 hover:bg-sky-500/20 text-xs font-label-tech transition", data: { turbo_frame: "profile_content" } %>
                <%= link_to t('admin.management.actions.edit'), edit_management_course_path(course), class: "px-3 py-1 rounded-full border border-sky-500/30 text-sky-400 hover:bg-sky-500/20 text-xs font-label-tech transition",data: { turbo_frame: "profile_content" } %>
                <%= button_to t('admin.management.actions.delete'), management_course_path(course), method: :delete,
                  form: { data: { turbo_confirm: t('admin.management.delete_confirm') } },
                  class: "inline px-3 py-1 rounded-full border border-red-500/30 text-red-400 hover:bg-red-500/20 text-xs font-label-tech transition cursor-pointer" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div class="mt-12 flex justify-center py-4 text-primary-fixed-dim font-label-tech">
    <%= pagination_links(@courses) %>
  </div>
<% end %>