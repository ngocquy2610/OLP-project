<%= turbo_frame_tag "profile_content" do %>
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800"><%= t('admin.management.courses.index.title') %></h1>
    <%= link_to t('admin.management.courses.index.new'), new_management_course_path, 
        class: "bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition flex items-center shadow-sm" %>
  </div>
  <div class="overflow-x-auto bg-white rounded-xl border border-gray-200">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase"><%= t('admin.management.courses.index.table.image') %></th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase"><%= t('admin.management.courses.index.table.name') %></th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase"><%= t('admin.management.courses.index.table.description') %></th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase"><%= t('admin.management.courses.index.table.price') %></th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase"><%= t('admin.management.courses.index.table.actions') %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @courses.each do |course| %>
          <tr class="hover:bg-gray-50 transition">
            <td>
              <div class="w-16 h-16 bg-gray-100 rounded-lg overflow-hidden flex items-center justify-center">
                <% if course.course_image.attached? %>
                  <%= image_tag(course.course_image, class: "w-full h-full object-cover") %>
                <% else %>
                  <svg class="w-8 h-8 text-gray-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7a4 4 0 014-4h10a4 4 0 014 4v10a4 4 0 01-4 4H7a4 4 0 01-4-4V7z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 13l2.5-3 3.5 4.5L16 11l4 6H4l4-4z" />
                  </svg>
                <% end %>
              </div>
            </td>
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= course.name %></div>
            </td>
            <td class="px-6 py-4 text-sm text-gray-600"><%= truncate(course.description, length: 100) %></td>
            <td class="px-6 py-4 text-sm text-gray-600">
              <%= format_vnd(course.price) %>
            </td>
            <td class="px-6 py-4 text-right text-sm font-medium space-x-3 flex">
                <%= link_to t('admin.management.actions.edit'), edit_management_course_path(course), class: "text-indigo-600 hover:text-indigo-900",data: { turbo_frame: "profile_content" } %>
                <%= button_to t('admin.management.actions.delete'), management_course_path(course), method: :delete,
                  form: { data: { turbo_confirm: t('admin.management.delete_confirm') } },
                  class: "inline text-red-600 hover:text-red-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>