<%= form_with(model: [:management, topic], class: "space-y-6") do |f| %>
  <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>
  <% if topic.errors.any? %>
      <div class="bg-red-500/10 border border-red-500/30 p-4 rounded-xl text-red-400 text-sm mb-4">
        <h3 class="font-bold font-label-tech"><%= t('admin.management.errors.header', count: topic.errors.count) %></h3>
      <ul class="list-disc pl-5 mt-1">
        <% topic.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= f.label :course_id, t('admin.management.topics.form.course'), class: "block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest" %>
    <%= f.collection_select :course_id, @courses, :id, :name, { prompt: t('admin.management.forms.choose_course') }, { class: "w-full bg-surface-container-high bg-[#171B24] border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim focus:ring-1 focus:ring-primary-fixed-dim" } %>
  </div>
  <div>
    <%= f.label :name, t('admin.management.topics.form.name'), class: "block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest" %>
    <%= f.text_field :name, class: "w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim focus:ring-1 focus:ring-primary-fixed-dim" %>
  </div>
  <div>
    <%= f.label :description, t('admin.management.topics.form.description'), class: "block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest" %>
    <%= f.text_area :description, rows: 4, class: "w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim focus:ring-1 focus:ring-primary-fixed-dim" %>
  </div>
  <div class="flex flex-col sm:flex-row sm:items-center gap-3 pt-4">
    <%= f.submit t('admin.management.topics.form.submit'), class: "glow-button font-label-tech px-6 py-2 rounded-xl cursor-pointer" %>
    <%= link_to t('admin.management.topics.form.cancel'), (params[:return_to].presence || management_topics_path), class: "text-slate-400 hover:text-primary-fixed-dim transition font-label-tech text-sm" %>
  </div>
<% end %>