<%= turbo_frame_tag "profile_content" do %>
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Quản lý Bài kiểm tra</h1>
    <div class="flex items-center space-x-4">
      <%= form_with url: management_exams_path, method: :get, local: false, data: { turbo_frame: 'profile_content' }, class: "flex items-center space-x-2" do %>
        <%= label_tag :topic_id, "Lọc theo chủ đề:", class: "text-sm font-medium text-gray-700 mr-2" %>
        <%= select_tag :topic_id, options_from_collection_for_select(@topics, :id, :name, @selected_topic&.id), include_blank: false, class: "border rounded-lg p-2 bg-white", onchange: 'if(this.form.requestSubmit){this.form.requestSubmit()}else{this.form.dispatchEvent(new Event("submit", {bubbles:true,cancelable:true}))}' %>
      <% end %>
      <%= link_to "Thêm bài kiểm tra mới", new_management_exam_path, 
          class: "bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition flex items-center shadow-sm" %>
    </div>
  </div>
  <div class="overflow-x-auto bg-white rounded-xl border border-gray-200">
    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Thuộc chủ đề</th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Câu hỏi</th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Đáp án</th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Đáp án đúng</th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase">Loại</th>
          <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase">Hành động</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @exams.each do |exam| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= exam.topic.name if exam.topic %></div>
            </td>
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= exam.question %></div>
            </td>
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= exam.answers %></div>
            </td>
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= exam.correct_answers %></div>
            </td>
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= exam.type %></div>
            </td>
            <td class="px-6 py-4 text-right text-sm font-medium space-x-3">
              <%= link_to "Sửa", edit_management_exam_path(exam), class: "text-indigo-600 hover:text-indigo-900",data: { turbo_frame: "profile_content" } %>
              <%= button_to "Xóa", management_exam_path(exam), method: :delete,
                  form: { data: { turbo_confirm: "Bạn có chắc chắn muốn xóa?" } },
                  class: "inline text-red-600 hover:text-red-900" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>