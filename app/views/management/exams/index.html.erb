<%= turbo_frame_tag "profile_content" do %>
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
    <h1 class="text-2xl font-bold text-gray-800"><%= t('admin.management.exams.index.title') %></h1>
    <div class="flex w-full sm:w-auto flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
      <%= form_with url: management_exams_path, method: :get, local: false, data: { turbo_frame: 'profile_content' }, class: "flex w-full sm:w-auto flex-col sm:flex-row sm:items-center gap-2" do %>
        <%= label_tag :topic_id, t('admin.management.exams.index.filter_by_topic'), class: "text-sm font-medium text-gray-700" %>
        <%= select_tag :topic_id, options_from_collection_for_select(@topics, :id, :name, @selected_topic&.id), include_blank: false, class: "border rounded-lg p-2 bg-white", onchange: 'if(this.form.requestSubmit){this.form.requestSubmit()}else{this.form.dispatchEvent(new Event("submit", {bubbles:true,cancelable:true}))}' %>
      <% end %>
      <%= link_to t('admin.management.exams.index.new'), new_management_exam_path, 
          class: "bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700 transition flex items-center justify-center shadow-sm" %>
    </div>
  </div>
  <div class="overflow-x-auto bg-white rounded-xl border border-gray-200">
    <table class="min-w-[900px] divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase"><%= t('admin.management.exams.index.table.topic') %></th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase"><%= t('admin.management.exams.index.table.question') %></th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase"><%= t('admin.management.exams.index.table.answers') %></th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase"><%= t('admin.management.exams.index.table.correct_answers') %></th>
          <th class="px-6 py-3 text-left text-xs font-bold text-gray-500 uppercase"><%= t('admin.management.exams.index.table.kind') %></th>
          <th class="px-6 py-3 text-right text-xs font-bold text-gray-500 uppercase"><%= t('admin.management.exams.index.table.actions') %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% @exams.each do |exam| %>
          <tr class="hover:bg-gray-50 transition">
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= exam.topic.name if exam.topic %></div>
            </td>
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= exam.question %></div>
            </td>
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= exam.answers %></div>
            </td>
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= exam.correct_answers %></div>
            </td>
            <td class="px-6 py-4">
              <div class="font-medium text-gray-900"><%= exam.type %></div>
            </td>
            <td class="px-6 py-4 text-right text-sm font-medium">
              <div class="flex flex-col items-end gap-2 sm:flex-row sm:justify-end sm:items-center sm:gap-3">
                <%= link_to t('admin.management.actions.edit'), edit_management_exam_path(exam), class: "text-indigo-600 hover:text-indigo-900",data: { turbo_frame: "profile_content" } %>
                <%= button_to t('admin.management.actions.delete'), management_exam_path(exam), method: :delete,
                  form: { data: { turbo_confirm: t('admin.management.delete_confirm') } },
                  class: "inline text-red-600 hover:text-red-900" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>