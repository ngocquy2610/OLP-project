<%= form_with(model: [:management, exam], class: "space-y-6") do |f| %>
  <% if exam.errors.any? %>
    <div class="bg-red-500/10 border border-red-500/30 p-4 rounded-xl text-red-400 text-sm mb-4">
      <h3 class="font-bold font-label-tech"><%= t('admin.management.errors.header', count: exam.errors.count) %></h3>
      <ul class="list-disc pl-5 mt-1">
        <% exam.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= f.label :topic_id, t('admin.management.exams.form.topic'), class: "block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest" %>
    <%= f.collection_select :topic_id, @topics, :id, :name, { prompt: t('admin.management.forms.choose_topic') }, { class: "w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim focus:ring-1 focus:ring-primary-fixed-dim" } %>
  </div>
  <div>
    <%= f.label :question, t('admin.management.exams.form.question'), class: "block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest" %>
    <%= f.text_field :question, class: "w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim focus:ring-1 focus:ring-primary-fixed-dim" %>
  </div>
  <%= render "management/shared/answer_fields",
             param_prefix: "exam",
             answers: f.object.answers.to_s.split(",").map(&:strip),
             correct_answer: f.object.correct_answers,
             title: t('admin.management.exams.form.answers'),
             hint: t('admin.management.exams.form.answers_hint'),
             answer_label: t('admin.management.forms.answer', default: 'Answer'),
             correct_label: t('admin.management.forms.correct_answer', default: 'Correct'),
             button_label: t('admin.management.forms.add_answer', default: 'Add answer') %>
  <div>
    <%= f.label :type, t('admin.management.exams.form.kind'), class: "block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest" %>
    <%= f.select :type, options_for_select([[t('admin.management.types.multiple_choice'), "multiple_choice"], [t('admin.management.types.true_false'), "true_false"]], f.object.type), { prompt: t('admin.management.forms.choose_type') }, { class: "w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim focus:ring-1 focus:ring-primary-fixed-dim" } %>
  </div>
    <div>
      <%= f.label :time_limit_minutes, t('admin.management.exams.form.time_limit'), class: "block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest" %>
      <p class="text-slate-400 text-xs mb-1"><em><%= t('admin.management.exams.form.time_limit_hint') %></em></p>
      <%= f.number_field :time_limit_minutes, min: 1, required: true, class: "w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim focus:ring-1 focus:ring-primary-fixed-dim" %>
    </div>
  <div class="flex flex-col sm:flex-row sm:items-center gap-3 pt-4">
    <%= f.submit t('admin.management.exams.form.submit'), class: "glow-button font-label-tech px-6 py-2 rounded-xl cursor-pointer" %>
    <%= link_to t('admin.management.exams.form.cancel'), profile_path(current_user), class: "text-slate-400 hover:text-primary-fixed-dim transition font-label-tech text-sm" %>
  </div>
<% end %>
