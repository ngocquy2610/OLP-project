<%= turbo_frame_tag "profile_content" do %>
  <h1 class="text-2xl font-bold mb-6">Tạo bài kiểm tra mới (Nhiều câu hỏi)</h1>
  <%= form_with url: management_exams_path, local: true do %>
    <div class="mb-4">
      <label class="block text-sm font-semibold text-gray-700 mb-1">Thuộc chủ đề</label>
      <%= select_tag :topic_id, options_from_collection_for_select(Topic.all, :id, :name, @exam&.topic_id), include_blank: "Chọn một chủ đề...", class: "w-full border rounded-lg p-2.5 bg-white" %>
    </div>
    <div id="questions">
      <div class="question-row mb-4 p-4 border rounded-lg">
        <div class="mb-2">
          <label class="block text-sm font-semibold text-gray-700">Câu hỏi</label>
          <input type="text" name="exams[][question]" class="w-full border rounded-lg p-2.5" />
        </div>
        <div class="mb-2">
          <label class="block text-sm font-semibold text-gray-700">Đáp án (phân tách bởi dấu phẩy)</label>
          <input type="text" name="exams[][answers]" class="w-full border rounded-lg p-2.5" />
        </div>
        <div class="mb-2">
          <label class="block text-sm font-semibold text-gray-700">Đáp án đúng</label>
          <input type="text" name="exams[][correct_answers]" class="w-full border rounded-lg p-2.5" />
        </div>
        <div class="mb-2">
          <label class="block text-sm font-semibold text-gray-700">Loại</label>
          <select name="exams[][type]" class="w-full border rounded-lg p-2.5 bg-white">
            <option value="">Chọn loại...</option>
            <option value="multiple_choice">Multiple choice</option>
            <option value="true_false">True / False</option>
          </select>
        </div>
        <button type="button" class="remove-question mt-2 text-sm text-red-600">Xóa câu hỏi</button>
      </div>
    </div>
    <div class="flex items-center space-x-3 pt-4">
      <button id="add-question" type="button" class="bg-green-600 text-white px-4 py-2 rounded-lg">Thêm câu hỏi</button>
      <%= submit_tag "Tạo bài kiểm tra", class: "bg-indigo-600 text-white px-6 py-2 rounded-lg font-bold" %>
      <%= link_to "Hủy bỏ", profile_path(current_user), class: "text-gray-500 hover:underline" %>
    </div>
  <% end %>
  <template id="question-template">
    <div class="question-row mb-4 p-4 border rounded-lg">
      <div class="mb-2">
        <label class="block text-sm font-semibold text-gray-700">Câu hỏi</label>
        <input type="text" name="exams[][question]" class="w-full border rounded-lg p-2.5" />
      </div>
      <div class="mb-2">
        <label class="block text-sm font-semibold text-gray-700">Đáp án (phân tách bởi dấu phẩy)</label>
        <input type="text" name="exams[][answers]" class="w-full border rounded-lg p-2.5" />
      </div>
      <div class="mb-2">
        <label class="block text-sm font-semibold text-gray-700">Đáp án đúng</label>
        <input type="text" name="exams[][correct_answers]" class="w-full border rounded-lg p-2.5" />
      </div>
      <div class="mb-2">
        <label class="block text-sm font-semibold text-gray-700">Loại</label>
        <select name="exams[][type]" class="w-full border rounded-lg p-2.5 bg-white">
          <option value="">Chọn loại...</option>
          <option value="multiple_choice">Multiple choice</option>
          <option value="true_false">True / False</option>
        </select>
      </div>
      <button type="button" class="remove-question mt-2 text-sm text-red-600">Xóa câu hỏi</button>
    </div>
  </template>
  <script>
    (function(){
      const addBtn = document.getElementById('add-question')
      const container = document.getElementById('questions')
      const template = document.getElementById('question-template')

      addBtn.addEventListener('click', function(e){
        const clone = template.content.cloneNode(true)
        container.appendChild(clone)
      })

      document.addEventListener('click', function(e){
        if(e.target && e.target.classList.contains('remove-question')){
          const row = e.target.closest('.question-row')
          if(row) row.remove()
        }
      })
    })()
  </script>
<% end %>