<%= form_with(model: [:management, lesson], local: true, html: { multipart: true }, class: "space-y-6") do |f| %>
  <% if lesson.errors.any? %>
      <div class="bg-red-500/10 border border-red-500/30 p-4 rounded-xl text-red-400 text-sm mb-4">
        <h3 class="font-bold font-label-tech"><%= t('admin.management.errors.header', count: lesson.errors.count) %></h3>
      <ul class="list-disc pl-5 mt-1">
        <% lesson.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
  <div>
    <%= f.label :topic_id, t('admin.management.lessons.form.topic'), class: "block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest" %>
    <%= f.collection_select :topic_id, @topics, :id, :name, { prompt: t('admin.management.forms.choose_topic') }, { class: "w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim focus:ring-1 focus:ring-primary-fixed-dim" } %>
  </div>
  <div>
    <%= f.label :name, t('admin.management.lessons.form.name'), class: "block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest" %>
    <%= f.text_field :name, class: "w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim focus:ring-1 focus:ring-primary-fixed-dim" %>
  </div>
  <div>
    <%= f.label :description, t('admin.management.lessons.form.description'), class: "block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest" %>
    <%= f.text_area :description, rows: 4, class: "w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim focus:ring-1 focus:ring-primary-fixed-dim" %>
  </div>
  <div>
    <%= f.label :video, t('admin.management.lessons.form.video'), class: "block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest" %>
    <%= f.file_field :video, accept: 'video/*', class: "w-full text-sm text-slate-400 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border file:border-primary-fixed-dim/30 file:text-xs file:font-label-tech file:bg-primary-fixed-dim/10 file:text-primary-fixed-dim hover:file:bg-primary-fixed-dim/20" %>
  </div>
  <div class="flex flex-col sm:flex-row sm:items-center gap-3 pt-4">
        <%= f.submit t('admin.management.lessons.form.submit'), class: "glow-button font-label-tech px-6 py-2 rounded-xl cursor-pointer" %>
        <%= link_to t('admin.management.lessons.form.cancel'), profile_path(current_user), class: "text-slate-400 hover:text-primary-fixed-dim transition font-label-tech text-sm" %>
  </div>
<% end %>