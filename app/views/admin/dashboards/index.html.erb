<%= turbo_frame_tag "profile_content" do %>
  <div class="max-w-7xl mx-auto mt-8 px-4 sm:px-6 lg:px-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-900"><%= t('admin.dashboard.title') %></h1>
      <p class="mt-2 text-sm text-gray-600"><%= t('admin.dashboard.subtitle') %></p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-10">
      <div class="bg-white rounded-lg shadow p-6 border-l-4 border-blue-500">
        <p class="text-sm font-medium text-gray-500 uppercase tracking-wide"><%= t('admin.dashboard.cards.total_students') %></p>
        <p class="mt-2 text-3xl font-bold text-gray-900"><%= @student_count %></p>
      </div>

      <div class="bg-white rounded-lg shadow p-6 border-l-4 border-green-500">
        <p class="text-sm font-medium text-gray-500 uppercase tracking-wide"><%= t('admin.dashboard.cards.total_teachers') %></p>
        <p class="mt-2 text-3xl font-bold text-gray-900"><%= @teacher_count %></p>
      </div>

      <div class="bg-white rounded-lg shadow p-6 border-l-4 border-purple-500">
        <p class="text-sm font-medium text-gray-500 uppercase tracking-wide"><%= t('admin.dashboard.cards.active_courses') %></p>
        <p class="mt-2 text-3xl font-bold text-gray-900"><%= @course_count %></p>
      </div>

      <div class="bg-white rounded-lg shadow p-6 border-l-4 border-yellow-500">
        <p class="text-sm font-medium text-gray-500 uppercase tracking-wide"><%= t('admin.dashboard.cards.total_enrollments') %></p>
        <p class="mt-2 text-3xl font-bold text-gray-900"><%= @total_sales %></p>
      </div>

      <div class="bg-white rounded-lg shadow p-6 border-l-4 border-emerald-500">
        <p class="text-sm font-medium text-gray-500 uppercase tracking-wide"><%= t('admin.dashboard.cards.gross_revenue') %></p>
        <p class="mt-2 text-3xl font-bold text-gray-900"><%= @total_income %></p>
        <p class="mt-1 text-xs font-semibold text-emerald-600"><%= t('admin.dashboard.platform_profit', profit: @platform_profit) %></p>
      </div>
    </div>

    <div class="bg-white rounded-lg shadow p-6 mb-8">
      <div class="flex justify-between items-center mb-6 pb-4 border-b border-gray-100">
          <div class="flex items-center space-x-4">
          <h2 class="text-xl font-bold text-gray-900"><%= t('admin.dashboard.sales_performance') %></h2>
          <span class="bg-emerald-100 text-emerald-800 text-sm font-bold px-3 py-1.5 rounded-full">
            <%= t('admin.dashboard.income_label', income: @period_income) %>
          </span>
        </div>
        
          <%= form_with url: admin_dashboard_path, method: :get, class: "inline-block" do |f| %>
          <%= f.select :period, 
                options_for_select([[t('admin.dashboard.period_options.day'), 'day'], [t('admin.dashboard.period_options.month'), 'month'], [t('admin.dashboard.period_options.year'), 'year']], @period), 
                {}, 
                { class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-indigo-500 focus:border-indigo-500 block p-2.5 cursor-pointer", 
                  onchange: "this.form.requestSubmit()" } %>
        <% end %>
      </div>

      <div class="mt-4">
          <% if @period == 'year' %>
          <%= column_chart @sales_data, 
                           colors: ["#f59e0b"], 
                           xtitle: t('admin.dashboard.charts.xtitle_year'), 
                           ytitle: t('admin.dashboard.charts.ytitle'),
                           empty: t('admin.dashboard.charts.empty') %>
        <% else %>
          <%= line_chart @sales_data, 
                         colors: ["#4f46e5"], 
                         xtitle: (@period == 'day' ? t('admin.dashboard.charts.xtitle_date') : t('admin.dashboard.charts.xtitle_month')), 
                         ytitle: t('admin.dashboard.charts.ytitle'),
                         curve: true,
                         points: (@period == 'month'),
                         empty: t('admin.dashboard.charts.empty') %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>