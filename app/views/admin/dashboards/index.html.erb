<%= turbo_frame_tag "profile_content" do %>
  <div class="max-w-7xl mx-auto mt-8 px-4 sm:px-6 lg:px-8 pb-12">
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-white font-headline-lg"><%= t('admin.dashboard.title') %></h1>
      <p class="mt-2 text-sm text-slate-400 font-body-md"><%= t('admin.dashboard.subtitle') %></p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-10">
      <div class="glass-card-no-hover rounded-xl p-5 border-l-4 border-sky-500">
        <p class="text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.dashboard.cards.total_students') %></p>
        <p class="mt-2 text-3xl font-bold text-white"><%= @student_count %></p>
      </div>

      <div class="glass-card-no-hover rounded-xl p-5 border-l-4 border-emerald-500">
        <p class="text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.dashboard.cards.total_teachers') %></p>
        <p class="mt-2 text-3xl font-bold text-white"><%= @teacher_count %></p>
      </div>

      <div class="glass-card-no-hover rounded-xl p-5 border-l-4 border-violet-500">
        <p class="text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.dashboard.cards.active_courses') %></p>
        <p class="mt-2 text-3xl font-bold text-white"><%= @course_count %></p>
      </div>

      <div class="glass-card-no-hover rounded-xl p-5 border-l-4 border-amber-500">
        <p class="text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.dashboard.cards.total_enrollments') %></p>
        <p class="mt-2 text-3xl font-bold text-white"><%= @total_sales %></p>
      </div>

      <div class="glass-card-no-hover rounded-xl p-5 border-l-4 border-primary-fixed-dim">
        <p class="text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.dashboard.cards.gross_revenue') %></p>
        <p class="mt-2 text-2xl font-bold text-primary-fixed-dim"><%= format_vnd(@total_income) %></p>
        <p class="mt-1 text-xs font-semibold text-emerald-400"><%= t('admin.dashboard.platform_profit', profit: format_vnd(@platform_profit)) %></p>
      </div>
    </div>

    <div class="glass-card-no-hover rounded-xl p-6 mb-8">
      <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6 pb-4 border-b border-white/10">
        <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
          <h2 class="text-xl font-bold text-white font-headline-sm"><%= t('admin.dashboard.sales_performance') %></h2>
          <span class="bg-emerald-500/20 text-emerald-400 text-sm font-bold px-3 py-1.5 rounded-full border border-emerald-500/30">
            <%= t('admin.dashboard.income_label', income: format_vnd(@period_income)) %>
          </span>
        </div>
        
        <%= form_with url: admin_dashboard_path, method: :get, class: "w-full sm:w-auto" do |f| %>
          <%= f.select :period, 
                options_for_select([[t('admin.dashboard.period_options.day'), 'day'], [t('admin.dashboard.period_options.month'), 'month'], [t('admin.dashboard.period_options.year'), 'year']], @period), 
                {}, 
                { class: "w-full sm:w-auto bg-surface-container-high border border-outline-variant text-white text-sm rounded-lg focus:ring-primary-fixed-dim focus:border-primary-fixed-dim block p-2.5 cursor-pointer", 
                  onchange: "this.form.requestSubmit()" } %>
        <% end %>
      </div>

      <div class="mt-4 [&_.charts-wrapper]:bg-transparent [&_canvas]:!bg-transparent">
        <% if @period == 'year' %>
          <%= column_chart @sales_data, 
                           colors: ["#f59e0b"], 
                           xtitle: t('admin.dashboard.charts.xtitle_year'), 
                           ytitle: t('admin.dashboard.charts.ytitle'),
                           empty: t('admin.dashboard.charts.empty'),
                           background: "transparent",
                           library: { backgroundColor: "transparent", legend: { labels: { color: "#94a3b8" } }, scales: { x: { ticks: { color: "#94a3b8" }, grid: { color: "rgba(148,163,184,0.1)" } }, y: { ticks: { color: "#94a3b8" }, grid: { color: "rgba(148,163,184,0.1)" } } } } %>
        <% else %>
          <%= line_chart @sales_data, 
                         colors: ["#22d3ee"], 
                         xtitle: (@period == 'day' ? t('admin.dashboard.charts.xtitle_date') : t('admin.dashboard.charts.xtitle_month')), 
                         ytitle: t('admin.dashboard.charts.ytitle'),
                         curve: true,
                         points: (@period == 'month'),
                         empty: t('admin.dashboard.charts.empty'),
                         background: "transparent",
                         library: { backgroundColor: "transparent", legend: { labels: { color: "#94a3b8" } }, scales: { x: { ticks: { color: "#94a3b8" }, grid: { color: "rgba(148,163,184,0.1)" } }, y: { ticks: { color: "#94a3b8" }, grid: { color: "rgba(148,163,184,0.1)" } } } } %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>