<%= turbo_frame_tag "profile_content" do %>
<div class="mb-4 px-2">
  <%= link_to t('devise.links.back', default: 'Back'), admin_courses_path, class: "inline-flex items-center gap-1.5 text-slate-400 hover:text-primary-fixed-dim transition font-label-tech text-sm" %>
</div>
<div class="flex flex-col lg:flex-row min-h-screen" x-data="{ sidebarOpen: false, videoLoading: true, videoError: false }">
  <div class="lg:hidden flex items-center justify-between bg-surface-container-high border-b border-white/10 px-4 py-2">
    <span class="font-label-tech text-sm text-white"><%= @current_lesson&.name %></span>
    <button @click="sidebarOpen = !sidebarOpen" class="text-slate-300 focus:outline-none">
        <svg x-show="!sidebarOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg x-show="sidebarOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="flex-1 flex flex-col min-w-0">
      <div class="relative bg-black min-h-[280px] lg:min-h-[420px] flex items-center justify-center">
        <% if @current_lesson&.video&.attached? %>
          <video
            controls
            preload="metadata"
            @loadstart="videoLoading = true; videoError = false"
            @waiting="videoLoading = true"
            @stalled="videoLoading = true"
            @canplay="videoLoading = false"
            @playing="videoLoading = false"
            @error="videoLoading = false; videoError = true"
            class="w-full h-full max-h-[70vh] bg-black"
          >
            <source src="<%= url_for(@current_lesson.video) %>" type="video/mp4">
            <%= t('admin.courses.learn.no_video') %>
          </video>

          <div x-show="videoLoading" class="absolute inset-0 bg-black/70 flex flex-col items-center justify-center text-white gap-3">
            <div class="w-10 h-10 border-4 border-white/30 border-t-primary-fixed-dim rounded-full animate-spin"></div>
            <p class="text-sm font-label-tech"><%= t('admin.courses.learn.loading_video', default: 'Video is loading, please wait...') %></p>
          </div>

          <div x-show="videoError" class="absolute inset-0 bg-black/70 flex items-center justify-center text-white px-6 text-center">
            <p class="text-sm font-medium"><%= t('admin.courses.learn.video_load_failed', default: 'Video cannot be loaded right now. Please refresh or try again later.') %></p>
          </div>
        <% else %>
          <div class="h-[500px] flex items-center justify-center bg-black text-slate-400 font-label-tech">
            <%= t('admin.courses.learn.no_video') %>
          </div>
        <% end %>
      </div>
      <div class="p-6 border-t border-white/10" style="background-color: #171B24;">
        <h2 class="text-xl font-bold text-white font-headline-sm">
          <%= @current_lesson&.name %>
        </h2>
        <% if @current_lesson&.description.present? %>
          <p class="text-white mt-2 leading-relaxed">
            <%= @current_lesson.description %>
          </p>
        <% else %>
          <p class="text-white mt-2 italic">
            <%= t('admin.courses.show.no_description', default: 'No description available for this lesson yet.') %>
          </p>
        <% end %>
      </div>
    </div>

    <div class="lg:w-80 bg-surface-container-high border-t lg:border-t-0 lg:border-l border-white/10 overflow-y-auto" :class="sidebarOpen ? 'block' : 'hidden lg:block'">
      <% @topics.each do |topic| %>
      <div class="border-b border-white/10">
        <div class="p-4 bg-surface-container font-semibold text-sm text-white font-label-tech">
            <%= topic.name %>
          </div>
          <% topic.lessons.each do |lesson| %>
          <%= link_to admin_course_path(@course, lesson_id: lesson.id),
            class: "flex items-center gap-2 px-4 py-3 hover:bg-white/5 transition text-sm #{lesson == @current_lesson ? 'bg-primary-fixed-dim/10 text-primary-fixed-dim border-l-2 border-primary-fixed-dim' : 'text-slate-300'}",
            data: { turbo_frame: "profile_content" } do %>
            <span class="material-symbols-outlined text-base">play_circle</span>
            <p><%= lesson.name %></p>
            <% end %>

            <%# Show practice questions for this lesson (admin read-only) in a collapsible section %>
            <% practices = @practices_by_lesson[lesson.id] || [] %>
            <details class="px-4 py-2" data-controller="collapse">
                <summary class="cursor-pointer text-xs font-label-tech text-slate-400 hover:text-primary-fixed-dim transition">📝 <%= t('admin.courses.show.practice_summary', count: practices.size) %></summary>
                <div class="mt-2 space-y-2">
                <% if practices.any? %>
                  <% practices.each do |practice| %>
                    <div class="px-3 py-2 bg-surface-container rounded-lg border border-white/10">
                      <p class="font-medium text-white text-sm"><%= practice.question %></p>
                      <ul class="list-disc ml-5 mt-2 text-xs text-slate-400 space-y-1">
                        <% practice.answers.to_s.split(',').each do |ans| %>
                          <% correct = practice.correct_answers.to_s.split(',').map(&:strip).include?(ans.strip) %>
                          <li class="<%= correct ? 'text-emerald-400 font-semibold' : '' %>"><%= ans.strip %></li>
                        <% end %>
                      </ul>
                    </div>
                  <% end %>
                  <% else %>
                  <div class="px-3 py-2 text-xs text-slate-500 font-body-md"><%= t('admin.courses.show.no_practice') %></div>
                <% end %>
              </div>
            </details>
          <% end %>
          <%# For admins: show all exam questions for the topic (read-only) %>
          <% exams = @exams_by_topic[topic.id] || [] %>
          <% if exams.any? %>
            <details class="p-3" data-controller="collapse">
                <summary class="cursor-pointer text-xs font-label-tech text-slate-400 hover:text-amber-400 transition"><%= t('admin.courses.show.exam_summary', count: exams.size) %></summary>
                <div class="mt-3 space-y-2">
                <% exams.each do |exam| %>
                  <div class="border border-amber-500/20 rounded-lg px-4 py-3 bg-amber-500/5">
                    <p class="font-medium text-white text-sm"><%= t('admin.courses.show.question_prefix') %> <%= exam.question %></p>
                    <ul class="list-disc ml-5 mt-2 text-xs text-slate-400 space-y-1">
                      <% exam.answers.to_s.split(',').each do |ans| %>
                        <% correct = exam.correct_answers.to_s.split(',').map(&:strip).include?(ans.strip) %>
                        <li class="<%= correct ? 'text-emerald-400 font-semibold' : '' %>"><%= ans.strip %></li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>