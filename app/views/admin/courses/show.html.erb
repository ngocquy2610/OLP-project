<%= turbo_frame_tag "profile_content" do %>
<div class="mb-8">
    <%= link_to t('devise.links.back', default: 'Back'), admin_courses_path, class: "bg-gray-500 text-white border-1 border-gray-500 px-4 py-2 hover:bg-white hover:text-gray-500 hover:border-1" %>
</div>
<div class="flex h-screen bg-gray-100">
    <div class="flex-1 flex flex-col">
      <div class="bg-black">
        <% if @current_lesson&.video&.attached? %>
          <video controls class="w-full h-fit bg-black">
            <source src="<%= url_for(@current_lesson.video) %>" type="video/mp4">
            <%= t('courses.learn.no_video') %>
          </video>
        <% else %>
          <div class="h-[500px] flex items-center justify-center bg-black text-white">
            <%= t('courses.learn.no_video') %>
          </div>
        <% end %>
      </div>
      <div class="p-6 bg-white">
        <h2 class="text-xl font-semibold">
          <%= @current_lesson&.name %>
        </h2>
        <p class="text-gray-600 mt-2">
          <%= @current_lesson&.description %>
        </p>
      </div>
    </div>


    <div class="w-100 bg-white border-l overflow-y-auto">
      <% @topics.each do |topic| %>
        <div class="border-b">
          <div class="p-4 bg-gray-100 font-semibold">
            <%= topic.name %>
          </div>
          <% topic.lessons.each do |lesson| %>
            <%= link_to admin_course_path(@course, lesson_id: lesson.id),
              class: "block px-4 py-3 hover:bg-gray-50 #{'bg-blue-100' if lesson == @current_lesson}",
              data: { turbo_frame: "profile_content" } do %>
              <p class="">
                ▶ <%= lesson.name %>
              </p>
            <% end %>

            <%# Show practice questions for this lesson (admin read-only) in a collapsible section %>
            <% practices = @practices_by_lesson[lesson.id] || [] %>
            <details class="px-4 py-2" data-controller="collapse">
              <summary class="cursor-pointer text-sm text-gray-600">📝 Practice questions (<%= practices.size %>)</summary>
              <div class="mt-2">
                <% if practices.any? %>
                  <% practices.each do |practice| %>
                    <div class="px-3 py-2 bg-gray-50 border rounded mb-2">
                      <p class="font-medium"><%= practice.question %></p>
                      <ul class="list-disc ml-6 mt-2 text-sm text-gray-700">
                        <% practice.answers.to_s.split(',').each do |ans| %>
                          <% correct = practice.correct_answers.to_s.split(',').map(&:strip).include?(ans.strip) %>
                          <li class="<%= 'text-green-600 font-semibold' if correct %>"><%= ans.strip %></li>
                        <% end %>
                      </ul>
                    </div>
                  <% end %>
                <% else %>
                  <div class="px-3 py-2 text-sm text-gray-600">No practice questions for this lesson.</div>
                <% end %>
              </div>
            </details>
          <% end %>
          <%# For admins: show all exam questions for the topic (read-only) %>
          <% exams = @exams_by_topic[topic.id] || [] %>
          <% if exams.any? %>
            <details class="p-3" data-controller="collapse">
              <summary class="cursor-pointer font-semibold">Exam Questions (<%= exams.size %>)</summary>
              <div class="mt-3">
                <% exams.each do |exam| %>
                  <div class="border rounded px-4 py-3 mb-3 bg-gray-50">
                    <p class="font-medium">Q: <%= exam.question %></p>
                    <ul class="list-disc ml-6 mt-2 text-sm text-gray-700">
                      <% exam.answers.to_s.split(',').each do |ans| %>
                        <% correct = exam.correct_answers.to_s.split(',').map(&:strip).include?(ans.strip) %>
                        <li class="<%= 'text-green-600 font-semibold' if correct %>"><%= ans.strip %></li>
                      <% end %>
                    </ul>
                  </div>
                <% end %>
              </div>
            </details>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>