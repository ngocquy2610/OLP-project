<%= turbo_frame_tag "profile_content" do %>
<div class="max-w-7xl mx-auto mt-8 px-4">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900"><%= t('admin.courses.verify.title') %></h1>
    <p class="mt-2 text-sm text-gray-600"><%= t('admin.courses.verify.subtitle') %></p>
  </div>

  <div class="bg-white rounded-lg shadow overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200 bg-gray-50">
      <h2 class="text-lg font-bold text-gray-900"><%= t('admin.courses.verify.pending_approval') %> (<%= @pending_courses.count %>)</h2>
    </div>

    <table class="min-w-full divide-y divide-gray-200">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('admin.courses.verify.course_name') %></th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('admin.courses.verify.teacher') %></th>
          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('admin.courses.verify.price') %></th>
          <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase"><%= t('admin.courses.verify.actions') %></th>
        </tr>
      </thead>
      <tbody class="bg-white divide-y divide-gray-200">
        <% if @pending_courses.empty? %>
          <tr>
            <td colspan="4" class="px-6 py-8 text-center text-gray-500"><%= t('admin.courses.verify.no_pending') %></td>
          </tr>
        <% else %>
          <% @pending_courses.each do |course| %>
            <tr>
              <td class="px-6 py-4 font-medium text-gray-900"><%= course.name %></td>
                <td class="px-6 py-4 text-gray-500"><%= course.user&.fullname.presence || 'Not available' %></td>
              <td class="px-6 py-4 text-gray-500"><%= number_to_currency(course.price) %></td>
              <td class="px-6 py-4 text-right space-x-2 flex justify-center">
                <%= button_to t('admin.courses.verify.approve'), published_admin_course_path(course), method: :patch, onclick: "return confirm('#{j t('admin.management.actions.confirm')}')", class: "bg-emerald-500 text-white px-3 py-1 rounded hover:bg-emerald-600 text-sm font-medium" %>
                <%= button_to t('admin.courses.verify.details'), admin_course_path(course), method: :get, class: "bg-blue-500 text-white px-3 py-1 rounded hover:bg-blue-600 text-sm font-medium" %>
                <%= button_to t('admin.courses.verify.reject'), rejected_admin_course_path(course), method: :patch, onclick: "return confirm('#{j t('admin.management.actions.confirm')}')", class: "bg-red-500 text-white px-3 py-1 rounded hover:bg-red-600 text-sm font-medium" %>
              </td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
<% end %>