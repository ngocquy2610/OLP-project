<%= turbo_frame_tag "profile_content" do %>
  <div class="max-w-2xl mx-auto mt-8 px-4 pb-12">
    <div class="mb-6">
      <%= link_to "← " + t('admin.management.vouchers.new.back'), admin_vouchers_path, class: "text-slate-400 hover:text-primary-fixed-dim transition font-label-tech text-sm" %>
      <h1 class="text-2xl font-bold text-white mt-3 font-headline-sm"><%= t('admin.management.vouchers.new.title') %></h1>
    </div>

    <div class="glass-card-no-hover rounded-xl p-6">
      <%= form_with model: [:admin, @voucher], class: "space-y-6" do |f| %>
      
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= f.label :code, t('admin.management.vouchers.new.code_label'), class: "block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest" %>
            <%= f.text_field :code, required: true, class: "w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white placeholder-slate-500 focus:outline-none focus:border-primary-fixed-dim focus:ring-1 focus:ring-primary-fixed-dim uppercase" %>
          </div>
          <div>
            <%= f.label :discount_percent, t('admin.management.vouchers.new.discount_label'), class: "block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest" %>
            <%= f.number_field :discount_percent, required: true, min: 1, max: 100, class: "w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim focus:ring-1 focus:ring-primary-fixed-dim" %>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <%= f.label :usage_limit, t('admin.management.vouchers.new.usage_limit_label'), class: "block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest" %>
            <%= f.number_field :usage_limit, placeholder: t('admin.management.vouchers.new.usage_limit_placeholder'), class: "w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white placeholder-slate-500 focus:outline-none focus:border-primary-fixed-dim focus:ring-1 focus:ring-primary-fixed-dim" %>
          </div>
          <div>
            <%= f.label :expires_at, t('admin.management.vouchers.new.expires_label'), class: "block text-xs font-label-tech text-slate-400 mb-1 uppercase tracking-widest" %>
            <%= f.datetime_field :expires_at, class: "w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim focus:ring-1 focus:ring-primary-fixed-dim" %>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <%= f.check_box :active, checked: true, class: "h-4 w-4 accent-primary-fixed-dim" %>
          <%= f.label :active, t('admin.management.vouchers.new.activate_now'), class: "text-sm text-slate-300 font-body-md" %>
        </div>

        <div class="pt-4 border-t border-white/10">
          <%= f.submit t('admin.management.vouchers.new.submit'), class: "w-full glow-button font-label-tech py-2 px-4 rounded-xl cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
