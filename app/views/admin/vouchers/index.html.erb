<%= turbo_frame_tag "profile_content" do %>
    <div class="max-w-7xl mx-auto mt-8 px-4">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
        <div>
        <h1 class="text-3xl font-bold text-gray-900"><%= t('admin.management.vouchers.index.title') %></h1>
        <p class="mt-2 text-sm text-gray-600"><%= t('admin.management.vouchers.index.subtitle') %></p>
        </div>
        <%= link_to t('admin.management.vouchers.index.new'), new_admin_voucher_path, class: "bg-blue-600 text-white px-4 py-2 rounded shadow hover:bg-blue-700 font-medium w-full sm:w-auto text-center" %>
    </div>

    <div class="bg-white rounded-lg shadow overflow-x-auto">
        <table class="min-w-[900px] xl:min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('admin.management.vouchers.index.table.code') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('admin.management.vouchers.index.table.discount') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('admin.management.vouchers.index.table.usage') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('admin.management.vouchers.index.table.active_price') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('admin.management.vouchers.index.table.expires') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('admin.management.vouchers.index.table.status') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase"><%= t('admin.management.vouchers.index.table.actions') %></th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            <% @vouchers.each do |voucher| %>
            <tr>
                <td class="px-6 py-4 font-bold text-gray-900"><%= voucher.code %></td>
                <td class="px-6 py-4 text-emerald-600 font-bold">-<%= voucher.discount_percent %>%</td>
                <td class="px-6 py-4 text-gray-500">
                <%= voucher.used_count %> / <%= voucher.usage_limit || '∞' %>
                </td>
                <td class="px-6 py-4 text-gray-500">

                <%= voucher.active_price ? format_vnd(voucher.active_price) : t('admin.management.vouchers.index.not_applied') %>
                </td>
                <td class="px-6 py-4 text-gray-500">
                <%= voucher.expires_at ? voucher.expires_at.strftime("%d/%m/%Y %H:%M") : t('admin.management.vouchers.index.no_expiry') %>
                </td>
                <td class="px-6 py-4">
                <% if voucher.usable? %>
                    <span class="px-2 py-1 bg-green-100 text-green-800 rounded-full text-xs font-bold"><%= t('admin.management.vouchers.index.running') %></span>
                <% else %>
                    <span class="px-2 py-1 bg-red-100 text-red-800 rounded-full text-xs font-bold"><%= t('admin.management.vouchers.index.expired_or_used') %></span>
                <% end %>
                </td>
                <td class="px-6 py-4">
                <div class="flex items-center gap-2">
                    <%= link_to "Edit", edit_admin_voucher_path(voucher), class: "px-3 py-1 rounded border border-blue-200 text-blue-700 hover:bg-blue-50 text-sm font-medium" %>
                    <%= link_to "Delete", admin_voucher_path(voucher), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this voucher?" }, class: "px-3 py-1 rounded border border-red-200 text-red-700 hover:bg-red-50 text-sm font-medium" %>
                </div>
                </td>
            </tr>
            <% end %>
        </tbody>
        </table>
    </div>
    </div>
<% end %>
