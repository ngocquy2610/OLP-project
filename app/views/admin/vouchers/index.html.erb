<%= turbo_frame_tag "profile_content" do %>
  <div class="max-w-7xl mx-auto mt-8 px-4 pb-12">
    <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4 mb-6">
      <div>
        <h1 class="text-3xl font-bold text-white font-headline-lg"><%= t('admin.management.vouchers.index.title') %></h1>
        <p class="mt-2 text-sm text-slate-400 font-body-md"><%= t('admin.management.vouchers.index.subtitle') %></p>
      </div>
      <%= link_to t('admin.management.vouchers.index.new'), new_admin_voucher_path, class: "glow-button font-label-tech text-sm px-4 py-2 rounded-xl w-full sm:w-auto text-center" %>
    </div>

    <div class="glass-card-no-hover rounded-xl overflow-x-auto">
      <table class="min-w-[900px] xl:min-w-full">
        <thead>
          <tr class="border-b border-white/10">
            <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.vouchers.index.table.code') %></th>
            <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.vouchers.index.table.discount') %></th>
            <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.vouchers.index.table.usage') %></th>
            <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.vouchers.index.table.active_price') %></th>
            <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.vouchers.index.table.expires') %></th>
            <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.vouchers.index.table.status') %></th>
            <th class="px-6 py-3 text-left text-xs font-label-tech text-slate-400 uppercase tracking-widest"><%= t('admin.management.vouchers.index.table.actions') %></th>
          </tr>
        </thead>
        <tbody>
          <% @vouchers.each do |voucher| %>
            <tr class="border-b border-white/5 hover:bg-white/5 transition-colors">
              <td class="px-6 py-4 font-bold text-primary-fixed-dim font-label-tech tracking-widest"><%= voucher.code %></td>
              <td class="px-6 py-4 text-emerald-400 font-bold">-<%= voucher.discount_percent %>%</td>
              <td class="px-6 py-4 text-slate-300 text-sm">
                <%= voucher.used_count %> / <%= voucher.usage_limit || '∞' %>
              </td>
              <td class="px-6 py-4 text-slate-300 text-sm">
                <%= voucher.active_price ? format_vnd(voucher.active_price) : t('admin.management.vouchers.index.not_applied') %>
              </td>
              <td class="px-6 py-4 text-slate-300 text-sm">
                <%= voucher.expires_at ? voucher.expires_at.strftime("%d/%m/%Y %H:%M") : t('admin.management.vouchers.index.no_expiry') %>
              </td>
              <td class="px-6 py-4">
                <% if voucher.usable? %>
                  <span class="px-2 py-1 bg-emerald-500/20 text-emerald-400 rounded-full text-xs font-bold border border-emerald-500/30 font-label-tech"><%= t('admin.management.vouchers.index.running') %></span>
                <% else %>
                  <span class="px-2 py-1 bg-red-500/20 text-red-400 rounded-full text-xs font-bold border border-red-500/30 font-label-tech"><%= t('admin.management.vouchers.index.expired_or_used') %></span>
                <% end %>
              </td>
              <td class="px-6 py-4">
                <div class="flex items-center gap-2">
                  <%= link_to t('missing_i18n.common.edit'), edit_admin_voucher_path(voucher), class: "px-3 py-1 rounded-full border border-sky-500/30 text-sky-400 hover:bg-sky-500/20 text-xs font-label-tech transition" %>
                  <%= link_to t('missing_i18n.common.delete'), admin_voucher_path(voucher), data: { turbo_method: :delete, turbo_confirm: t('missing_i18n.admin.vouchers.delete_confirm') }, class: "px-3 py-1 rounded-full border border-red-500/30 text-red-400 hover:bg-red-500/20 text-xs font-label-tech transition" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
