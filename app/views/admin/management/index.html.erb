<%= turbo_frame_tag "profile_content" do %>
    <h2 class="text-2xl font-semibold text-gray-800 mb-6">Quản lý người dùng</h2>
    <div class="overflow-x-auto"></div>
        <table class="min-w-full bg-white border border-gray-200">
            <thead>
            <tr>
                <th class="py-2 px-4 border-b text-left text-sm font-medium text-gray-600">ID</th>
                <th class="py-2 px-4 border-b text-left text-sm font-medium text-gray-600">Tên</th>
                <th class="py-2 px-4 border-b text-left text-sm font-medium text-gray-600">Email</th>
                <th class="py-2 px-4 border-b text-left text-sm font-medium text-gray-600">Vai trò</th>
                <th class="py-2 px-4 border-b text-left text-sm font-medium text-gray-600">Hành động</th>
            </tr>
            </thead>
            <tbody>
            <% @users.each do |user| %>
                <tr class="hover:bg-gray-50">
                <td class="py-2 px-4 border-b"><%= user.id %></td>
                <td class="py-2 px-4 border-b"><%= user.fullname %></td>
                <td class="py-2 px-4 border-b"><%= user.email %></td>
                <td class="py-2 px-4 border-b"><%= user.role.capitalize %></td>
                <td class="py-2 px-4 border-b">
                    <%= button_to "Xóa", admin_management_destroy_path(user), method: :delete, form: { class: "inline" }, onclick: "return confirm('Are u sure?')", class: "text-red-600 hover:text-red-800 bg-transparent border-0 p-0" %>
                    <%= button_to "Đổi vai trò", admin_management_update_path(user), method: :patch, form: { class: "inline" }, onclick: "return confirm('Are u sure?')", class: "text-blue-600 hover:text-blue-800 bg-transparent border-0 p-0 ml-4" %>
                </td>
                </tr>
            <% end %>
            </tbody>
        </table>
<% end %>