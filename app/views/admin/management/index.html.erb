<%= turbo_frame_tag "profile_content" do %>
    <h2 class="text-2xl font-semibold text-gray-800 mb-6"><%= t('admin.management.title') %></h2>
    <div class="overflow-x-auto">
        <table class="min-w-[640px] bg-white border border-gray-200">
            <thead>
            <tr>
                <th class="py-2 px-4 border-b text-left text-sm font-medium text-gray-600"><%= t('admin.management.table.id') %></th>
                <th class="py-2 px-4 border-b text-left text-sm font-medium text-gray-600"><%= t('admin.management.table.name') %></th>
                <th class="py-2 px-4 border-b text-left text-sm font-medium text-gray-600"><%= t('admin.management.table.email') %></th>
                <th class="py-2 px-4 border-b text-left text-sm font-medium text-gray-600"><%= t('admin.management.table.role') %></th>
                <th class="py-2 px-4 border-b text-left text-sm font-medium text-gray-600"><%= t('admin.management.table.actions') %></th>
            </tr>
            </thead>
            <tbody>
            <% @users.each do |user| %>
                <tr class="hover:bg-gray-50">
                <td class="py-2 px-4 border-b"><%= user.id %></td>
                <td class="py-2 px-4 border-b"><%= user.fullname %></td>
                <td class="py-2 px-4 border-b"><%= user.email %></td>
                <td class="py-2 px-4 border-b"><%= user.role.capitalize %></td>
                <%# TODO: confirm before delete or update role %>
                <td class="py-2 px-4 border-b">
                    <div class="flex flex-col sm:flex-row gap-2 sm:items-center">
                    <%= button_to t('admin.management.actions.delete'), admin_management_destroy_path(user), method: :delete, form: { class: "inline" }, onclick: "return confirm('#{j t('admin.management.actions.confirm')}')", class: "text-red-600 hover:text-red-800 bg-transparent border-0 p-0 text-left" %>
                    <%= button_to t('admin.management.actions.change_role'), admin_management_update_path(user), method: :patch, form: { class: "inline" }, onclick: "return confirm('#{j t('admin.management.actions.confirm')}')", class: "text-blue-600 hover:text-blue-800 bg-transparent border-0 p-0 text-left" %>
                    </div>
                </td>
                </tr>
            <% end %>
            </tbody>
        </table>
        </div>
<% end %>