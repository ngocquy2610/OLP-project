<%= turbo_frame_tag "profile_content" do %>
  <div class="flex flex-col lg:flex-row min-h-screen bg-gray-100" x-data="{ sidebarOpen: false, videoLoading: true, videoError: false }">
    <!-- Mobile sidebar toggle -->
    <div class="lg:hidden flex items-center justify-between bg-gray-800 text-white px-4 py-2">
      <span class="font-semibold text-sm"><%= @current_lesson&.name %></span>
      <button @click="sidebarOpen = !sidebarOpen" class="text-white focus:outline-none">
        <svg x-show="!sidebarOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg x-show="sidebarOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="flex-1 flex flex-col min-w-0">
      <div class="relative bg-black min-h-[280px] lg:min-h-[420px] flex items-center justify-center">
        <% if @current_lesson&.video&.attached? %>
          <video
            controls
            controlsList="nodownload"
            preload="metadata"
            oncontextmenu="return false;"
            @loadstart="videoLoading = true; videoError = false"
            @waiting="videoLoading = true"
            @stalled="videoLoading = true"
            @canplay="videoLoading = false"
            @playing="videoLoading = false"
            @error="videoLoading = false; videoError = true"
            class="w-full h-full max-h-[70vh] bg-black"
          >
            <source src="<%= url_for(@current_lesson.video) %>" type="video/mp4">
            <%= t('admin.courses.learn.no_video') %>
          </video>

          <div x-show="videoLoading" class="absolute inset-0 bg-black/70 flex flex-col items-center justify-center text-white gap-3">
            <div class="w-10 h-10 border-4 border-white/30 border-t-white rounded-full animate-spin"></div>
            <p class="text-sm font-medium"><%= t('admin.courses.learn.loading_video', default: 'Video is loading, please wait...') %></p>
          </div>

          <div x-show="videoError" class="absolute inset-0 bg-black/70 flex items-center justify-center text-white px-6 text-center">
            <p class="text-sm font-medium"><%= t('admin.courses.learn.video_load_failed', default: 'Video cannot be loaded right now. Please refresh or try again later.') %></p>
          </div>
        <% else %>
          <div class="h-[500px] flex items-center justify-center bg-black text-white">
            <%= t('admin.courses.learn.no_video') %>
          </div>
        <% end %>
      </div>
      <div class="p-6 bg-white">
        <h2 class="text-xl font-semibold">
          <%= @current_lesson&.name %>
        </h2>
        <p class="text-gray-600 mt-2">
          <%= @current_lesson&.description %>
        </p>
      </div>
    </div>
    <div class="lg:w-80 bg-white border-t lg:border-t-0 lg:border-l overflow-y-auto" :class="sidebarOpen ? 'block' : 'hidden lg:block'">
      <% @topics.each do |topic| %>
        <div class="border-b">
          <div class="p-4 bg-gray-100 font-semibold">
            <%= topic.name %>
          </div>
          <% topic.lessons.each do |lesson| %>
            <%= link_to learn_course_path(@course, lesson_id: lesson.id),
              class: "block px-4 py-3 hover:bg-gray-50 #{'bg-blue-100' if lesson == @current_lesson}" do %>
              <p class="">
                ▶ <%= lesson.name %>
              </p>
            <% end %>
            <%= link_to practice_lesson_path(lesson),
              class: "block px-4 py-3 hover:bg-gray-50",
              data: { turbo_frame: "profile_content" } do %>
              <p class="">
                📝 <%= t('admin.courses.learn.practice_of', lesson: lesson.name) %>
                <% last_practice = @last_practice_attempts[lesson.id] %>
                <% if last_practice&.completed %>
                  <span class="ml-2 px-2 py-1 bg-green-500 text-white rounded text-xs"><%= t('admin.courses.learn.status.done') %></span>
                <% elsif last_practice %>
                  <span class="ml-2 px-2 py-1 bg-yellow-500 text-white rounded text-xs"><%= t('admin.courses.learn.status.attempted') %></span>
                <% else %>
                  <span class="ml-2 px-2 py-1 bg-gray-500 text-white rounded text-xs"><%= t('admin.courses.learn.status.new') %></span>
                <% end %>
              </p>
            <% end %>
          <% end %>
          <% highest = @highest_attempts[topic.id] %>
          <% if highest %>
            <div class="flex items-center justify-between">
              <% if highest.status == "Passed" %>
                <div class="p-3">
                  <%= link_to t('admin.courses.learn.retry'), exam_topic_path(topic), class: "inline-block bg-green-600 text-white px-3 py-2 rounded-lg hover:bg-green-700", data: { turbo_frame: "profile_content" } %>
                </div>
                <div class="px-4 py-2 text-sm text-gray-700">
                  <%= t('admin.courses.learn.status_label') %> <span class="font-semibold bg-green-500 py-1 px-2 rounded text-white"><%= highest.status %></span>
                </div>
              <% else %>
                <div class="p-3">
                  <%= link_to t('admin.courses.learn.retry'), exam_topic_path(topic), class: "inline-block bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-700", data: { turbo_frame: "profile_content" } %>
                </div>
                <div class="px-4 py-2 text-sm text-gray-700">
                  <%= t('admin.courses.learn.status_label') %> <span class="font-semibold bg-red-500 py-1 px-2 rounded text-white"><%= highest.status %></span>
                </div>
              <% end %>
              <div class="px-4 py-2 text-sm text-gray-700">
                <%= t('admin.courses.learn.score_label') %> <strong><%= highest.score %> %</strong>
              </div>
            </div>
          <% else %>
            <div class="p-3">
              <%= link_to t('admin.courses.learn.take_exam'), exam_topic_path(topic), class: "inline-block bg-green-600 text-white px-3 py-2 rounded-lg hover:bg-green-700", data: { turbo_frame: "profile_content" } %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>