<%= turbo_frame_tag "profile_content" do %>
  <div class="flex h-screen bg-gray-100">
    <div class="flex-1 flex flex-col">
      <div class="bg-black">
        <% if @current_lesson&.video&.attached? %>
          <video controls controlsList="nodownload" preload="metadata" oncontextmenu="return false;" class="w-full h-fit bg-black">
            <source src="<%= url_for(@current_lesson.video) %>" type="video/mp4">
            <%= t('courses.learn.no_video') %>
          </video>
        <% else %>
          <div class="h-[500px] flex items-center justify-center bg-black text-white">
            <%= t('courses.learn.no_video') %>
          </div>
        <% end %>
      </div>
      <div class="p-6 bg-white">
        <h2 class="text-xl font-semibold">
          <%= @current_lesson&.name %>
        </h2>
        <p class="text-gray-600 mt-2">
          <%= @current_lesson&.description %>
        </p>
      </div>
    </div>
    <div class="w-100 bg-white border-l overflow-y-auto">
      <% @topics.each do |topic| %>
        <div class="border-b">
          <div class="p-4 bg-gray-100 font-semibold">
            <%= topic.name %>
          </div>
          <% topic.lessons.each do |lesson| %>
            <%= link_to learn_course_path(@course, lesson_id: lesson.id),
              class: "block px-4 py-3 hover:bg-gray-50 #{'bg-blue-100' if lesson == @current_lesson}" do %>
              <p class="">
                ▶ <%= lesson.name %>
              </p>
            <% end %>
            <%= link_to practice_lesson_path(lesson),
              class: "block px-4 py-3 hover:bg-gray-50",
              data: { turbo_frame: "profile_content" } do %>
              <p class="">
                📝 <%= t('admin.courses.learn.practice_of', lesson: lesson.name) %>
                <% last_practice = @last_practice_attempts[lesson.id] %>
                <% if last_practice&.completed %>
                  <span class="ml-2 px-2 py-1 bg-green-500 text-white rounded text-xs"><%= t('admin.courses.learn.status.done') %></span>
                <% elsif last_practice %>
                  <span class="ml-2 px-2 py-1 bg-yellow-500 text-white rounded text-xs"><%= t('admin.courses.learn.status.attempted') %></span>
                <% else %>
                  <span class="ml-2 px-2 py-1 bg-gray-500 text-white rounded text-xs"><%= t('admin.courses.learn.status.new') %></span>
                <% end %>
              </p>
            <% end %>
          <% end %>
          <% highest = @highest_attempts[topic.id] %>
          <% if highest %>
            <div class="flex items-center justify-between">
              <% if highest.status == "Passed" %>
                <div class="p-3">
                  <%= link_to t('admin.courses.learn.retry'), exam_topic_path(topic), class: "inline-block bg-green-600 text-white px-3 py-2 rounded-lg hover:bg-green-700", data: { turbo_frame: "profile_content" } %>
                </div>
                <div class="px-4 py-2 text-sm text-gray-700">
                  <%= t('admin.courses.learn.status_label') %> <span class="font-semibold bg-green-500 py-1 px-2 rounded text-white"><%= highest.status %></span>
                </div>
              <% else %>
                <div class="p-3">
                  <%= link_to t('admin.courses.learn.retry'), exam_topic_path(topic), class: "inline-block bg-red-600 text-white px-3 py-2 rounded-lg hover:bg-red-700", data: { turbo_frame: "profile_content" } %>
                </div>
                <div class="px-4 py-2 text-sm text-gray-700">
                  <%= t('admin.courses.learn.status_label') %> <span class="font-semibold bg-red-500 py-1 px-2 rounded text-white"><%= highest.status %></span>
                </div>
              <% end %>
              <div class="px-4 py-2 text-sm text-gray-700">
                <%= t('admin.courses.learn.score_label') %> <strong><%= highest.score %> %</strong>
              </div>
            </div>
          <% else %>
            <div class="p-3">
              <%= link_to t('admin.courses.learn.take_exam'), exam_topic_path(topic), class: "inline-block bg-green-600 text-white px-3 py-2 rounded-lg hover:bg-green-700", data: { turbo_frame: "profile_content" } %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>