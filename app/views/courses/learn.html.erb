<%= turbo_frame_tag "profile_content" do %>
  <div class="flex flex-col lg:flex-row min-h-screen bg-surface-container" x-data="{ sidebarOpen: false, videoLoading: true, videoError: false }">
    <!-- Mobile sidebar toggle -->
    <div class="lg:hidden flex items-center justify-between bg-surface-container-high text-white px-4 py-2 border-b border-white/10">
      <span class="font-label-tech text-xs uppercase tracking-wider"><%= @current_lesson&.name %></span>
      <button @click="sidebarOpen = !sidebarOpen" class="text-slate-200 focus:outline-none">
        <svg x-show="!sidebarOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg x-show="sidebarOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="flex-1 flex flex-col min-w-0 h-fit">
      <div class="relative bg-black min-h-[280px] lg:min-h-[420px] flex items-center justify-center">
        <% if @current_lesson&.video&.attached? %>
          <video
            controls
            controlsList="nodownload"
            preload="metadata"
            oncontextmenu="return false;"
            @loadstart="videoLoading = true; videoError = false"
            @waiting="videoLoading = true"
            @stalled="videoLoading = true"
            @canplay="videoLoading = false"
            @playing="videoLoading = false"
            @error="videoLoading = false; videoError = true"
            class="w-full h-full max-h-[70vh] bg-black"
          >
            <source src="<%= url_for(@current_lesson.video) %>" type="video/mp4">
            <%= t('admin.courses.learn.no_video') %>
          </video>

          <div x-show="videoLoading" class="absolute inset-0 bg-black/70 flex flex-col items-center justify-center text-white gap-3">
            <div class="w-10 h-10 border-4 border-white/30 border-t-white rounded-full animate-spin"></div>
            <p class="text-sm font-medium"><%= t('admin.courses.learn.loading_video', default: 'Video is loading, please wait...') %></p>
          </div>

          <div x-show="videoError" class="absolute inset-0 bg-black/70 flex items-center justify-center text-white px-6 text-center">
            <p class="text-sm font-medium"><%= t('admin.courses.learn.video_load_failed', default: 'Video cannot be loaded right now. Please refresh or try again later.') %></p>
          </div>
        <% else %>
          <div class="h-[500px] flex items-center justify-center bg-black text-white">
            <%= t('admin.courses.learn.no_video') %>
          </div>
        <% end %>
      </div>
      <div class="p-6 bg-surface-container-high/50 border-t border-white/10">
        <h2 class="text-xl font-bold text-white font-headline-sm">
          <%= @current_lesson&.name %>
        </h2>
        <p class="text-slate-300 mt-2 font-body-md">
          <%= @current_lesson&.description %>
        </p>
      </div>
    </div>
    <div class="lg:w-80 bg-surface-container-high border-t border-white/10 lg:border-t-0 lg:border-l lg:border-white/10 overflow-y-auto" :class="sidebarOpen ? 'block' : 'hidden lg:block'">
      <% @topics.each do |topic| %>
        <div class="border-b border-white/10">
          <div class="p-4 bg-white/5 text-white font-semibold font-headline-sm">
            <%= topic.name %>
          </div>
          <% topic.lessons.each do |lesson| %>
            <%= link_to learn_course_path(@course, lesson_id: lesson.id),
              class: "block px-4 py-3 hover:bg-white/5 transition #{'bg-primary-fixed-dim/10 border-l-2 border-primary-fixed-dim' if lesson == @current_lesson}" do %>
              <p class="text-slate-200 font-body-md">
                ▶ <%= lesson.name %>
              </p>
            <% end %>
            <%= link_to practice_lesson_path(lesson),
              class: "block px-4 py-3 hover:bg-white/5 transition",
              data: { turbo_frame: "profile_content" } do %>
              <p class="text-slate-300 font-body-md">
                📝 <%= t('admin.courses.learn.practice_of', lesson: lesson.name) %>
                <% last_practice = @last_practice_attempts[lesson.id] %>
                <% if last_practice&.completed %>
                  <span class="ml-2 px-2 py-1 bg-emerald-500/20 border border-emerald-500/30 text-emerald-300 rounded text-[10px] font-label-tech uppercase tracking-wider"><%= t('admin.courses.learn.status.done') %></span>
                <% elsif last_practice %>
                  <span class="ml-2 px-2 py-1 bg-amber-500/20 border border-amber-500/30 text-amber-300 rounded text-[10px] font-label-tech uppercase tracking-wider"><%= t('admin.courses.learn.status.attempted') %></span>
                <% else %>
                  <span class="ml-2 px-2 py-1 bg-slate-500/20 border border-slate-500/30 text-slate-300 rounded text-[10px] font-label-tech uppercase tracking-wider"><%= t('admin.courses.learn.status.new') %></span>
                <% end %>
              </p>
            <% end %>
          <% end %>
          <% highest = @highest_attempts[topic.id] %>
          <% if highest %>
            <div class="flex flex-col gap-2 p-3 border-t border-white/10 bg-white/5">
              <% if highest.status == "Passed" %>
                <div>
                  <%= link_to t('admin.courses.learn.retry'), exam_topic_path(topic), class: "inline-flex items-center px-3 py-2 rounded-lg border border-emerald-500/30 bg-emerald-500/10 text-emerald-300 hover:bg-emerald-500/20 text-xs font-label-tech uppercase tracking-wider", data: { turbo_frame: "profile_content" } %>
                </div>
                <div class="text-sm text-slate-300 font-body-md">
                  <%= t('admin.courses.learn.status_label') %> <span class="font-semibold bg-emerald-500/20 border border-emerald-500/30 py-1 px-2 rounded text-emerald-300 text-xs"><%= highest.status %></span>
                </div>
              <% else %>
                <div>
                  <%= link_to t('admin.courses.learn.retry'), exam_topic_path(topic), class: "inline-flex items-center px-3 py-2 rounded-lg border border-red-500/30 bg-red-500/10 text-red-300 hover:bg-red-500/20 text-xs font-label-tech uppercase tracking-wider", data: { turbo_frame: "profile_content" } %>
                </div>
                <div class="text-sm text-slate-300 font-body-md">
                  <%= t('admin.courses.learn.status_label') %> <span class="font-semibold bg-red-500/20 border border-red-500/30 py-1 px-2 rounded text-red-300 text-xs"><%= highest.status %></span>
                </div>
              <% end %>
              <div class="text-sm text-slate-300 font-body-md">
                <%= t('admin.courses.learn.score_label') %> <strong><%= highest.score %> %</strong>
              </div>
            </div>
          <% else %>
            <div class="p-3 border-t border-white/10 bg-white/5">
              <%= link_to t('courses.learn.take_exam'), exam_topic_path(topic), class: "inline-flex items-center px-3 py-2 rounded-lg border border-primary-fixed-dim/30 bg-primary-fixed-dim/10 text-primary-fixed-dim hover:bg-primary-fixed-dim/20 text-xs font-label-tech uppercase tracking-wider", data: { turbo_frame: "profile_content" } %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>