<%= turbo_frame_tag "profile_content" do %>
  <div class="py-10 max-w-[1280px] mx-auto px-6">
    <div class="text-center mb-12">
      
      <h1 class="font-headline-md text-3xl xl:text-5xl font-bold tracking-tight text-on-surface"><%= t('courses.index.title') %></h1>
    </div>
    
    <div class="max-w-2xl mx-auto mb-16">
      <%= form_with url: request.path, method: :get, 
            data: { 
              turbo_frame: "profile_content", 
              turbo_action: "advance",
              controller: "search"
            }, 
            class: "flex items-center gap-3" do |f| %>
        
        <div class="relative flex-1">
          <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none">
            <span class="material-symbols-outlined text-primary-fixed-dim/60 text-lg">search</span>
          </div>
          
          <%= f.text_field :query, 
              value: params[:query], 
              placeholder: t('courses.index.search_placeholder'), 
              data: { action: "input->search#submit" },
              class: "block w-full py-3.5 pl-11 pr-4 text-sm text-on-surface bg-surface-container border border-outline-variant rounded-xl focus:border-primary-fixed-dim focus:outline-none transition shadow-sm placeholder:text-slate-text/50" %>
        </div>
        
        <%= f.submit t('courses.index.search_button'), class: "glow-button tracking-wider font-semibold text-xs uppercase rounded-xl px-6 py-3.5 cursor-pointer transition shadow-sm" %>
        
        <% if params[:query].present? %>
          <%= link_to t('missing_i18n.common.clear'), request.path, class: "text-slate-text hover:text-primary-fixed-dim px-3 py-2 text-sm font-medium whitespace-nowrap font-label-tech uppercase" %>
        <% end %>
      <% end %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-6">
      <% @courses.each do |course| %>
        <div class="glass-card p-5 rounded-2xl flex flex-col justify-between h-[480px]">
          <div class="w-full h-40 bg-surface-container rounded-lg overflow-hidden flex items-center justify-center border border-outline-variant/20 relative">
            <% if course.course_image.attached? %>
              <%= optimized_course_image_tag(
                course,
                alt: course.name,
                class_name: "w-full h-full object-cover",
                width: 400,
                height: 160,
                sizes: "(max-width: 640px) 50vw, (max-width: 1024px) 33vw, 20vw"
              ) %>
            <% else %>
              <span class="material-symbols-outlined text-outline-variant text-[44px]">library_books</span>
            <% end %>
          </div>

          <div class="flex-1 flex flex-col pt-4 gap-2">
            <div class="font-headline-sm text-base font-bold text-on-surface leading-snug line-clamp-1"><%= course.name %></div>
            <div class="text-primary-fixed-dim font-label-tech text-xs tracking-wider uppercase">#<%= course.tag %></div>
            
            <div class="flex items-center gap-2 mt-1">
              <% if course.rate != 0 %>
                <div class="relative inline-block text-outline-variant text-base tracking-wider">
                  <span>★★★★★</span>
                  <div class="absolute top-0 left-0 text-yellow-400 overflow-hidden whitespace-nowrap" 
                      style="width: <%= ((course.rate.to_f || 0) / 5.0) * 100 %>%;">
                    ★★★★★
                  </div>
                </div>
              <% else %>
                <div class="text-slate-text text-xs italic font-label-tech uppercase"><%= t('courses.index.no_reviews') %></div>
              <% end %>
            </div>

            <div class="text-slate-text text-xs leading-relaxed line-clamp-2 mt-2">
              <em><%= truncate(course.description, length: 100, separator: ' ', omission: "...") %></em>
            </div>
          </div>

          <div class="pt-4 border-t border-outline-variant/20 flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <span class="font-label-tech text-[10px] text-slate-text uppercase"><%= t('missing_i18n.courses.index.price_credit') %></span>
              <span class="font-label-tech text-sm text-primary font-bold"><%= format_vnd(course.price) %></span>
            </div>

            <div class="flex items-center justify-between gap-3 pt-1">
              <%= link_to t('admin.courses.show.view_details'), course_path(course), class: "text-primary-fixed-dim hover:text-primary hover:underline font-label-tech text-xs tracking-wider" %>

              <div class="flex items-center justify-end">
                <% if current_user&.owned_courses&.exists?(course.id) %>
                  <%= link_to t('admin.courses.show.learn_now'),
                              learn_course_path(course),
                              class: "glow-button px-3.5 py-2 text-xs rounded-lg shadow font-label-tech uppercase tracking-wider font-semibold" %>
                <% elsif current_user && course.user_id == current_user.id %>
                  <span class="text-xs text-slate-text font-label-tech"><%= t('missing_i18n.courses.index.instructor') %></span>
                <% else %>
                  <button data-controller="add-to-cart"
                          data-action="click->add-to-cart#add"
                          data-add-to-cart-course-id-value="<%= course.id %>"
                          data-add-to-cart-added-message-value="<%= t('messages.cart_items.added') %>"
                          data-add-to-cart-failed-message-value="<%= t('messages.cart_items.already_in_cart') %>"
                          data-add-to-cart-error-message-value="<%= t('messages.common.unexpected_error') %>"
                          class="glow-button px-3.5 py-2 text-xs rounded-lg shadow font-label-tech uppercase tracking-wider font-semibold cursor-pointer">
                    <%= t('admin.courses.show.add_to_cart') %>
                  </button>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="mt-12 flex justify-center py-4 text-primary-fixed-dim font-label-tech">
      <%= pagination_links(@courses) %>
    </div>
  </div>
<% end %>