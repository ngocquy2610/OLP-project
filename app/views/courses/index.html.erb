<%= turbo_frame_tag "profile_content" do %>
  <h1 class="text-2xl text-center font-bold text-gray-800 mt-5"><%= t('admin.management.courses.index.title') %></h1>
  
  <div class="max-w-2xl mx-auto mt-6 px-4">
    <%= form_with url: request.path, method: :get, 
          data: { 
            turbo_frame: "profile_content", 
            turbo_action: "advance",
            controller: "search"
          }, 
          class: "flex items-center space-x-2" do |f| %>
      
      <div class="relative flex-1">
        <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none">
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>
        
          <%= f.text_field :query, 
            value: params[:query], 
            placeholder: t('courses.index.search_placeholder'), 
            data: { action: "input->search#submit" },
            class: "block w-full p-3.5 pl-10 text-sm text-gray-900 border border-gray-300 rounded-xl bg-white focus:outline-none focus:ring-0 focus:border-blue-500 shadow-sm" %>
      </div>
      
      <%= f.submit t('courses.index.search_button'), class: "text-white bg-blue-600 hover:bg-blue-700 font-medium rounded-xl text-sm px-5 py-3.5 cursor-pointer transition shadow-sm" %>
      
      <% if params[:query].present? %>
        <%= link_to "Xóa", request.path, class: "text-gray-500 hover:text-gray-700 px-3 py-2 text-sm font-medium whitespace-nowrap" %>
      <% end %>
    <% end %>
  </div>
  <div class="flex flex-wrap gap-4 my-6 justify-center">
    <% @courses.each do |course| %>
      <div class="flex flex-col gap-3 justify-between items-center mt-6 border-1 p-4 rounded-lg bg-gray-50 text-gray-600 w-1/6 h-120">
        <div class="w-full h-32 bg-gray-100 rounded-lg overflow-hidden flex items-center justify-center">
          <% if course.course_image.attached? %>
            <%= image_tag(course.course_image, class: "w-full h-full object-cover") %>
          <% else %>
            <svg class="w-16 h-16 text-gray-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7a4 4 0 014-4h10a4 4 0 014 4v10a4 4 0 01-4 4H7a4 4 0 01-4-4V7z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 13l2.5-3 3.5 4.5L16 11l4 6H4l4-4z" />
            </svg>
          <% end %>
        </div>

        <div class="w-full flex flex-col gap-2 items-center">
          <div class="font-bold text-gray-800 text-center"><%= course.name %></div>
          <div class="text-blue-500 text-center break-words line-clamp-3 flex items-start justify-center">#<%= course.tag %></div>
          <div class="flex items-center gap-2">
            <% if course.rate != 0 %>
              <div class="relative inline-block text-gray-300 text-xl tracking-widest">
                <span>★★★★★</span>

                <div class="absolute top-0 left-0 text-yellow-400 overflow-hidden whitespace-nowrap" 
                    style="width: <%= ((course.rate.to_f || 0) / 5.0) * 100 %>%;">
                  ★★★★★
                </div>
              </div>
            <% else %>
                  <div class="text-gray-500 text-center underline"><%= t('courses.index.no_reviews') %></div>
            <% end %>

          </div>
          <div class="text-gray-500 text-center break-words line-clamp-3 h-20 flex items-start justify-center"><em><%= truncate(course.description, length: 100, separator: ' ', omission: "...") %></em></div>
        </div>

        <div class="w-full text-center">
          <div class="text-sm text-black"><%= format_vnd(course.price) %></div>
          <%= link_to t('admin.courses.show.view_details'), course_path(course), class: "text-blue-500 hover:underline" %>

          <div class="mt-2 h-12 flex items-center justify-center w-full">
            <% if current_user&.owned_courses&.exists?(course.id) %>
              <%= link_to t('admin.courses.show.learn_now'),
                          learn_course_path(course),
                          class: "bg-green-600 text-white px-4 py-2 rounded-xl" %>
            <% elsif current_user && course.user_id == current_user.id %>
              <div class="w-full h-10"></div>
            <% else %>
              <button data-controller="add-to-cart"
                      data-action="click->add-to-cart#add"
                      data-add-to-cart-course-id-value="<%= course.id %>"
                      class="w-fit bg-blue-500 text-white text-center py-2 px-4 rounded-full border-2 hover:bg-white hover:text-blue-500 hover:border-2 border-blue-500 transition">
                <%= t('admin.courses.show.add_to_cart') %>
              </button>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <div class="mt-8 flex justify-center">
    <%= pagination_links(@courses) %>
  </div>
<% end %>