<%= turbo_frame_tag "profile_content" do %>
  <div class="max-w-4xl mx-auto px-4 py-8 mb-20">
    
    <div class="flex items-center justify-between gap-4 mb-6">
      <%= link_to t('courses.show.back'), courses_path, class: "bg-gray-500 text-white border-1 border-gray-500 px-4 py-2 rounded hover:bg-white hover:text-gray-500 hover:border-1" %>
      <%= image_tag(@course.course_image, class: "w-32 h-32 object-cover rounded-lg") if @course.course_image.attached? %>
    </div>
    <h1 class="text-2xl text-center font-bold text-gray-800 mb-3"><%= @course.name %></h1>
    <div class="flex items-center gap-2">
      <div class="relative inline-block text-gray-300 text-xl tracking-widest">
        <span>★★★★★</span>

        <div class="absolute top-0 left-0 text-yellow-400 overflow-hidden whitespace-nowrap" 
            style="width: <%= ((@course.rate.to_f || 0) / 5.0) * 100 %>%;">
          ★★★★★
        </div>
      </div>
    </div>
    <p>create by: <span class="text-blue-500"><%= @teacher_name || "unknown" %></span></p>
    <div class="flex items-center gap-2">
    teacher ranking:
      <div class="relative inline-block text-gray-300 text-xl tracking-widest">
        <span>★★★★★</span>

        <div class="absolute top-0 left-0 text-yellow-400 overflow-hidden whitespace-nowrap" 
            style="width: <%= ((@teacher_rating.to_f || 0) / 5.0) * 100 %>%;">
          ★★★★★
        </div>
      </div>
    </div>
    <% @topics.each do |topic|%>
      <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
        <h2 class="text-xl font-bold mb-4"><%= topic.name %></h2>
        <p class="text-gray-700 mb-4"><%= topic.description %></p>
        <% topic.lessons.each do |lesson| %>
          <div class="bg-gray-100 rounded-lg shadow-sm p-4 mb-4">
            <h3 class="text-lg font-bold mb-2"><%= lesson.name %></h3>
            <p class="text-gray-600 mb-2"><%= lesson.description %></p>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="mb-12">
      <% if current_user&.owned_courses&.exists?(@course.id) %>
          <%= link_to t('courses.show.learn_now'),
                      learn_course_path(@course),
                      class: "bg-green-600 text-white px-4 py-2 rounded-xl inline-block" %>
      <% elsif current_user && @course.user_id == current_user.id %>
          <% else %>
        <%= button_to t('courses.show.add_to_cart'), cart_items_path(course_id: @course.id), method: :post, class: "w-fit bg-blue-500 text-white text-center py-2 px-4 rounded-full border-2 hover:bg-white hover:text-blue-500 hover:border-2 border-blue-500 transition cursor-pointer" %>
      <% end %>
    </div>

    <hr class="my-8 border-gray-200">
    <div class="bg-white rounded-lg shadow-sm p-6 border border-gray-100">
      <h2 class="text-2xl font-bold text-gray-800 mb-6">Đánh giá từ học viên</h2>

      <% if current_user&.owned_courses&.exists?(@course.id) %>
        <% user_feedback = @course.feedback_courses.find_by(user_id: current_user.id) %>
        
        <% if user_feedback %>
          <div class="mb-8 p-4 bg-blue-50 rounded-lg border border-blue-100 flex items-center justify-between">
            <div>
              <p class="text-sm font-semibold text-blue-800">Bạn đã đánh giá khóa học này.</p>
              <p class="text-sm text-blue-600">Cảm ơn bạn đã đóng góp ý kiến!</p>
            </div>
            <%= link_to "Sửa đánh giá", edit_course_feedback_course_path(@course, user_feedback), class: "bg-white text-blue-600 px-4 py-2 rounded shadow-sm border border-blue-200 hover:bg-blue-50 font-medium text-sm transition" %>
          </div>
        <% else %>
          <div class="mb-10 bg-gray-50 p-5 rounded-lg border border-gray-200">
            <h3 class="text-lg font-semibold mb-4 text-gray-800">Gửi nhận xét của bạn</h3>
            <%= form_with(model: [@course, FeedbackCourse.new], local: true, class: "space-y-4") do |f| %>
              <div>
                <%= f.label :rate, "Đánh giá sao (1-5)", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.number_field :rate, in: 1..5, value: 5, class: "block w-24 p-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500" %>
              </div>

              <div>
                <%= f.label :feedback, "Nhận xét chi tiết", class: "block text-sm font-medium text-gray-700 mb-1" %>
                <%= f.text_area :feedback, rows: 3, placeholder: "Khóa học này giúp ích gì cho bạn?...", class: "block w-full p-3 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500" %>
              </div>

              <%= f.submit "Gửi đánh giá", class: "bg-blue-600 text-white px-5 py-2 rounded-md hover:bg-blue-700 cursor-pointer font-medium transition" %>
            <% end %>
          </div>
        <% end %>
      <% end %>

      <% feedbacks = @course.feedback_courses.includes(:user).order(created_at: :desc) %>
      <% if feedbacks.any? %>
        <div class="space-y-6">
          <% feedbacks.each do |fb| %>
            <div class="pb-6 border-b border-gray-100 last:border-0 last:pb-0">
              <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-blue-100 text-blue-600 rounded-full flex items-center justify-center font-bold">
                    <%= fb.user&.fullname&.first || "U" %>
                  </div>
                  <div>
                    <h4 class="font-semibold text-gray-800"><%= fb.user&.fullname || "Học viên ẩn danh" %></h4>
                    <p class="text-xs text-gray-500"><%= time_ago_in_words(fb.created_at) %> trước</p>
                  </div>
                </div>
                <div class="text-yellow-400 text-lg tracking-widest">
                  <% fb.rate.times do %>★<% end %><% (5 - fb.rate).times do %>☆<% end %>
                </div>
              </div>
              <p class="text-gray-700 mt-3 leading-relaxed bg-gray-50 p-4 rounded-lg inline-block w-full">
                <%= fb.feedback %>
              </p>
              <%= render partial: "likes/button", locals: { feedback: fb } %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="text-center py-8 bg-gray-50 rounded-lg border border-dashed border-gray-300">
          <p class="text-gray-500">Chưa có đánh giá nào cho khóa học này. Hãy là người đầu tiên nhận xét!</p>
        </div>
      <% end %>
      
    </div>
  </div>
<% end %>