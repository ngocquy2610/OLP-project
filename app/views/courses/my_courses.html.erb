<%= turbo_frame_tag "profile_content" do %>
  <div class="max-w-6xl mx-auto px-4 py-8">
    <h2 class="text-2xl font-bold text-white font-headline-sm mb-6"><%= t('missing_i18n.courses.my_courses.title') %></h2>
    <% if @courses.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% @courses.each do |course| %>
          <div class="glass-card rounded-2xl border border-white/10 overflow-hidden">
            <% if course.course_image.attached? %>
                <%= optimized_course_image_tag(
                  course,
                  alt: course.name,
                  class_name: "w-full h-40 object-cover",
                  width: 480,
                  height: 160,
                  sizes: "(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                ) %>
            <% else %>
              <div class="w-full h-40 bg-surface-container-high flex items-center justify-center text-slate-500">
                <%= t('missing_i18n.courses.my_courses.no_image') %>
              </div>
            <% end %>
            <!-- Content -->
            <div class="p-4">
              <h3 class="font-semibold text-white mb-2">
                <%= course.name %>
              </h3>
              <p class="text-sm text-slate-300 mb-4">
                <%= truncate(course.description, length: 80) %>
              </p>
              <% if current_user.owned_courses.exists?(course.id) %>
                <%= link_to t('missing_i18n.courses.my_courses.learn_now'),
                    learn_course_path(course),
                    class: "glow-button font-label-tech text-xs uppercase tracking-wider px-4 py-2 rounded-xl inline-flex items-center",
                    data: { turbo_action: "advance" } %>
            <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center text-slate-400 border border-outline-variant/20 rounded-xl py-10 bg-surface-container-high/30">
        <%= t('missing_i18n.courses.my_courses.no_courses') %>
      </div>
    <% end %>
  </div>
<% end %>