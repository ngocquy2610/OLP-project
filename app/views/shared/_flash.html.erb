<% if flash.any? %>
  <div data-controller="flash" data-flash-duration-value="4000" class="fixed top-4 right-4 z-50 opacity-0 pointer-events-auto">
    <% flash.each do |key, msg| %>
      <div data-flash-message class="max-w-sm w-full mb-3 shadow-lg rounded-lg overflow-hidden">
        <div class="px-4 py-3 flex items-start justify-between <%= key == 'alert' ? 'bg-red-50 border border-red-200 text-red-800' : 'bg-green-50 border border-green-200 text-green-800' %>">
          <div class="mr-4">
            <p class="text-sm"><%= msg %></p>
          </div>
          <button data-action="click->flash#close" aria-label="Close" class="text-sm font-semibold ml-2">✕</button>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
