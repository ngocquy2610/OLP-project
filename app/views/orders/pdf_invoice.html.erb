<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Invoice #<%= @order.id %></title>
  <style>
    body { font-family: Helvetica, sans-serif; color: #333; line-height: 1.5; }
    .invoice-box { max-w-width: 800px; margin: auto; padding: 30px; border: 1px solid #eee; }
    .header { text-align: center; margin-bottom: 40px; }
    table { width: 100%; text-align: left; border-collapse: collapse; margin-top: 20px; }
    th, td { padding: 10px; border-bottom: 1px solid #ddd; }
    th { background-color: #f8f9fa; }
    .total { font-size: 20px; font-weight: bold; color: #4f46e5; text-align: right; }
  </style>
</head>
<body>
  <div class="invoice-box">
    <div class="header">
    <img src="data:image/png;base64,<%= Base64.encode64(File.read(Rails.root.join('app', 'assets', 'images', 'logo-image.png'))) %>" style="width: 150px; height: auto; margin-bottom: 20px;" />
      <h2><%= t('orders.pdf.title') %></h2>
      <p><%= t('orders.pdf.order_line', id: @order.id, date: @order.created_at.strftime("%B %d, %Y")) %></p>
    </div>
    <p><strong><%= t('orders.pdf.customer_label') %></strong> <%= @order.user.fullname %></p>
    <p><strong><%= t('orders.pdf.email_label') %></strong> <%= @order.user.email %></p>
    <p><strong><%= t('orders.pdf.status_label') %></strong> <%= @order.status.upcase %></p>

    <table>
      <thead>
        <tr>
          <th>Course Item</th>
          <th style="text-align: right;">Price</th>
        </tr>
      </thead>
      <tbody>
        <% subtotal = 0 %>
        <% @order.order_items.each do |item| %>
          <tr>
            <td><%= item.course.name %></td>
            <td style="text-align: right;"><%= format_vnd(item.price) %></td>
          </tr>
          <% subtotal += item.price.to_f %>
        <% end %>
      </tbody>
    </table>

    <table style="margin-top: 20px; width:100%;">
      <tr>
        <td style="text-align: right;">Subtotal:</td>
        <td style="text-align: right;"><%= format_vnd(subtotal) %></td>
      </tr>
      <tr>
        <td style="text-align: right;">Discount:</td>
        <%# show stored discount if present, otherwise compute fallback = subtotal - total %>
        <% computed_discount = (@order.discount.to_f > 0) ? @order.discount.to_f : (subtotal.to_f - @order.total.to_f).round(0) %>
        <td style="text-align: right;"><%= format_vnd(computed_discount) %></td>
      </tr>
      <tr>
        <td style="text-align: right; font-weight:bold;">Total:</td>
        <td style="text-align: right; font-weight:bold;"><%= format_vnd(@order.total) %></td>
      </tr>
    </table>
    <p style="text-align: center; margin-top: 50px; color: #777;"><%= t('orders.pdf.thanks') %></p>
  </div>
</body>
</html>