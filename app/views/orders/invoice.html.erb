<div class="max-w-3xl mx-auto mt-10 p-8 bg-white shadow-lg rounded-lg border border-gray-200">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-3xl font-bold text-gray-800"><%= t('orders.invoice.title', id: @order.id) %></h1>
    
    <%= link_to t('orders.invoice.download_pdf'), order_path(@order, format: :pdf), target: "_blank", class: "bg-indigo-600 text-white px-4 py-2 rounded shadow hover:bg-indigo-700 transition cursor-pointer" %>
  </div>

  <div class="mb-6">
    <p class="text-gray-600"><strong><%= t('orders.invoice.date_label') %></strong> <%= @order.created_at.strftime("%B %d, %Y") %></p>
    <p class="text-gray-600"><strong><%= t('orders.invoice.status_label') %></strong> <span class="text-green-600 font-bold"><%= @order.status.upcase %></span></p>
    <p class="text-gray-600"><strong><%= t('orders.invoice.customer_label') %></strong> <%= current_user.email %></p>
  </div>

  <table class="w-full text-left border-collapse">
    <thead>
      <tr class="border-b-2 border-gray-300">
        <th class="py-3 font-semibold text-gray-700"><%= t('orders.invoice.course_header') %></th>
        <th class="py-3 font-semibold text-gray-700 text-right"><%= t('orders.invoice.price_header') %></th>
      </tr>
    </thead>
    <tbody>
      <% total = 0 %>
      <% @order.order_items.each do |item| %>
        <tr class="border-b border-gray-100">
          <td class="py-3 text-gray-800"><%= item.course.name %></td>
          <td class="py-3 text-gray-800 text-right"><%= item.price %></td>
        </tr>
        <% total += item.price %>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td class="py-4 font-bold text-xl text-gray-900"><%= t('orders.invoice.total_label') %></td>
        <td class="py-4 font-bold text-xl text-indigo-600 text-right"><%= total %></td>
      </tr>
    </tfoot>
  </table>
</div>