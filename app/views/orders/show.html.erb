<%= turbo_frame_tag "profile_content" do %>
  <div class="max-w-5xl mx-auto py-10 px-4">
    <h2 class="text-2xl font-bold text-white font-headline-sm mb-6"><%= t('orders.show.title') %></h2>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- LEFT: Order Items -->
      <div class="lg:col-span-2 space-y-4">
        <% @order.order_items.each do |item| %>
          <div class="flex justify-between bg-surface-container-high/40 p-4 rounded-xl border border-white/10">
            <p class="font-medium text-white"><%= item.course.name %></p>
            <p class="font-semibold text-primary-fixed-dim">
              <%= format_vnd(item.price) %>
            </p>
          </div>
        <% end %>
      </div>
      <!-- RIGHT: Payment Summary -->
      <div class="bg-surface-container-high/40 p-6 rounded-xl border border-white/10 h-fit">
        <script>
          // Expose a global function for inline onclick handlers (module scope is isolated)
          function choosePayment(method) {
            var gmo = document.getElementById('gmo-container');
            var stripe = document.getElementById('stripe-container');
            if (gmo) gmo.style.display = (method === 'gmo') ? '' : 'none';
            if (stripe) stripe.style.display = (method === 'stripe') ? '' : 'none';
          }
        </script>
        <h3 class="font-semibold text-white mb-4"><%= t('orders.show.summary_title') %></h3>
        <div class="flex justify-between mb-2">
          <span class="text-slate-300"><%= t('orders.show.total_label') %></span>
          <span class="font-semibold text-primary-fixed-dim">
            <%= format_vnd(@order.total) %>
          </span>
        </div>
        <!-- Payment Method Chooser -->
        <div class="mt-4 flex flex-wrap gap-3">
          <label class="inline-flex items-center gap-2 text-slate-300 border border-outline-variant/40 rounded-lg px-3 py-2 bg-surface-container-high/40">
            <input type="radio" name="payment_method" value="stripe" checked onclick="choosePayment('stripe')" class="accent-primary-fixed-dim">
            <span class="font-label-tech text-xs uppercase tracking-wider"><%= t('orders.show.stripe_label') %></span>
          </label>
          <label class="inline-flex items-center gap-2 text-slate-300 border border-outline-variant/40 rounded-lg px-3 py-2 bg-surface-container-high/40">
            <input type="radio" name="payment_method" value="gmo" onclick="choosePayment('gmo')" class="accent-primary-fixed-dim">
            <span class="font-label-tech text-xs uppercase tracking-wider"><%= t('orders.show.gmo_label') %></span>
          </label>
        </div>

        <div id="stripe-container" class="mt-4">
          <%= button_to t('orders.show.pay_now'),
            checkout_order_path(@order),
            method: :post,
            data: { turbo: false },
            class: "w-full glow-button font-label-tech text-xs uppercase tracking-wider py-2.5 rounded-xl" %>
        </div>

        <div id="gmo-container" class="mt-4" style="display:none;">
          <form id="gmo-payment-form" action="<%= charge_gmo_order_path(@order) %>" method="POST" data-turbo="false">
            <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
            <!-- Only send the token to the server -->
            <input type="hidden" id="gmo_token" name="Token" value="">

            <div class="mb-2">
              <label class="block text-xs font-label-tech text-slate-400 uppercase tracking-widest mb-1"><%= t('orders.show.card_number') %>:</label>
              <input type="text" id="cardno" placeholder="4100000000000100" value="4100000000000100" inputmode="numeric" maxlength="19" autocomplete="cc-number" class="w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim">
            </div>

            <div class="mb-2">
              <label class="block text-xs font-label-tech text-slate-400 uppercase tracking-widest mb-1"><%= t('orders.show.expire_date') %>:</label>
              <input type="text" id="expire" placeholder="2812" value="2812" maxlength="6" class="w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim">
            </div>

            <div class="mb-2">
              <label class="block text-xs font-label-tech text-slate-400 uppercase tracking-widest mb-1"><%= t('orders.show.security_code') %>:</label>
              <input type="text" id="securitycode" placeholder="123" value="123" maxlength="4" autocomplete="cc-csc" class="w-full bg-surface-container-high border border-outline-variant rounded-lg px-3 py-2 text-white focus:outline-none focus:border-primary-fixed-dim">
            </div>

            <button type="button" id="pay-button" class="w-full inline-flex items-center justify-center border border-sky-400/30 bg-sky-500/10 text-sky-300 hover:bg-sky-500/20 font-label-tech text-xs uppercase tracking-wider py-2.5 rounded-xl transition"><%= t('orders.show.pay_gmo') %></button>
          </form>
        </div>

        <script>
          // Use the global `Multipayment` provided by the CDN script included in the layout.
          // This uses the callback-style API (getToken) and avoids module imports.
          window.choosePayment = function(method) {
            document.getElementById('gmo-container').style.display = (method === 'gmo') ? '' : 'none';
            document.getElementById('stripe-container').style.display = (method === 'stripe') ? '' : 'none';
          };

          const payBtn = document.getElementById('pay-button');
          if (payBtn) {
            payBtn.addEventListener('click', function () {
              const btn = this;
              btn.disabled = true;
              btn.innerText = '<%= t("orders.show.processing") %>';

              const cardData = {
                cardno: document.getElementById('cardno').value.replace(/[^0-9]/g, ''),
                expire: document.getElementById('expire').value,
                securitycode: document.getElementById('securitycode').value,
                // tokennumber and holdername are optional; tokennumber:1 returns token[0]
                tokennumber: 1
              };

              try {
                if (typeof window.Multipayment === 'undefined' || typeof window.Multipayment.getToken !== 'function') {
                  throw new Error('<%= t("orders.show.token_error_message") %>');
                }

                // Initialize (shopId is public)
                try { window.Multipayment.init('<%= ENV["GMO_SHOP_ID"].presence || "tshop00076628" %>'); } catch (e) { /* ignore if already initialized */ }

                window.Multipayment.getToken(cardData, function (response) {
                  if (!response || response.resultCode !== '000') {
                    console.error('GMO token error', response);
                    btn.disabled = false;
                    btn.innerText = '<%= j t("orders.show.pay_gmo") %>';
                    alert('<%= j t("orders.show.token_error", code: "__CODE__") %>'.replace('__CODE__', (response && response.resultCode) || 'unknown'));
                    return;
                  }

                  const tokenString = response.tokenObject && response.tokenObject.token && response.tokenObject.token[0];
                  if (!tokenString) {
                    console.error('No token in GMO response', response);
                    btn.disabled = false;
                    btn.innerText = '<%= j t("orders.show.pay_gmo") %>';
                    alert('<%= j t("orders.show.no_token") %>');
                    return;
                  }

                  document.getElementById('gmo_token').value = tokenString;
                  document.getElementById('cardno').value = '';
                  document.getElementById('expire').value = '';
                  document.getElementById('securitycode').value = '';

                  btn.innerText = '<%= j t("orders.show.redirecting") %>';
                  document.getElementById('gmo-payment-form').submit();
                });
              } catch (err) {
                console.error('GMO token error:', err);
                btn.disabled = false;
                btn.innerText = '<%= j t("orders.show.pay_gmo") %>';
                alert('<%= j t("orders.show.token_error_message") %>');
              }
            });
          }
        </script>
      </div>
    </div>
  </div>
<% end %>