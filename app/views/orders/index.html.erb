<%= turbo_frame_tag "profile_content" do %>
  <div class="payment-history-container px-2 sm:px-0">
  <h1 class="text-2xl font-bold mb-4"><%= t('orders.index.title') %></h1>

  <% if @orders.any? %>
    <div class="overflow-x-auto">
    <table class="table w-full min-w-[600px]">
      <thead>
        <tr class="flex items-center justify-between  p-4 border-y">
          <th class="w-1/4 text-left "><%= t('orders.index.table.date') %></th>
          <th class="w-1/4 text-left "><%= t('orders.index.table.course') %></th>
          <th class="w-1/4 text-left "><%= t('orders.index.table.status') %></th>
          <th class="w-1/4 text-left "><%= t('orders.index.table.invoice') %></th>
        </tr>
      </thead>
      
      <tbody>
      <hr>
        <% @orders.each do |order| %>
          <tr class="flex items-center justify-between  p-4 border-t">
            
            <td class="w-1/4 text-left"><%= order.created_at.strftime("%B %d, %Y") %></td>
            <td class="w-1/4 text-left">
              <ul>
                <% order.order_items.each do |item| %>
                  <li><%= truncate(item.course.name, length: 20) %></li>
                <% end %>
              </ul>
            </td>

            <td class="w-1/4 text-left"><span class="badge"><%= order.status.capitalize %></span></td>
            <td class="w-1/4 text-left">
              <%= link_to t('orders.index.download_invoice'), invoice_order_path(order, format: :pdf), target: "_blank", class: "bg-indigo-600 text-white px-4 py-2 rounded shadow hover:bg-indigo-700 transition cursor-pointer" %>
            </td>
          </tr>
    
        <% end %>
      </tbody>
    </table>
      </div>
  <% else %>
    <div class="empty-state">
      <p><%= t('orders.index.empty') %></p>
      <%= link_to t('orders.index.browse'), courses_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
<% end %>