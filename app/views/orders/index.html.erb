<%= turbo_frame_tag "profile_content" do %>
  <div class="payment-history-container px-2 sm:px-0">
    <h1 class="text-xl font-bold text-on-surface font-headline-sm uppercase tracking-wider mb-6 flex items-center gap-2 pb-4 border-b border-outline-variant/20">
      <span class="material-symbols-outlined text-primary">history</span>
      <span><%= t('orders.index.title') %></span>
    </h1>

    <% if @orders.any? %>
      <div class="overflow-x-auto rounded-xl border border-outline-variant/30 bg-surface-container-low/20">
        <table class="w-full text-left border-collapse min-w-[700px]">
          <thead>
            <tr class="bg-surface-container/40 border-b border-outline-variant/20">
              <th class="p-4 font-label-tech text-xs uppercase tracking-wider text-slate-text/70 font-bold"><%= t('orders.index.table.date') %></th>
              <th class="p-4 font-label-tech text-xs uppercase tracking-wider text-slate-text/70 font-bold"><%= t('orders.index.table.course') %></th>
              <th class="p-4 font-label-tech text-xs uppercase tracking-wider text-slate-text/70 font-bold"><%= t('orders.index.table.status') %></th>
              <th class="p-4 font-label-tech text-xs uppercase tracking-wider text-slate-text/70 font-bold text-right"><%= t('orders.index.table.invoice') %></th>
            </tr>
          </thead>

          <tbody class="divide-y divide-outline-variant/10 font-body-md text-sm text-slate-text">
            <% @orders.each do |order| %>
              <tr class="hover:bg-surface-container-high/10 transition-colors">
                <td class="p-4 font-semibold text-on-surface"><%= l(order.created_at.to_date, format: :long) %></td>
                <td class="p-4">
                  <ul class="space-y-1">
                    <% order.order_items.each do |item| %>
                      <li class="inline-flex items-center gap-1 bg-primary-fixed-dim/5 border border-primary-fixed-dim/15 px-2.5 py-1 rounded-lg text-xs text-primary-fixed-dim font-semibold">
                        <span class="material-symbols-outlined text-[10px]">menu_book</span>
                        <span><%= truncate(item.course.name, length: 30) %></span>
                      </li>
                    <% end %>
                  </ul>
                </td>

                <td class="p-4">
                  <% if order.status.to_s == 'completed' || order.status.to_s == 'success' || order.status.to_s == 'paid' %>
                    <span class="inline-block px-3 py-1 font-label-tech text-[10px] uppercase font-bold tracking-wider rounded-lg bg-emerald-500/10 border border-emerald-500/30 text-emerald-400">
                      <%= t("orders.statuses.#{order.status}", default: order.status.humanize) %>
                    </span>
                  <% else %>
                    <span class="inline-block px-3 py-1 font-label-tech text-[10px] uppercase font-bold tracking-wider rounded-lg bg-amber-500/10 border border-amber-500/30 text-amber-400">
                      <%= t("orders.statuses.#{order.status}", default: order.status.humanize) %>
                    </span>
                  <% end %>
                </td>
                
                <td class="p-4 text-right">
                  <%= link_to invoice_order_path(order, format: :pdf), target: "_blank", class: "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-primary/20 hover:border-primary-fixed-dim bg-primary-fixed-dim/5 hover:bg-primary-fixed-dim/15 text-primary-fixed-dim text-[10px] font-label-tech uppercase tracking-wider font-bold transition-all" do %>
                    <span class="material-symbols-outlined text-sm">download_for_offline</span>
                    <span><%= t('orders.index.download_invoice') %></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="glass-card p-10 rounded-2xl border border-outline-variant/20 flex flex-col items-center justify-center text-center space-y-4">
        <span class="material-symbols-outlined text-outline text-5xl">receipt_long</span>
        <div>
          <h2 class="text-on-surface font-bold text-base font-headline-sm uppercase tracking-wide"><%= t('missing_i18n.orders.index.no_transactions') %></h2>
          <p class="text-xs text-slate-text mt-1"><%= t('orders.index.empty') %></p>
        </div>
        <%= link_to t('orders.index.browse'), courses_path, class: "glow-button font-bold text-xs uppercase tracking-wider px-6 py-3 rounded-xl cursor-pointer" %>
      </div>
    <% end %>
  </div>
<% end %>