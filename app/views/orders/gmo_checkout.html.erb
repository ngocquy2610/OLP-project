<div class="checkout-container">
  <h2>Thanh toán Token V2 (Importmap)</h2>
  
  <form id="gmo-payment-form" action="<%= charge_gmo_order_path(@order || 1) %>" method="POST">
    <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
    
    <input type="hidden" id="gmo_token" name="gmo_token" value="">

    <div style="margin-bottom: 15px;">
      <label>Số thẻ:</label><br>
      <input type="text" id="cardno" placeholder="4111 1111 1111 1111" value="4111111111111111">
    </div>
    
    <div style="margin-bottom: 15px;">
      <label>Ngày hết hạn:</label><br>
      <input type="text" id="expire" placeholder="202812" value="202812">
    </div>
    
    <div style="margin-bottom: 15px;">
      <label>CVC:</label><br>
      <input type="text" id="securitycode" placeholder="123" value="123">
    </div>

    <button type="button" id="pay-button">Thanh Toán V2</button>
  </form>
</div>

<script type="module">
  // Lấy thư viện xịn từ Importmap của máy bạn (không bị 404 nữa)
  import { Token } from "@mul-pay/mptoken-js"; 

  document.getElementById('pay-button').addEventListener('click', function() {
    var btn = this;
    btn.disabled = true;
    btn.innerText = "Đang mã hóa...";

    var cardData = {
      cardno: document.getElementById('cardno').value.replace(/[\s-]/g, ''),
      expire: document.getElementById('expire').value,
      securitycode: document.getElementById('securitycode').value
    };

    // Khởi tạo V2 với URL của cụm pt01
    var gmoToken = new Token('<%= ENV["GMO_SHOP_ID"] %>', 'https://pt01.mul-pay.jp');

    gmoToken.createToken(cardData).then(function(response) {
      if (response.resultCode === "000") {
        document.getElementById('gmo_token').value = response.tokenObject.token[0];
        document.getElementById('cardno').value = "";
        document.getElementById('expire').value = "";
        document.getElementById('securitycode').value = "";
        
        btn.innerText = "Đang chuyển đi...";
        document.getElementById('gmo-payment-form').submit();
      } else {
        btn.disabled = false;
        btn.innerText = "Thanh Toán V2";
        alert("Thẻ bị từ chối: " + response.resultCode);
      }
    }).catch(function(error) {
       btn.disabled = false;
       btn.innerText = "Thanh Toán V2";
       alert("Lỗi server GMO. Bật F12 xem chi tiết.");
       console.error(error);
    });
  });
</script>