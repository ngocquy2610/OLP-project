<div class="flex bg-gray-50">
  <div class="w-64 bg-white border-r shadow-sm flex-shrink-0">
    <div class="p-6 border-b">
      <h2 class="font-bold text-gray-800 text-lg"><%= t('profiles.sidebar.title') %></h2>
    </div>
    <nav class="p-4 space-y-2">
      <%= link_to profile_path, 
          class: "block px-4 py-2 rounded-lg text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition" do %>
        <%= t('profiles.information') %>
      <% end %>
      <% if current_user.student? %>
        <div class="pt-4 mt-4 border-t border-gray-100">
          <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-wider"><%= t('profiles.sidebar.student_panel') %></p>
          <%= link_to my_courses_courses_path, class: "block px-4 py-2 mt-2 rounded-lg text-gray-700 hover:bg-green-50 hover:text-green-600 transition", data: { turbo_frame: "profile_content"} do %>
            <%= t('profiles.sidebar.purchased_courses') %>
          <% end %>
          <%= link_to orders_path, class: "block px-4 py-2 mt-2 rounded-lg text-gray-700 hover:bg-green-50 hover:text-green-600 transition", data: { turbo_frame: "profile_content"} do %>
            <%= t('profiles.sidebar.payment_history') %>
          <% end %>
        </div>
      <% end %>
      <% if current_user.teacher? %>
        <div class="pt-4 mt-4 border-t border-gray-100">
          <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-wider"><%= t('profiles.sidebar.teacher_panel') %></p>
          <%= link_to management_courses_path(id: @user.id), class: "block px-4 py-2 mt-2 rounded-lg text-gray-700 hover:bg-green-50 hover:text-green-600 transition", data: { turbo_frame: "profile_content" } do %>
            <%= t('profiles.sidebar.manage_courses') %>
          <% end %>
          <%= link_to management_topics_path(id: @user.id), class: "block px-4 py-2 mt-2 rounded-lg text-gray-700 hover:bg-green-50 hover:text-green-600 transition", data: { turbo_frame: "profile_content" } do %>
            <%= t('profiles.sidebar.manage_topics') %>
          <% end %>
          <%= link_to management_lessons_path(id: @user.id), class: "block px-4 py-2 mt-2 rounded-lg text-gray-700 hover:bg-green-50 hover:text-green-600 transition", data: { turbo_frame: "profile_content" } do %>
            <%= t('profiles.sidebar.manage_lessons') %>
          <% end %>
          <%= link_to management_exams_path(id: @user.id), class: "block px-4 py-2 mt-2 rounded-lg text-gray-700 hover:bg-green-50 hover:text-green-600 transition", data: { turbo_frame: "profile_content" } do %>
            <%= t('profiles.sidebar.manage_exams') %>
          <% end %>
          <%= link_to management_practices_path(id: @user.id), class: "block px-4 py-2 mt-2 rounded-lg text-gray-700 hover:bg-green-50 hover:text-green-600 transition", data: { turbo_frame: "profile_content" } do %>
            <%= t('profiles.sidebar.manage_practices') %>
          <% end %>
        </div>
        <div class="pt-4 mt-4 border-t border-gray-100">
          <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-wider"><%= t('profiles.sidebar.user_panel') %></p>
          <%= link_to my_courses_courses_path, class: "block px-4 py-2 mt-2 rounded-lg text-gray-700 hover:bg-green-50 hover:text-green-600 transition", data: { turbo_frame: "profile_content"} do %>
            <%= t('profiles.sidebar.purchased_courses') %>
          <% end %>
          <%= link_to teacher_dashboard_path, class: "block px-4 py-2 mt-2 rounded-lg text-gray-700 hover:bg-green-50 hover:text-green-600 transition", data: { turbo_frame: "profile_content"} do %>
            <%= t('profiles.sidebar.manage_income') %>
          <% end %>
        </div>
      <% end %>
      <% if current_user.admin? %>
        <div class="pt-4 mt-4 border-t border-gray-100">
          <p class="px-4 text-xs font-semibold text-gray-400 uppercase tracking-wider"><%= t('profiles.sidebar.admin_panel') %></p>
          <%= link_to admin_dashboard_path, class: "block px-4 py-2 mt-2 rounded-lg text-gray-700 hover:bg-red-50 hover:text-red-600 transition", data: { turbo_frame: "profile_content"} do %>
            <%= t('profiles.sidebar.admin_dashboard') %>
          <% end %>
          <%= link_to admin_management_path, class: "block px-4 py-2 mt-2 rounded-lg text-gray-700 hover:bg-red-50 hover:text-red-600 transition", data: { turbo_frame: "profile_content"} do %>
            <%= t('profiles.sidebar.user_management') %>
          <% end %>
        </div>
      <% end %>
    </nav>
  </div>
  <div class="flex-1 p-8">
    <div class="bg-white rounded-xl shadow-sm border p-6 min-h-[400px]">
      <%= turbo_frame_tag "profile_content" do %>
        <%= render "profiles/role_details/#{@user.role}" %>
      <% end %>
    </div>
  </div>
</div>
