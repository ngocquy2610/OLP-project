<div class="max-w-2xl mx-auto rounded-2xl overflow-hidden mt-6">
  <h1 class="text-xl font-bold text-on-surface font-headline-sm uppercase tracking-wider mb-6 flex items-center gap-2 pb-4 border-b border-outline-variant/20">
    <span class="material-symbols-outlined text-primary">edit_square</span>
    <span><%= t('profiles.edit.title') %></span>
  </h1>

  <%= form_with(model: @user, url: profile_path, method: :patch, class: "space-y-6", local: true, data: { turbo: false }) do |f| %>
    <% if @user.errors.any? %>
      <div class="rounded-xl border border-red-500/20 bg-red-500/5 px-5 py-4 text-xs text-red-400">
        <p class="font-bold mb-1 uppercase font-label-tech tracking-wider"><%= t('missing_i18n.profiles.fix_errors') %></p>
        <ul class="list-disc pl-5 space-y-1 font-body-md">
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-4">
      <div>
        <%= f.label :fullname, t('profiles.form.fullname'), class: "block mb-2 font-label-tech text-xs uppercase tracking-wider text-slate-text" %>
        <%= f.text_field :fullname, class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary/30 transition-all font-body-md" %>
      </div>

      <div>
        <%= f.label :phone, t('profiles.form.phone'), class: "block mb-2 font-label-tech text-xs uppercase tracking-wider text-slate-text" %>
        <%= f.text_field :phone, maxlength: 11, inputmode: "numeric", pattern: "\\d{10,11}", class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary/30 transition-all font-body-md" %>
        <span class="block mt-1 text-[10px] text-slate-text/50 font-label-tech tracking-wider uppercase"><%= t('missing_i18n.profiles.phone_hint') %></span>
        <% if @user.errors[:phone].any? %>
          <p class="mt-1 text-xs text-red-400 font-semibold"><%= @user.errors.full_messages_for(:phone).join(', ') %></p>
        <% end %>
      </div>

      <div>
        <%= f.label :address, t('profiles.form.address'), class: "block mb-2 font-label-tech text-xs uppercase tracking-wider text-slate-text" %>
        <%= f.text_area :address, rows: 3, class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary/30 transition-all font-body-md resize-none" %>
      </div>
    </div>

    <% if @user.role == 'teacher' %>
      <div class="mt-8 bg-surface-container-low/30 border border-outline-variant/20 p-6 rounded-2xl space-y-4">
        <h2 class="text-sm font-bold text-primary-fixed-dim font-headline-sm uppercase tracking-wide flex items-center gap-2 mb-2">
          <span class="material-symbols-outlined text-base">account_balance</span>
          <span><%= t('profiles.form.bank_section_title') %></span>
        </h2>

        <div>
          <%= f.label :bank_name, t('profiles.form.bank_name'), class: "block mb-2 font-label-tech text-xs uppercase tracking-wider text-slate-text/70" %>
          <%= f.text_field :bank_name, class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none" %>
        </div>

        <div>
          <%= f.label :bank_account_number, t('profiles.form.bank_account_number'), class: "block mb-2 font-label-tech text-xs uppercase tracking-wider text-slate-text/70" %>
          <%= f.text_field :bank_account_number, class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none" %>
        </div>

        <div>
          <%= f.label :bank_account_name, t('profiles.form.bank_account_name'), class: "block mb-2 font-label-tech text-xs uppercase tracking-wider text-slate-text/70" %>
          <%= f.text_field :bank_account_name, class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none" %>
        </div>

        <div>
          <%= f.label :stripe_account_id, t('profiles.form.stripe_account_id'), class: "block mb-2 font-label-tech text-xs uppercase tracking-wider text-slate-text/70" %>
          <div class="relative flex items-center">
            <%= f.password_field :stripe_account_id, value: @user.stripe_account_id, id: "stripe_account_id_field", class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 pr-20 text-sm focus:outline-none focus:ring-1 focus:ring-primary/30 transition-all font-mono" %>
            <button type="button" id="toggle_stripe_key" class="absolute right-3 bg-surface-container-high hover:bg-surface-container-highest border border-outline-variant/40 px-3 py-1 rounded-lg text-[10px] font-bold text-slate-text uppercase font-label-tech tracking-wider select-none transition-all"><%= t('missing_i18n.common.show') %></button>
          </div>
        </div>
      </div>
    <% end %>

    <div class="flex items-center space-x-4 pt-6 border-t border-outline-variant/20">
      <%= link_to t('profiles.edit.cancel'), profile_path, class: "text-slate-text hover:text-red-400 font-bold font-label-tech uppercase tracking-wider text-xs px-4 py-2 transition" %>
      <%= f.submit t('profiles.edit.save'), class: "glow-button font-bold text-xs uppercase tracking-wider px-8 py-3.5 rounded-xl cursor-pointer shadow-[0_0_15px_rgba(0,229,255,0.15)]" %>
    </div>
  <% end %>

  <div class="mt-12 p-6 border-t border-red-500/20 bg-red-500/5 rounded-2xl">
    <h3 class="text-red-400 font-bold text-xs uppercase font-label-tech tracking-wider flex items-center gap-1.5 mb-1">
      <span class="material-symbols-outlined text-sm">warning</span>
      <span><%= t('profiles.edit.danger_title') %></span>
    </h3>
    <p class="text-xs text-slate-text/80 mb-4 font-body-md"><%= t('profiles.edit.danger_text') %></p>
    <%= button_to t('profiles.edit.delete_account'), registration_path(:user), 
    data: { confirm: t('profiles.edit.delete_confirm'), turbo_confirm: t('profiles.edit.delete_confirm') },
    method: :delete, 
    class: "inline-block bg-red-500/10 border border-red-500/30 text-red-400 px-5 py-2.5 rounded-xl text-xs font-label-tech hover:bg-red-500/20 transition-all uppercase tracking-wider font-bold cursor-pointer" %>
  </div>
</div>

<script>
  (function () {
    var btn = document.getElementById('toggle_stripe_key');
    var input = document.getElementById('stripe_account_id_field');
    if (!btn || !input) return;
    btn.addEventListener('click', function () {
      if (input.type === 'password') {
        input.type = 'text';
        btn.textContent = '<%= j(t('missing_i18n.common.hide')) %>';
      } else {
        input.type = 'password';
        btn.textContent = '<%= j(t('missing_i18n.common.show')) %>';
      }
    });
  })();
</script>
