<div class="max-w-2xl mx-auto mt-10 p-8 bg-white shadow-lg rounded-xl border border-gray-100">
  <h1 class="text-2xl font-bold text-gray-800 mb-6"><%= t('profiles.edit.title') %></h1>
  <%= form_with(model: @user, url: profile_path, method: :patch, class: "space-y-6", local: true, data: { turbo: false }) do |f| %>
    <div>
      <%= f.label :fullname, t('profiles.form.fullname'), class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :fullname, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2 border" %>
    </div>
    <div>
      <%= f.label :phone, t('profiles.form.phone'), class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_field :phone, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2 border" %>
    </div>
    <div>
      <%= f.label :address, t('profiles.form.address'), class: "block text-sm font-medium text-gray-700" %>
      <%= f.text_area :address, rows: 3, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2 border" %>
    </div>
    <% if @user.role == 'teacher' %>
      <div class="mt-6 bg-gray-50 p-6 rounded-md border border-gray-100">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Thông tin nhận thanh toán</h2>

        <div>
          <%= f.label :bank_name, t('profiles.form.bank_name', default: 'Tên ngân hàng'), class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :bank_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2 border" %>
        </div>

        <div class="mt-4">
          <%= f.label :bank_account_number, t('profiles.form.bank_account_number', default: 'Số tài khoản'), class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :bank_account_number, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2 border" %>
        </div>

        <div class="mt-4">
          <%= f.label :bank_account_name, t('profiles.form.bank_account_name', default: 'Tên chủ tài khoản'), class: "block text-sm font-medium text-gray-700" %>
          <%= f.text_field :bank_account_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2 border" %>
        </div>
        <div class="mt-4">
          <%= f.label :stripe_account_id, t('profiles.form.stripe_account_id', default: 'Stripe Account ID'), class: "block text-sm font-medium text-gray-700" %>
          <div class="relative">
            <%= f.password_field :stripe_account_id, value: @user.stripe_account_id, id: "stripe_account_id_field", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 p-2 border pr-20" %>
            <button type="button" id="toggle_stripe_key" class="absolute right-2 top-2 text-sm text-gray-600 bg-white px-2 py-1 rounded">Show</button>
          </div>
        </div>
      </div>
    <% end %>
    <div class="flex items-center space-x-4">
      <%= f.submit t('profiles.edit.save'), class: "bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 cursor-pointer transition" %>
      <%= link_to t('profiles.edit.cancel'), profile_path, class: "text-gray-500 hover:text-gray-700" %>
    </div>
  <% end %>
  <div class="mt-10 p-4 border-t border-red-100">
    <h3 class="text-red-600 font-bold"><%= t('profiles.edit.danger_title') %></h3>
    <p class="text-sm text-gray-500 mb-4"><%= t('profiles.edit.danger_text') %></p>
    <%= button_to t('profiles.edit.delete_account'), registration_path(:user), 
    data: { confirm: t('profiles.edit.delete_confirm'), turbo_confirm: t('profiles.edit.delete_confirm') },
    method: :delete, 
    class: "bg-red-50 text-red-600 px-4 py-2 rounded border border-red-200 hover:bg-red-600 hover:text-white transition" %>
  </div>
</div>
<script>
  (function () {
    var btn = document.getElementById('toggle_stripe_key');
    var input = document.getElementById('stripe_account_id_field');
    if (!btn || !input) return;
    btn.addEventListener('click', function () {
      if (input.type === 'password') {
        input.type = 'text';
        btn.textContent = 'Hide';
      } else {
        input.type = 'password';
        btn.textContent = 'Show';
      }
    });
  })();
</script>
