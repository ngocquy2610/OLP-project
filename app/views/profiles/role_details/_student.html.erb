<div class="max-w-2xl mx-auto rounded-2xl overflow-hidden mt-6">
  <div>
    <h2 class="text-xl font-bold text-on-surface font-headline-sm uppercase tracking-wider mb-6 flex items-center gap-2 pb-4 border-b border-outline-variant/20">
      <span class="material-symbols-outlined text-primary">account_circle</span>
      <span><%= t('profiles.student.title') %></span>
    </h2>
    <div class="space-y-4 font-body-md text-sm text-slate-text">
      <div class="flex items-center justify-between border-b border-outline-variant/10 pb-3">
        <span class="font-semibold text-slate-text/70 w-32"><%= t('profiles.student.fullname') %></span>
        <span class="text-on-surface font-semibold"><%= @user.fullname.presence || t('profiles.not_updated', default: 'Chưa cập nhật') %></span>
      </div>
      <div class="flex items-center justify-between border-b border-outline-variant/10 pb-3">
        <span class="font-semibold text-slate-text/70 w-32"><%= t('profiles.student.phone') %></span>
        <span class="text-on-surface font-semibold"><%= @user.phone.presence || t('profiles.not_updated', default: 'Chưa cập nhật') %></span>
      </div>
      <div class="flex items-center justify-between border-b border-outline-variant/10 pb-3">
        <span class="font-semibold text-slate-text/70 w-32"><%= t('profiles.student.address') %></span>
        <span class="text-on-surface font-semibold"><%= @user.address.presence || t('profiles.not_updated', default: 'Chưa cập nhật') %></span>
      </div>
      <div class="flex items-center justify-between border-b border-outline-variant/10 pb-3">
        <span class="font-semibold text-slate-text/70 w-32"><%= t('profiles.student.email') %></span>
        <span class="text-on-surface font-semibold select-all"><%= @user.email %></span>
      </div>
      <div class="flex items-center justify-between pb-3">
        <span class="font-semibold text-slate-text/70 w-32"><%= t('profiles.student.role') %></span>
        <span class="inline-block px-3 py-1 font-label-tech bg-primary-fixed-dim/10 border border-primary-fixed-dim/25 text-primary-fixed-dim text-[10px] rounded-full uppercase tracking-wider font-bold">
          <%= @user.role %>
        </span>
      </div>
    </div>
    <div class="mt-8 flex flex-wrap gap-4 pt-6 border-t border-outline-variant/20">
      <%= link_to edit_user_registration_path, 
          class: "flex items-center gap-1.5 px-5 py-3 rounded-xl border border-outline-variant/30 hover:border-primary-fixed-dim/50 text-slate-text hover:text-primary-fixed-dim transition font-bold text-xs uppercase tracking-wider font-label-tech",
          data: { turbo_frame: "profile_content" } do %>
        <span class="material-symbols-outlined text-sm">key</span>
        <span><%= t('devise.registrations.edit_title') %></span>
      <% end %>
      <%= link_to edit_profile_path, 
          class: "glow-button font-bold text-xs uppercase tracking-wider px-6 py-3 rounded-xl cursor-pointer shadow-[0_0_15px_rgba(0,229,255,0.1)]",
          data: { turbo_frame: "profile_content" } do %>
        <%= t('profiles.edit_label') %>
      <% end %>
    </div>
  </div>
</div>