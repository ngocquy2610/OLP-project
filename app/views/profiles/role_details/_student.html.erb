<div class="max-w-2xl mx-auto bg-white shadow-md rounded-lg overflow-hidden mt-10 border border-gray-200">
  <div class="p-6">
    <h2 class="text-2xl font-bold text-gray-800 mb-4"><%= t('profiles.student.title') %></h2>
    <div class="space-y-3">
      <div class="flex border-b pb-2">
        <span class="font-semibold w-32"><%= t('profiles.student.fullname') %></span>
        <span class="text-gray-600"><%= @user.fullname.presence || t('profiles.not_updated', default: 'Not updated') %></span>
      </div>
      <div class="flex border-b pb-2">
        <span class="font-semibold w-32"><%= t('profiles.student.phone') %></span>
        <span class="text-gray-600"><%= @user.phone.presence || t('profiles.not_updated', default: 'Not updated') %></span>
      </div>
      <div class="flex border-b pb-2">
        <span class="font-semibold w-32"><%= t('profiles.student.address') %></span>
        <span class="text-gray-600"><%= @user.address.presence || t('profiles.not_updated', default: 'Not updated') %></span>
      </div>
      <div class="flex border-b pb-2">
        <span class="font-semibold w-32"><%= t('profiles.student.email') %></span>
        <span class="text-gray-600"><%= @user.email %></span>
      </div>
      <div class="flex">
        <span class="font-semibold w-32"><%= t('profiles.student.role') %></span>
        <span class="px-2 py-1 bg-blue-100 text-blue-800 text-xs rounded-full uppercase">
          <%= @user.role %>
        </span>
      </div>
    </div>
    <div class="mt-8">
      <%= link_to t('devise.registrations.edit_title'), edit_user_registration_path, 
          class: "bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-6 rounded-lg transition",
          data: { turbo_frame: "profile_content" } %>
      <%= link_to t('profiles.edit_label'), edit_profile_path, 
          class: "bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-6 rounded-lg transition",
          data: { turbo_frame: "profile_content" } %>
    </div>
  </div>
</div>