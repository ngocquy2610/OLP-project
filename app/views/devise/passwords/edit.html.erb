<div class="mx-auto my-16 max-w-xl relative group pb-24 px-4">
  <div class="absolute -inset-1 bg-gradient-to-r from-primary-fixed-dim/40 via-primary-fixed-dim/10 to-primary/40 rounded-2xl blur opacity-15 group-hover:opacity-25 transition duration-1000"></div>
  <div class="relative glass-card rounded-2xl border border-outline-variant/30 p-8 shadow-2xl">
    
    <div class="flex items-center gap-3 mb-6 pb-6 border-b border-outline-variant/20">
      <span class="material-symbols-outlined text-primary text-3xl">lock_reset</span>
      <h2 class="text-lg font-bold text-on-surface font-headline-sm uppercase tracking-wide">
        <%= t('devise.passwords.reset_title') %>
      </h2>
    </div>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, data: { turbo: false } }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="field mb-5">
        <div class="flex items-center justify-between mb-2">
          <%= f.label :password, t('devise.passwords.new_password_label'), class: "font-label-tech text-xs uppercase tracking-wider text-slate-text" %>
          <% if @minimum_password_length %>
            <span class="text-slate-text/50 text-[10px] uppercase font-label-tech tracking-wider"><%= t('missing_i18n.devise.min_chars', count: @minimum_password_length) %></span>
          <% end %>
        </div>
        <%= f.password_field :password, autofocus: false, autocomplete: "new-password", class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary/30 transition-all font-body-md" %>
      </div>

      <div class="field mb-6">
        <%= f.label :password_confirmation, t('devise.passwords.password_confirmation'), class: "block mb-2 font-label-tech text-xs uppercase tracking-wider text-slate-text" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary/30 transition-all font-body-md" %>
      </div>

      <div class="actions">
        <%= f.submit t('devise.passwords.submit_reset'), class: "w-full glow-button font-bold text-xs uppercase tracking-wider py-3.5 rounded-xl cursor-pointer shadow-[0_0_15px_rgba(0,229,255,0.15)]" %>
      </div>
    <% end %>
  </div>
</div>