<p><%= t('missing_i18n.devise_mailer.greeting', email: @email) %></p>

<% if @resource.try(:unconfirmed_email?) %>
  <p><%= t('missing_i18n.devise_mailer.email_changing_to', email: @resource.unconfirmed_email) %></p>
<% else %>
  <p><%= t('missing_i18n.devise_mailer.email_changed_to', email: @resource.email) %></p>
<% end %>
