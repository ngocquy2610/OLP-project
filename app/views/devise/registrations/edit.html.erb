<%= turbo_frame_tag "profile_content" do %>
  <div class="mx-auto mt-10 w-full max-w-2xl border p-6 sm:p-10 rounded-lg shadow-lg shadow-gray-400">
    <div class="mt-5 text-xl sm:text-[24px] text-[#74787f] font-bold"><%= t('devise.registrations.edit_title', default: 'Change password') %> - <em><%= current_user.fullname %></em></div>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, data: { turbo: false } }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div class="field my-5">
        <p class="mb-2"><%= f.label :email, t('devise.registrations.email_label'), class: "text-xl sm:text-[24px] text-[#74787f]" %></p>
        <p><%= f.email_field :email, readonly: true, autocomplete: "email", class: "text-[18px] border-1 border-[#dfe2e6] rounded-full px-5 w-full py-2 bg-[#9b9fa5]" %></p>
      </div>
      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
          <div><%= t('devise.registrations.pending_reconfirmation', email: resource.unconfirmed_email) %></div>
      <% end %>
      <div class="field my-5">
        <p class="mb-2"><%= f.label :current_password, t('devise.registrations.current_password_label', default: 'Current password'), class: "text-xl sm:text-[24px] text-[#74787f]" %> <br>
          <i>(<%= t('devise.registrations.current_password_help', default: 'We need your current password to confirm changes') %>)</i></p>
        <p><%= f.password_field :current_password, autocomplete: "new-password", class: "text-[18px] border-1 border-[#dfe2e6] rounded-full px-5 w-full py-2" %></p>
      </div>
      <div class="field my-5">
        <p class="mb-2"><%= f.label :password, t('devise.passwords.new_password_label'), class: "text-xl sm:text-[24px] text-[#74787f]" %></p>
        <% if @minimum_password_length %>
          <p class="mb-2"><em>(<%= t('devise.passwords.minimum_length', count: @minimum_password_length) %>)</em></p>
        <% end %>
        <p><%= f.password_field :password, autocomplete: "new-password", class: "text-[18px] border-1 border-[#dfe2e6] rounded-full px-5 w-full py-2" %></p>
      </div>
      <div class="field my-5">
        <p class="mb-2"><%= f.label :password_confirmation, t('devise.passwords.password_confirmation'), class: "text-xl sm:text-[24px] text-[#74787f]" %></p>
        <p><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "text-[18px] border-1 border-[#dfe2e6] rounded-full px-5 w-full py-2" %></p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 sm:gap-5 justify-center">
        <div class="actions">
          <%= f.submit t('devise.registrations.confirm_button', default: 'Confirm'), class: "bg-green-400 border-1 border-green-400 w-fit py-2 px-5 rounded-full text-black hover:bg-white hover:text-black hover:border-1 transition cursor-pointer" %>
        </div>
        <%= link_to t('devise.links.back', default: 'Back'), :back, class: "bg-gray-500 text-white border-1 border-gray-500 px-4 py-2 rounded-full hover:bg-white hover:text-gray-500 hover:border-1" %>
      </div>

    <% end %>
  </div>
<% end %>