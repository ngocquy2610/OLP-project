<div class="mx-auto mt-10 flex max-w-7xl flex-col gap-10 px-4 lg:flex-row lg:justify-between">
  <div class="w-full lg:w-1/3">
    <p class="text-[#4F8929] text-3xl sm:text-4xl lg:text-5xl font-bold text-center"><%= t('devise.brand.line1') %></p>
    <p class="text-[#4F8929] text-3xl sm:text-4xl lg:text-5xl font-bold text-center mb-7"><%= t('devise.brand.line2') %></p>
    <div><%= image_tag "login-image.png" ,class: "w-full rounded-2xl shadow-lg shadow-black" %></div>
  </div>
  <div class="w-full lg:w-3/5 rounded-2xl border border-gray-200 bg-white p-5 sm:p-6 shadow-lg shadow-gray-300/60">
    <div class="text-[#1877F2] text-2xl sm:text-3xl text-center font-bold border-b-2 border-[#1877F2] p-4 sm:p-6 w-full"><%= t('devise.registrations.title') %></div>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { data: { controller: "policy-modal" } }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div class="flex flex-col lg:flex-row justify-between gap-6 lg:gap-10">
        <div class="w-full lg:w-1/2">
          <div class="field my-5">
            <p class="mb-2"><%= f.label :email, t('devise.registrations.email_label'), class: "text-xl sm:text-2xl text-[#74787f]" %></p>
            <p><%= f.email_field :email, autofocus: false, autocomplete: "email", class: "text-[18px] border-1 border-[#dfe2e6] rounded-full px-5 w-full py-2" %></p>
          </div>
          <div class="field my-5">
            <p><%= f.label :password, t('devise.registrations.password_label'), class: "text-xl sm:text-2xl text-[#74787f]" %></p>
            <% if @minimum_password_length %>
              <p class="mb-2"><em>(<%= t('devise.passwords.minimum_length', default: "Minimum %{count} characters") %>)</em></p>
            <% end %>
            <p><%= f.password_field :password, autocomplete: "new-password", class: "text-[18px] border-1 border-[#dfe2e6] rounded-full px-5 w-full py-2" %></p>
          </div>
          <div class="field my-5">
            <p class="mb-2"><%= f.label :password_confirmation, t('devise.registrations.password_confirmation'), class: "text-xl sm:text-2xl text-[#74787f]" %></p>
            <p><%= f.password_field :password_confirmation, autocomplete: "new-password", class: "text-[18px] border-1 border-[#dfe2e6] rounded-full px-5 w-full py-2" %></p>
          </div>
        </div>
        <div class="w-full lg:w-1/2">
          <div class="field my-5">
            <p class="mb-2"><%= f.label :fullname, t('devise.registrations.fullname'), class: "text-xl sm:text-2xl text-[#74787f]" %></p>
            <p><%= f.text_field :fullname, class: "text-[18px] border-1 border-[#dfe2e6] rounded-full px-5 w-full py-2" %></p>
          </div>
          <div class="field my-5">
            <p class="mb-2"><%= f.label :phone, t('devise.registrations.phone'), class: "text-xl sm:text-2xl text-[#74787f]" %></p>
            <p><%= f.text_field :phone, class: "text-[18px] border-1 border-[#dfe2e6] rounded-full px-5 w-full py-2" %></p>
          </div>
          <div class="field my-5">
            <p class="mb-2"><%= f.label :address, t('devise.registrations.address'), class: "text-xl sm:text-2xl text-[#74787f]" %></p>
            <p><%= f.text_area :address, rows: 3, class: "text-[18px] border-1 border-[#dfe2e6] rounded-3xl px-5 w-full py-3" %></p>
          </div>
          <div class="field my-5">
            <p class="mb-2"><%= f.label :role, t('devise.registrations.role'), class: "text-xl sm:text-2xl text-[#74787f]" %></p>
            <%= f.select :role, 
              [[t('devise.registrations.role_options.student'), 'student'], [t('devise.registrations.role_options.teacher'), 'teacher']], 
              {}, 
              class: "text-[18px] border-1 border-[#dfe2e6] rounded-full px-5 w-full py-2" %>
          </div>
          <div id="bank-details" class="hidden mt-6  p-6">
            <h3 class="text-lg font-bold text-gray-800 mb-4">Thông tin nhận thanh toán (Dành cho Giáo viên)</h3>

            <div class="space-y-4">
              <div class="field my-5">
                <p class="mb-2"><%= f.label :bank_name, "Tên ngân hàng (VD: Vietcombank, MB Bank)", class: "text-xl sm:text-2xl text-[#74787f]" %></p>
                <p><%= f.text_field :bank_name, class: "text-[18px] border-1 border-[#dfe2e6] rounded-full px-5 w-full py-2" %></p>
              </div>

              <div class="field my-5">
                <p class="mb-2"><%= f.label :bank_account_number, "Số tài khoản", class: "text-xl sm:text-2xl text-[#74787f]" %></p>
                <p><%= f.text_field :bank_account_number, class: "text-[18px] border-1 border-[#dfe2e6] rounded-full px-5 w-full py-2" %></p>
              </div>

              <div class="field my-5">
                <p class="mb-2"><%= f.label :bank_account_name, "Tên chủ tài khoản (Viết hoa không dấu)", class: "text-xl sm:text-2xl text-[#74787f]" %></p>
                <p><%= f.text_field :bank_account_name, class: "text-[18px] border-1 border-[#dfe2e6] rounded-full px-5 w-full py-2" %></p>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="actions">
        <%= f.submit t('devise.registrations.submit'), data: { action: "click->policy-modal#open" }, class: "w-full bg-blue-500 text-white text-center py-2 rounded-full border-2 mt-5 hover:bg-white hover:text-blue-500 hover:border-2 border-blue-500 transition cursor-pointer" %>
      </div>
      <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
        <p class="text-blue-500 hover:underline mt-5 cursor-pointer"><%= link_to t('devise.links.resend_confirmation'), new_confirmation_path(resource_name) %></p>
      <% end %>

      <div data-policy-modal-target="modal" class="hidden fixed inset-0 z-50 overflow-y-auto px-4 py-8 sm:py-12">
        <div aria-hidden="true" class="absolute inset-0 bg-black/50"></div>
        <div class="relative mx-auto bg-white rounded-lg shadow-xl max-w-lg w-full max-h-[80vh] flex flex-col">
          <div class="px-6 py-4 border-b border-gray-200">
            <h3 class="text-lg font-bold text-gray-900"><%= t('devise.registrations.policy_modal.title') %></h3>
          </div>
          <div class="px-6 py-4 overflow-y-auto flex-1 text-sm text-gray-600 space-y-4">
            <p><%= t('devise.registrations.policy_modal.welcome') %></p>
            <p><strong>1. <%= t('devise.registrations.policy_modal.collection_title') %>:</strong> <%= t('devise.registrations.policy_modal.collection_text') %></p>
            <p><strong>2. <%= t('devise.registrations.policy_modal.respect_title') %>:</strong> <%= t('devise.registrations.policy_modal.respect_text') %></p>
            <p><strong>3. <%= t('devise.registrations.policy_modal.payment_title') %>:</strong> <%= t('devise.registrations.policy_modal.payment_text') %></p>
          </div>
          <div class="px-6 py-4 border-t border-gray-200 flex flex-col-reverse sm:flex-row justify-end gap-3 sm:gap-4 bg-gray-50 rounded-b-lg">
            <button type="button" data-action="click->policy-modal#close" class="text-gray-500 hover:text-gray-700 font-medium"><%= t('devise.registrations.policy_modal.close') %></button>
            <button type="button" data-action="click->policy-modal#agree" class="bg-blue-500 text-white px-4 py-2 rounded shadow hover:bg-blue-600 font-bold transition"><%= t('devise.registrations.policy_modal.agree') %></button>
          </div>
        </div>
      </div>
    <% end %>
    <script>
      document.addEventListener('turbo:load', function () {
        var roleSelect = document.querySelector('select[name="user[role]"]');
        var bankDetails = document.getElementById('bank-details');
        if (!roleSelect || !bankDetails) return;

        function toggleBank() {
          if (roleSelect.value === 'teacher') {
            bankDetails.classList.remove('hidden');
          } else {
            bankDetails.classList.add('hidden');
            bankDetails.querySelectorAll('input').forEach(function(i){ i.value = ''; });
          }
        }

        roleSelect.addEventListener('change', toggleBank);
        toggleBank();
      });
    </script>
  </div>
</div>