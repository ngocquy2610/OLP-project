<div class="mx-auto my-16 flex max-w-6xl flex-col lg:flex-row justify-between gap-12 px-6 pb-24">
  <div class="w-full lg:w-1/3 space-y-6">
    <div class="space-y-2">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-primary-fixed-dim/20 bg-primary-fixed-dim/5 text-primary-fixed-dim text-xs font-label-tech uppercase tracking-wider">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-primary animate-pulse"></span>
        <span><%= t('devise.brand.secure_portal', default: 'Đăng Ký Thành Viên') %></span>
      </div>
      <h1 class="text-4xl font-bold font-headline-lg tracking-tight bg-gradient-to-r from-on-surface via-primary-fixed-dim to-on-surface bg-clip-text text-transparent">
        <%= t('devise.brand.line1') %>
      </h1>
      <p class="text-lg font-semibold text-slate-text font-headline-sm">
        <%= t('devise.brand.line2') %>
      </p>
    </div>
    
    <div class="relative group hidden lg:block">
      <div class="absolute -inset-1 bg-gradient-to-r from-primary to-primary-fixed-dim rounded-2xl blur opacity-15 group-hover:opacity-25 transition duration-1000"></div>
      <div class="relative glass-card overflow-hidden rounded-2xl border border-outline-variant/30 bg-surface/50">
        <%= optimized_static_image_tag("login-image.png", alt: "Login Image", class_name: "w-full h-[280px] object-cover mix-blend-luminosity opacity-80 group-hover:opacity-95 transition-opacity duration-500", width: 600, height: 400) %>
      </div>
    </div>
  </div>

  <div class="w-full lg:w-2/3 relative group">
    <div class="absolute -inset-1 bg-gradient-to-r from-primary-fixed-dim to-primary rounded-2xl blur opacity-10 group-hover:opacity-20 transition duration-1000"></div>
    <div class="relative glass-card rounded-2xl border border-outline-variant/30 p-8 shadow-2xl">
      <div class="flex flex-col items-center mb-6 pb-6 border-b border-outline-variant/20">
        <span class="material-symbols-outlined text-primary text-4xl mb-2">person_add</span>
        <h2 class="text-xl font-bold text-on-surface font-headline-sm tracking-wide uppercase">
          <%= t('devise.registrations.title') %>
        </h2>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { data: { controller: "policy-modal" } }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
          
          <div class="space-y-4">
            <div class="field">
              <%= f.label :email, t('devise.registrations.email_label'), class: "block mb-2 font-label-tech text-xs uppercase tracking-wider text-slate-text" %>
              <%= f.email_field :email, autofocus: false, autocomplete: "email", class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary/30 transition-all font-body-md" %>
            </div>

            <div class="field">
              <div class="flex items-center justify-between mb-2">
                <%= f.label :password, t('devise.registrations.password_label'), class: "font-label-tech text-xs uppercase tracking-wider text-slate-text" %>
                <% if @minimum_password_length %>
                  <span class="text-slate-text/50 text-[10px] uppercase font-label-tech tracking-wider"><%= t('missing_i18n.devise.min_chars', count: @minimum_password_length) %></span>
                <% end %>
              </div>
              <%= f.password_field :password, autocomplete: "new-password", class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary/30 transition-all font-body-md" %>
            </div>

            <div class="field">
              <%= f.label :password_confirmation, t('devise.registrations.password_confirmation'), class: "block mb-2 font-label-tech text-xs uppercase tracking-wider text-slate-text" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary/30 transition-all font-body-md" %>
            </div>
          </div>

          <div class="space-y-4">
            <div class="field">
              <%= f.label :fullname, t('devise.registrations.fullname'), class: "block mb-2 font-label-tech text-xs uppercase tracking-wider text-slate-text" %>
              <%= f.text_field :fullname, class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary/30 transition-all font-body-md" %>
            </div>

            <div class="field">
              <%= f.label :phone, t('devise.registrations.phone'), class: "block mb-2 font-label-tech text-xs uppercase tracking-wider text-slate-text" %>
              <%= f.text_field :phone, class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary/30 transition-all font-body-md" %>
            </div>

            <div class="field">
              <%= f.label :address, t('devise.registrations.address'), class: "block mb-2 font-label-tech text-xs uppercase tracking-wider text-slate-text" %>
              <%= f.text_area :address, rows: 3, class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary/30 transition-all font-body-md resize-none" %>
            </div>
          </div>

        </div>

        <div class="mt-6 border-t border-outline-variant/20 pt-6">
          <div class="field max-w-sm">
            <%= f.label :role, t('devise.registrations.role'), class: "block mb-2 font-label-tech text-xs uppercase tracking-wider text-slate-text" %>
            <%= f.select :role, 
              [[t('devise.registrations.role_options.student'), 'student'], [t('devise.registrations.role_options.teacher'), 'teacher']], 
              {}, 
              class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none focus:ring-1 focus:ring-primary/30 transition-all font-body-md cursor-pointer" %>
          </div>

          <div id="bank-details" class="hidden mt-6 bg-surface-container/30 border border-outline-variant/20 rounded-2xl p-6 space-y-4">
            <h3 class="text-sm font-bold text-primary-fixed-dim font-headline-sm uppercase tracking-wide flex items-center gap-2 mb-2">
              <span class="material-symbols-outlined text-base">account_balance</span>
              <span><%= t('missing_i18n.devise.teacher_bank_info_title') %></span>
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="field col-span-2">
                <%= f.label :bank_name, t('missing_i18n.devise.bank_name_hint'), class: "block mb-2 font-label-tech text-xs uppercase tracking-wider text-slate-text/70" %>
                <%= f.text_field :bank_name, class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none" %>
              </div>

              <div class="field">
                <%= f.label :bank_account_number, t('profiles.form.bank_account_number'), class: "block mb-2 font-label-tech text-xs uppercase tracking-wider text-slate-text/70" %>
                <%= f.text_field :bank_account_number, class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none" %>
              </div>

              <div class="field">
                <%= f.label :bank_account_name, t('missing_i18n.devise.bank_account_name_hint'), class: "block mb-2 font-label-tech text-xs uppercase tracking-wider text-slate-text/70" %>
                <%= f.text_field :bank_account_name, class: "w-full bg-surface-container-high/40 border border-outline-variant/50 hover:border-primary-fixed-dim/50 focus:border-primary text-on-surface rounded-xl px-5 py-3 text-sm focus:outline-none" %>
              </div>
            </div>
          </div>
        </div>

        <div class="actions mt-8">
          <%= f.submit t('devise.registrations.submit'), data: { action: "click->policy-modal#open" }, class: "w-full glow-button font-bold text-xs uppercase tracking-wider py-3.5 rounded-xl cursor-pointer shadow-[0_0_15px_rgba(0,229,255,0.15)]" %>
        </div>

        <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
          <p class="text-center mt-4">
            <%= link_to t('devise.links.resend_confirmation'), new_confirmation_path(resource_name), class: "text-slate-text hover:text-primary-fixed-dim text-xs transition font-label-tech" %>
          </p>
        <% end %>

        <div data-policy-modal-target="modal" class="hidden fixed inset-0 z-50 overflow-y-auto px-4 py-8 sm:py-12 flex items-center justify-center">
          <div aria-hidden="true" class="absolute inset-0 bg-background/85 backdrop-blur-md"></div>
          <div class="relative mx-auto glass-card rounded-2xl border border-outline-variant/40 bg-surface-container-lowest shadow-2xl max-w-lg w-full max-h-[80vh] flex flex-col z-10">
            <div class="px-6 py-5 border-b border-outline-variant/20 flex items-center gap-3">
              <span class="material-symbols-outlined text-primary text-2xl">gavel</span>
              <h3 class="text-base font-bold text-on-surface font-headline-sm uppercase tracking-wide"><%= t('devise.registrations.policy_modal.title') %></h3>
            </div>
            <div class="px-6 py-5 overflow-y-auto flex-1 font-body-md text-xs text-slate-text space-y-4 leading-relaxed">
              <p><%= t('devise.registrations.policy_modal.welcome') %></p>
              <p><strong class="text-primary-fixed-dim">1. <%= t('devise.registrations.policy_modal.collection_title') %>:</strong> <%= t('devise.registrations.policy_modal.collection_text') %></p>
              <p><strong class="text-primary-fixed-dim">2. <%= t('devise.registrations.policy_modal.respect_title') %>:</strong> <%= t('devise.registrations.policy_modal.respect_text') %></p>
              <p><strong class="text-primary-fixed-dim">3. <%= t('devise.registrations.policy_modal.payment_title') %>:</strong> <%= t('devise.registrations.policy_modal.payment_text') %></p>
            </div>
            <div class="px-6 py-5 border-t border-outline-variant/20 flex flex-col-reverse sm:flex-row justify-end gap-3 sm:gap-4 bg-surface-container/20 rounded-b-2xl">
              <button type="button" data-action="click->policy-modal#close" class="text-slate-text hover:text-red-400 font-bold font-label-tech uppercase tracking-wider text-xs px-4 py-2"><%= t('devise.registrations.policy_modal.close') %></button>
              <button type="button" data-action="click->policy-modal#agree" class="glow-button font-bold text-xs uppercase tracking-wider px-5 py-2.5 rounded-xl cursor-pointer"><%= t('devise.registrations.policy_modal.agree') %></button>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<script>
  document.addEventListener('turbo:load', function () {
    var roleSelect = document.querySelector('select[name="user[role]"]');
    var bankDetails = document.getElementById('bank-details');
    if (!roleSelect || !bankDetails) return;

    function toggleBank() {
      if (roleSelect.value === 'teacher') {
        bankDetails.classList.remove('hidden');
      } else {
        bankDetails.classList.add('hidden');
        bankDetails.querySelectorAll('input').forEach(function(i){ i.value = ''; });
      }
    }

    roleSelect.addEventListener('change', toggleBank);
    toggleBank();
  });
</script>