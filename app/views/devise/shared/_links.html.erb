<%- if controller_name != 'sessions' %>
  <p class="actions w-full mt-4">
    <%= link_to t('devise.links.sign_in'), new_session_path(resource_name), class: "block w-full text-center py-3 rounded-xl border border-outline-variant/30 text-on-surface hover:text-primary-fixed-dim hover:border-primary-fixed-dim/50 bg-surface-container-high/20 transition cursor-pointer font-bold text-xs uppercase tracking-wider font-label-tech" %>
  </p>
<% end %>
<%- if devise_mapping.registerable? && controller_name != 'registrations' %>
  <p class="actions w-full mt-4">
    <%= link_to t('devise.links.sign_up'), new_registration_path(resource_name), class: "block w-full text-center py-3 rounded-xl border border-outline-variant/30 text-on-surface hover:text-primary-fixed-dim hover:border-primary-fixed-dim/50 bg-surface-container-high/20 transition cursor-pointer font-bold text-xs uppercase tracking-wider font-label-tech" %>
  </p>
<% end %>
<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <p class="text-center mt-5">
    <%= link_to t('devise.links.forgot_password'), new_password_path(resource_name), class: "text-slate-text hover:text-primary-fixed-dim text-xs select-all transition font-label-tech" %>
  </p>
<% end %>
<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <p class="text-center mt-3">
    <%= link_to t('devise.links.resend_confirmation'), new_confirmation_path(resource_name), class: "text-slate-text hover:text-primary-fixed-dim text-xs transition font-label-tech" %>
  </p>
<% end %>
<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <p class="text-center mt-3">
    <%= link_to t('devise.links.resend_unlock'), new_unlock_path(resource_name), class: "text-slate-text hover:text-primary-fixed-dim text-xs transition font-label-tech" %>
  </p>
<% end %>
<%- if devise_mapping.omniauthable? %>
  <%- resource_class.omniauth_providers.each do |provider| %>
    <p class="mt-4"><%= button_to t('devise.links.sign_in') + " with #{OmniAuth::Utils.camelize(provider)}", omniauth_authorize_path(resource_name, provider), data: { turbo: false }, class: "w-full text-center py-3 rounded-xl border border-outline-variant/30 text-on-surface hover:text-primary-fixed-dim hover:border-primary-fixed-dim/50 bg-surface-container-high/20 transition cursor-pointer font-bold text-xs uppercase tracking-wider font-label-tech" %></p>
  <% end %>
<% end %>
