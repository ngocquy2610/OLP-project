<%= turbo_frame_tag "like_button_#{feedback.id}" do %>
  <div class="flex items-center gap-1 mt-3">
    <% if current_user %>
      <% if current_user.liked?(feedback) %>
        <%= button_to feedback_course_like_path(feedback), method: :delete, class: "text-blue-600 hover:bg-blue-50 p-1 rounded transition flex items-center gap-1" do %>
          <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M2 10.5a1.5 1.5 0 113 0v6a1.5 1.5 0 01-3 0v-6zM6 10.333v5.43a2 2 0 001.106 1.79l.05.025A4 4 0 008.943 18h5.416a2 2 0 001.962-1.608l1.2-6A2 2 0 0015.56 8H12V4a2 2 0 00-2-2 1 1 0 00-1 1v.667a4 4 0 01-.8 2.4L6.8 7.933a4 4 0 00-.8 2.4z" /></svg>
          <span class="font-medium text-sm"><%= feedback.likes.size %></span>
        <% end %>
      <% else %>
        <%= button_to feedback_course_like_path(feedback), method: :post, class: "text-gray-400 hover:text-blue-600 hover:bg-blue-50 p-1 rounded transition flex items-center gap-1" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" /></svg>
          <span class="font-medium text-sm"><%= feedback.likes.size %></span>
        <% end %>
      <% end %>
    <% else %>
      <%= button_to new_user_session_path, method: :get, class: "text-gray-400 hover:text-blue-600 p-1 rounded transition flex items-center gap-1" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5" /></svg>
        <span class="font-medium text-sm"><%= feedback.likes.size %></span>
      <% end %>
    <% end %>
  </div>
<% end %>