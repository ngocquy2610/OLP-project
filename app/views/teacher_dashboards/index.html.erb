<%= turbo_frame_tag "profile_content" do %>
<div class="max-w-6xl mx-auto mt-10 p-6 bg-white rounded-lg shadow-md">
  
  <div class="mb-6 border-b pb-4">
    <h1 class="text-3xl font-bold text-gray-800"><%= t('admin.teacher_dashboard.title') %></h1>
    <p class="text-gray-500 mt-2"><%= t('admin.teacher_dashboard.subtitle') %></p>
  </div>

  <div class="bg-blue-50 border border-blue-100 rounded-xl p-6 mb-8 flex flex-col md:flex-row items-center justify-between shadow-sm">
    <div>
      <h2 class="text-sm font-semibold text-blue-800 uppercase tracking-wider mb-1">Số dư khả dụng</h2>
      <p class="text-4xl font-bold text-blue-600">
        <%= format_vnd(current_user.balance || 0) %>
      </p>
    </div>

    <div class="mt-4 md:mt-0 flex flex-col items-end">
      <% if current_user.balance.to_i > 0 %>
        <%= button_to withdrawals_path, 
              method: :post, 
              data: { turbo_confirm: "Bạn xác nhận muốn rút toàn bộ #{format_vnd(current_user.balance)} về tài khoản ngân hàng?" },
              class: "bg-green-600 text-white px-6 py-3 rounded-lg font-bold hover:bg-green-700 transition shadow-md cursor-pointer flex items-center gap-2" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          Rút tiền ngay
        <% end %>
      <% else %>
        <button class="bg-gray-300 text-white px-6 py-3 rounded-lg font-bold cursor-not-allowed flex items-center gap-2" disabled>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          Chưa có số dư
        </button>
      <% end %>

      <% unless current_user.stripe_account_id.present? %>
        <p class="mt-2 text-xs text-red-500 font-medium">
          * Vui lòng liên kết tài khoản Stripe để nhận tiền
        </p>
      <% end %>
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="min-w-full bg-white border border-gray-200 rounded-lg">
      <thead class="bg-gray-50">
        <tr>
          <th class="py-3 px-6 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('admin.teacher_dashboard.table.course_name') %></th>
          <th class="py-3 px-6 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('admin.teacher_dashboard.table.price') %></th>
          <th class="py-3 px-6 text-center text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('admin.teacher_dashboard.table.sell_quantity') %></th>
          <th class="py-3 px-6 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('admin.teacher_dashboard.table.total_revenue') %></th>
          <th class="py-3 px-6 text-right text-xs font-bold text-green-600 uppercase tracking-wider"><%= t('admin.teacher_dashboard.table.actual_receipt') %></th>
        </tr>
      </thead>
      
      <tbody class="divide-y divide-gray-200">
        <% total_platform_revenue = 0 %>
        <% total_actual_receipt = 0 %>

        <% @courses.each do |course| %>
          <% quantity = @sell_quantities[course.id] || 0 %>
          <% revenue = @revenues[course.id] || 0 %>
          <% actual_receipt = revenue * 0.9 %>
          
          <% total_platform_revenue += revenue %>
          <% total_actual_receipt += actual_receipt %>

          <tr class="hover:bg-gray-50 transition duration-150">
            <td class="py-4 px-6 text-sm font-medium text-gray-900"><%= course.name %></td>
            <td class="py-4 px-6 text-sm text-gray-600 text-right"><%= format_vnd(course.price) %></td>
            <td class="py-4 px-6 text-sm text-gray-600 text-center"><span class="bg-blue-100 text-blue-800 py-1 px-3 rounded-full text-xs"><%= quantity %></span></td>
            <td class="py-4 px-6 text-sm text-gray-600 text-right"><%= format_vnd(revenue) %></td>
            <td class="py-4 px-6 text-sm font-bold text-green-600 text-right"><%= format_vnd(actual_receipt) %></td>
          </tr>
        <% end %>
      </tbody>

      <tfoot class="bg-gray-100 border-t-2 border-gray-300">
        <tr>
          <td colspan="3" class="py-4 px-6 text-right font-bold text-gray-800 text-lg"><%= t('admin.teacher_dashboard.table.grand_total') %></td>
          <td class="py-4 px-6 text-right font-bold text-gray-800 text-lg"><%= format_vnd(total_platform_revenue) %></td>
          <td class="py-4 px-6 text-right font-bold text-green-700 text-xl"><%= format_vnd(total_actual_receipt) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
<% end %>