<%= turbo_frame_tag "profile_content" do %>
<div class="max-w-6xl mx-auto mt-6">
  
  <div class="mb-8 pb-4 border-b border-outline-variant/20">
    <h1 class="text-xl font-bold text-on-surface font-headline-sm uppercase tracking-wider flex items-center gap-2">
      <span class="material-symbols-outlined text-primary">monitoring</span>
      <span><%= t('admin.teacher_dashboard.title') %></span>
    </h1>
    <p class="text-slate-text/70 text-xs font-body-md mt-1"><%= t('admin.teacher_dashboard.subtitle') %></p>
  </div>

  <div class="relative group mb-8">
    <div class="absolute -inset-1 bg-gradient-to-r from-primary-fixed-dim/30 to-primary/20 rounded-2xl blur opacity-15"></div>
    <div class="relative glass-card border border-outline-variant/30 rounded-2xl p-6 flex flex-col md:flex-row items-center justify-between shadow-2xl">
      <div class="space-y-1">
        <h2 class="text-[10px] font-bold text-primary-fixed-dim uppercase tracking-widest font-label-tech flex items-center gap-1">
          <span class="material-symbols-outlined text-sm">account_balance_wallet</span>
          <span><%= t('admin.teacher_dashboard.available_balance') %></span>
        </h2>
        <p class="text-3xl font-bold font-headline-md text-on-surface">
          <%= format_vnd(current_user.balance || 0) %>
        </p>
      </div>

      <div class="mt-4 md:mt-0 flex flex-col items-end">
        <% if current_user.balance.to_i > 0 %>
          <%= button_to withdrawals_path, 
                method: :post, 
                data: { turbo_confirm: t('admin.teacher_dashboard.withdraw_confirm', amount: format_vnd(current_user.balance)) },
                class: "glow-button font-bold text-xs uppercase tracking-wider px-6 py-3 rounded-xl cursor-pointer shadow-[0_0_15px_rgba(0,229,255,0.15)] flex items-center gap-2" do %>
            <span class="material-symbols-outlined text-base">payments</span>
            <span><%= t('admin.teacher_dashboard.withdraw_button') %></span>
          <% end %>
        <% else %>
          <button class="bg-surface-container border border-outline-variant/30 text-slate-text/40 px-6 py-3 rounded-xl text-xs font-bold font-label-tech uppercase tracking-wider cursor-not-allowed flex items-center gap-2" disabled>
            <span class="material-symbols-outlined text-base text-slate-text/30">lock</span>
            <span><%= t('admin.teacher_dashboard.no_balance') %></span>
          </button>
        <% end %>

        <% unless current_user.stripe_account_id.present? %>
          <p class="mt-2.5 text-[10px] text-red-400 font-semibold uppercase tracking-wider font-label-tech flex items-center gap-1">
            <span class="material-symbols-outlined text-xs">info</span>
            <span><%= t('admin.teacher_dashboard.stripe_note') %></span>
          </p>
        <% end %>
      </div>
    </div>
  </div>

  <div class="overflow-x-auto rounded-xl border border-outline-variant/30 bg-surface-container-low/20">
    <table class="w-full text-left border-collapse min-w-[700px]">
      <thead>
        <tr class="bg-surface-container/40 border-b border-outline-variant/20">
          <th class="p-4 font-label-tech text-xs uppercase tracking-wider text-slate-text/70 font-bold"><%= t('admin.teacher_dashboard.table.course_name') %></th>
          <th class="p-4 font-label-tech text-xs uppercase tracking-wider text-slate-text/70 font-bold text-right"><%= t('admin.teacher_dashboard.table.price') %></th>
          <th class="p-4 font-label-tech text-xs uppercase tracking-wider text-slate-text/70 font-bold text-center"><%= t('admin.teacher_dashboard.table.sell_quantity') %></th>
          <th class="p-4 font-label-tech text-xs uppercase tracking-wider text-slate-text/70 font-bold text-right"><%= t('admin.teacher_dashboard.table.total_revenue') %></th>
          <th class="p-4 font-label-tech text-xs uppercase tracking-wider text-primary-fixed-dim font-bold text-right"><%= t('admin.teacher_dashboard.table.actual_receipt') %></th>
        </tr>
      </thead>
      
      <tbody class="divide-y divide-outline-variant/10 font-body-md text-slate-text text-sm">
        <% total_platform_revenue = 0 %>
        <% total_actual_receipt = 0 %>

        <% @courses.each do |course| %>
          <% quantity = @sell_quantities[course.id] || 0 %>
          <% revenue = @revenues[course.id] || 0 %>
          <% actual_receipt = revenue * 0.9 %>
          
          <% total_platform_revenue += revenue %>
          <% total_actual_receipt += actual_receipt %>

          <tr class="hover:bg-surface-container-high/10 transition-colors">
            <td class="p-4 font-semibold text-on-surface"><%= course.name %></td>
            <td class="p-4 text-slate-text text-right"><%= format_vnd(course.price) %></td>
            <td class="p-4 text-center">
              <span class="inline-block bg-primary-fixed-dim/10 border border-primary-fixed-dim/20 text-primary-fixed-dim font-mono font-bold text-xs py-1 px-3 rounded-full"><%= quantity %></span>
            </td>
            <td class="p-4 text-slate-text text-right"><%= format_vnd(revenue) %></td>
            <td class="p-4 font-bold text-primary-fixed-dim text-right"><%= format_vnd(actual_receipt) %></td>
          </tr>
        <% end %>
      </tbody>

      <tfoot class="bg-surface-container-low/50 border-t border-outline-variant/30">
        <tr class="text-right font-semibold font-headline-sm text-sm">
          <td colspan="3" class="p-4 text-on-surface text-base uppercase tracking-wider font-label-tech font-bold"><%= t('admin.teacher_dashboard.table.grand_total') %></td>
          <td class="p-4 text-on-surface text-base font-bold"><%= format_vnd(total_platform_revenue) %></td>
          <td class="p-4 text-primary-fixed-dim text-lg font-bold"><%= format_vnd(total_actual_receipt) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
<% end %>