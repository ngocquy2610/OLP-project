<!-- Hero -->
<section class="bg-purple-500 text-white py-20">
  <div class="max-w-7xl mx-auto px-6 text-center">
    <h1 class="text-4xl md:text-5xl font-bold">
      <%= t('pages.about.hero.title') %>
    </h1>
    <p class="mt-6 text-lg text-blue-100 max-w-2xl mx-auto">
      <%= t('pages.about.hero.subtitle') %>
    </p>
  </div>
</section>
<!-- Mission & Vision -->
<section class="py-20">
  <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center">
    <div>
      <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644"
           class="rounded-xl shadow-lg">
    </div>
    <div>
      <h2 class="text-3xl font-bold mb-6"><%= t('pages.about.mission_title') %></h2>
      <p class="text-gray-600 mb-6">
        <%= t('pages.about.mission_text') %>
      </p>
      <h3 class="text-2xl font-semibold mb-4"><%= t('pages.about.vision_title') %></h3>
      <p class="text-gray-600">
        <%= t('pages.about.vision_text') %>
      </p>
    </div>
  </div>
</section>
<!-- Stats -->
<section class="bg-gray-100 py-20">
  <div class="max-w-7xl mx-auto px-6 text-center">
    <h2 class="text-3xl font-bold mb-12">
      <%= t('pages.about.stats_title') %>
    </h2>
    <div class="grid md:grid-cols-4 gap-8">
      <div>
        <h3 class="text-4xl font-bold text-blue-600">10,000+</h3>
        <p class="text-gray-600 mt-2"><%= t('pages.about.students_label') %></p>
      </div>
      <div>
        <h3 class="text-4xl font-bold text-blue-600">500+</h3>
        <p class="text-gray-600 mt-2"><%= t('pages.about.courses_label') %></p>
      </div>
      <div>
        <h3 class="text-4xl font-bold text-blue-600">120+</h3>
        <p class="text-gray-600 mt-2">Giảng viên</p>
      </div>
      <div>
        <h3 class="text-4xl font-bold text-blue-600">50+</h3>
        <p class="text-gray-600 mt-2">Quốc gia</p>
      </div>
    </div>
  </div>
</section>
<!-- Team -->
<section class="py-20">
  <div class="max-w-7xl mx-auto px-6 text-center">
    <h2 class="text-3xl font-bold mb-12">
      <%= t('pages.about.team_title') %>
    </h2>
    <div class="grid md:grid-cols-3 gap-10">
      <!-- Member -->
      <div class="bg-white rounded-xl shadow p-6">
        <img src="https://randomuser.me/api/portraits/men/32.jpg"
             class="w-32 h-32 rounded-full mx-auto mb-4">
        <h4 class="text-xl font-semibold"><%= t('pages.about.team.member_1.name') %></h4>
        <p class="text-gray-500"><%= t('pages.about.team.member_1.role') %></p>
        <p class="text-gray-600 text-sm mt-4">
          Người sáng lập nền tảng với hơn 10 năm kinh nghiệm trong lĩnh vực
          giáo dục và công nghệ.
        </p>
      </div>
      <!-- Member -->
      <div class="bg-white rounded-xl shadow p-6">
        <img src="https://randomuser.me/api/portraits/women/44.jpg"
             class="w-32 h-32 rounded-full mx-auto mb-4">
        <h4 class="text-xl font-semibold"><%= t('pages.about.team.member_2.name') %></h4>
        <p class="text-gray-500"><%= t('pages.about.team.member_2.role') %></p>
        <p class="text-gray-600 text-sm mt-4">
          Chịu trách nhiệm xây dựng nội dung khóa học và hợp tác với
          các giảng viên trên toàn cầu.
        </p>
      </div>
      <!-- Member -->
      <div class="bg-white rounded-xl shadow p-6">
        <img src="https://randomuser.me/api/portraits/men/52.jpg"
             class="w-32 h-32 rounded-full mx-auto mb-4">
        <h4 class="text-xl font-semibold"><%= t('pages.about.team.member_3.name') %></h4>
        <p class="text-gray-500"><%= t('pages.about.team.member_3.role') %></p>
        <p class="text-gray-600 text-sm mt-4">
          Phụ trách phát triển và tối ưu nền tảng công nghệ để mang lại
          trải nghiệm học tập tốt nhất.
        </p>
      </div>
    </div>
  </div>
</section>
<!-- CTA -->
<section class="bg-purple-500 text-white py-20 text-center">
  <h2 class="text-3xl font-bold">
    <%= t('pages.about.cta_title') %>
  </h2>
  <p class="mt-4 mb-8 text-blue-100">
    <%= t('pages.about.cta_subtitle') %>
  </p>
    <%= link_to t('pages.about.cta_action'), courses_path, class: "bg-white text-blue-600 px-8 py-3 rounded-lg font-semibold hover:bg-gray-200" %>
  
</section>