<!-- Hero Section -->
<section class="relative min-h-[400px] flex items-center overflow-hidden">
  <div class="absolute inset-0 bg-grid-pattern opacity-10 pointer-events-none"></div>
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-primary-container/10 blur-[120px] rounded-full"></div>
  <div class="absolute -bottom-40 -left-40 w-96 h-96 bg-secondary-container/10 blur-[120px] rounded-full"></div>
  
  <div class="max-w-[1280px] mx-auto px-6 text-center py-20 relative z-10 space-y-6">
    
    <h1 class="font-headline-md text-4xl xl:text-6xl font-bold tracking-tight text-on-surface">
      <%= t('pages.about.hero.title') %>
    </h1>
    <p class="font-body-lg text-lg text-slate-text max-w-2xl mx-auto leading-relaxed">
      <%= t('pages.about.hero.subtitle') %>
    </p>
  </div>
</section>

<!-- Mission & Vision -->
<section class="py-20 relative">
  <div class="max-w-[1280px] mx-auto px-6 grid md:grid-cols-2 gap-16 items-center">
    <div class="relative group">
      <div class="absolute inset-0 bg-primary-fixed-dim/10 blur-[60px] group-hover:bg-primary-fixed-dim/20 transition-all duration-700"></div>
      <div class="glass-card-no-hover p-2 rounded-2xl overflow-hidden relative border border-outline-variant/30">
        <img src="https://images.unsplash.com/photo-1523240795612-9a054b0db644" alt="Workspace" class="w-full h-[380px] object-cover rounded-xl" />
        
      </div>
    </div>
    
    <div class="space-y-8">
      <div>
        <h2 class="font-headline-md text-3xl font-bold text-on-surface mb-4 border-l-4 border-primary-fixed-dim pl-4"><%= t('pages.about.mission_title') %></h2>
        <p class="font-body-md text-slate-text text-sm leading-relaxed">
          <%= t('pages.about.mission_text') %>
        </p>
      </div>
      
      <div class="pt-6 border-t border-outline-variant/20">
        <h3 class="font-headline-md text-2xl font-bold text-on-surface mb-4 border-l-4 border-primary-fixed-dim pl-4"><%= t('pages.about.vision_title') %></h3>
        <p class="font-body-md text-slate-text text-sm leading-relaxed">
          <%= t('pages.about.vision_text') %>
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Stats -->
<section class="py-20 bg-surface-container-low/40 relative">
  <div class="max-w-[1280px] mx-auto px-6 text-center">
    <div class="mb-12">
      <h2 class="font-headline-md text-3xl font-bold text-on-surface"><%= t('pages.about.stats_title') %></h2>
    </div>
    
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div class="glass-card p-6 rounded-xl border border-outline-variant/30">
        <h3 class="font-headline-md text-3xl md:text-4xl font-bold text-primary-fixed-dim">10,000+</h3>
        <p class="font-label-tech text-xs text-slate-text uppercase tracking-wider mt-2"><%= t('pages.about.students_label') %></p>
      </div>
      <div class="glass-card p-6 rounded-xl border border-outline-variant/30">
        <h3 class="font-headline-md text-3xl md:text-4xl font-bold text-primary-fixed-dim">500+</h3>
        <p class="font-label-tech text-xs text-slate-text uppercase tracking-wider mt-2"><%= t('pages.about.courses_label') %></p>
      </div>
      <div class="glass-card p-6 rounded-xl border border-outline-variant/30">
        <h3 class="font-headline-md text-3xl md:text-4xl font-bold text-primary-fixed-dim">120+</h3>
        <p class="font-label-tech text-xs text-slate-text uppercase tracking-wider mt-2"><%= t('pages.about.teachers_label') %></p>
      </div>
      <div class="glass-card p-6 rounded-xl border border-outline-variant/30">
        <h3 class="font-headline-md text-3xl md:text-4xl font-bold text-primary-fixed-dim">50+</h3>
        <p class="font-label-tech text-xs text-slate-text uppercase tracking-wider mt-2"><%= t('pages.about.countries_label') %></p>
      </div>
    </div>
  </div>
</section>

<!-- Team -->
<section class="py-20 relative">
  <div class="max-w-[1280px] mx-auto px-6 text-center">
    <div class="mb-16">
      <h2 class="font-headline-md text-3xl font-bold text-on-surface"><%= t('pages.about.team_title') %></h2>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Member 1 -->
      <div class="glass-card p-8 rounded-xl flex flex-col items-center border border-outline-variant/30">
        <div class="relative mb-6">
          <div class="absolute inset-0 bg-primary-fixed-dim/20 blur-[20px] rounded-full"></div>
          <img src="https://randomuser.me/api/portraits/men/32.jpg" alt="Member" class="w-28 h-28 rounded-full border border-primary-fixed-dim/30 grayscale hover:grayscale-0 transition-all duration-300 relative z-10" />
        </div>
        <h4 class="font-headline-sm text-lg font-bold text-on-surface"><%= t('pages.about.team.member_1.name') %></h4>
        <p class="font-label-tech text-xs text-primary-fixed-dim tracking-wider uppercase mt-1"><%= t('pages.about.team.member_1.role') %></p>
        <p class="font-body-md text-xs text-slate-text mt-4 leading-relaxed"><%= t('pages.about.team.member_1.description') %></p>
      </div>
      
      <!-- Member 2 -->
      <div class="glass-card p-8 rounded-xl flex flex-col items-center border border-outline-variant/30">
        <div class="relative mb-6">
          <div class="absolute inset-0 bg-primary-fixed-dim/20 blur-[20px] rounded-full"></div>
          <img src="https://randomuser.me/api/portraits/women/44.jpg" alt="Member" class="w-28 h-28 rounded-full border border-primary-fixed-dim/30 grayscale hover:grayscale-0 transition-all duration-300 relative z-10" />
        </div>
        <h4 class="font-headline-sm text-lg font-bold text-on-surface"><%= t('pages.about.team.member_2.name') %></h4>
        <p class="font-label-tech text-xs text-primary-fixed-dim tracking-wider uppercase mt-1"><%= t('pages.about.team.member_2.role') %></p>
        <p class="font-body-md text-xs text-slate-text mt-4 leading-relaxed"><%= t('pages.about.team.member_2.description') %></p>
      </div>
      
      <!-- Member 3 -->
      <div class="glass-card p-8 rounded-xl flex flex-col items-center border border-outline-variant/30">
        <div class="relative mb-6">
          <div class="absolute inset-0 bg-primary-fixed-dim/20 blur-[20px] rounded-full"></div>
          <img src="https://randomuser.me/api/portraits/men/52.jpg" alt="Member" class="w-28 h-28 rounded-full border border-primary-fixed-dim/30 grayscale hover:grayscale-0 transition-all duration-300 relative z-10" />
        </div>
        <h4 class="font-headline-sm text-lg font-bold text-on-surface"><%= t('pages.about.team.member_3.name') %></h4>
        <p class="font-label-tech text-xs text-primary-fixed-dim tracking-wider uppercase mt-1"><%= t('pages.about.team.member_3.role') %></p>
        <p class="font-body-md text-xs text-slate-text mt-4 leading-relaxed"><%= t('pages.about.team.member_3.description') %></p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="py-20 bg-surface-container-low/40 relative overflow-hidden border-t border-outline-variant/20 text-center">
  <div class="absolute inset-0 bg-grid-pattern opacity-5 pointer-events-none"></div>
  <div class="max-w-[700px] mx-auto px-6 relative z-10 space-y-6">
    <h2 class="font-headline-md text-3xl font-bold text-on-surface"><%= t('pages.about.cta_title') %></h2>
    <p class="font-body-md text-sm text-slate-text leading-relaxed">
      <%= t('pages.about.cta_subtitle') %>
    </p>
    <div class="pt-4">
      <%= link_to t('pages.about.cta_action'), courses_path, class: "glow-button px-8 py-3.5 rounded-xl font-label-tech text-xs uppercase tracking-wider font-bold inline-flex items-center gap-2 cursor-pointer" %>
    </div>
  </div>
</section>
  
</section>