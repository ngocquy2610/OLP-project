<%= turbo_frame_tag "profile_content" do %>
  <div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex items-center mb-6 gap-5">
    <h2 class="text-2xl font-semibold"><%= t('cart.title') %></h2>
    <div class="flex items-center">
              <input 
                type="checkbox"
                id="check_all"
                class="w-5 h-5 text-blue-600 border-gray-300 rounded focus:ring-blue-500 cursor-pointer"
              >
              <label for="check_all" class="ml-2 text-xs text-gray-600 cursor-pointer"><%= t('cart.check_all') %></label>
            </div>
  </div>
    <%= form_with url: checkout_cart_path, method: :post, id: "cart-form" do %>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <div id="cart-items" class="lg:col-span-2 space-y-4">
          <% if @cart.cart_items.any? %>
          
            

            <% @cart.cart_items.each do |item| %>
              <div class="flex items-center justify-between bg-white p-4 rounded-2xl shadow-sm border border-gray-300">
                
                <div class="flex items-center gap-4">
                  <input 
                    type="checkbox"
                    name="selected_items[]"
                    value="<%= item.id %>"
                    data-price="<%= item.course&.price.to_i %>"
                    class="js-item-checkbox w-5 h-5 text-blue-600 border-gray-300 rounded focus:ring-blue-500 cursor-pointer"
                  >
                  <% if item.course&.course_image&.attached? %>
                    <div class="w-20 h-12 flex-shrink-0">
                      <%= image_tag item.course.course_image, class: "w-full h-full object-cover rounded-md" %>
                    </div>
                  <% end %>
                  <div>
                    <p class="font-medium text-gray-800">
                      <%= item.course&.name %>
                    </p>
                  </div>
                </div>
                
                <div class="flex items-center gap-4">
                  <p class="font-semibold text-gray-700">
                    <%= format_vnd(item.course&.price) %>
                  </p>
                  <%= link_to t('cart.remove'),
                    cart_item_path(item),
                    data: { turbo_method: :delete, turbo_confirm: t('cart.remove_confirm') },
                    class: "text-red-500 hover:text-red-700 text-sm" %>
                </div>
              </div>
            <% end %>
            
          <% else %>
            <p class="text-gray-500"><%= t('cart.empty') %></p>
          <% end %>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-300 h-fit">
          <h3 class="text-lg font-semibold mb-4"><%= t('cart.summary') %></h3>
          <div class="space-y-2 text-sm text-gray-600">
            <div class="flex justify-between">
                <span><%= t('cart.items_label') %></span>
              <span id="selected_count">0</span>
            </div>
            <div class="flex justify-between">
                <span><%= t('cart.total_label') %></span>
              <span id="selected_total" class="font-semibold text-gray-800"><%= format_vnd(0) %></span>
            </div>
          </div>
            <%= submit_tag t('cart.checkout'),
              class: "w-full mt-6 bg-blue-600 text-white py-2 rounded-xl hover:bg-blue-700 transition cursor-pointer" %>
        </div>
        
      </div>
    <% end %>
  </div>

  <script>
    function formatCurrency(amount) {
      const n = Number(amount) || 0;
      try {
        return new Intl.NumberFormat('en-US', { maximumFractionDigits: 0 }).format(n) + ' VNĐ';
      } catch (e) {
        return n.toString() + ' VNĐ';
      }
    }

    function updateSummary(container = document) {
      const itemBoxes = Array.from(container.querySelectorAll('.js-item-checkbox'));
      const selectedCountEl = document.getElementById('selected_count');
      const selectedTotalEl = document.getElementById('selected_total');
      if (!selectedCountEl || !selectedTotalEl) return;
      const checked = itemBoxes.filter(b => b.checked);
      const total = checked.reduce((sum, b) => sum + Number(b.dataset.price || 0), 0);
      selectedCountEl.textContent = checked.length;
      selectedTotalEl.textContent = formatCurrency(total);
    }

    function setupCartHandlers() {
      const container = document.getElementById('cart-items');
      const checkAllBox = document.getElementById('check_all');
      if (!container) return;

      container.addEventListener('change', function(e) {
        if (e.target && e.target.matches('.js-item-checkbox')) {
          const itemBoxes = Array.from(container.querySelectorAll('.js-item-checkbox'));
          if (checkAllBox) checkAllBox.checked = itemBoxes.length > 0 && itemBoxes.every(b => b.checked);
          updateSummary(container);
        }
      });

      if (checkAllBox) {
        checkAllBox.addEventListener('change', function() {
          const itemBoxes = Array.from(container.querySelectorAll('.js-item-checkbox'));
          itemBoxes.forEach(box => box.checked = this.checked);
          updateSummary(container);
        });
      }

      updateSummary(container);
    }

    document.addEventListener('DOMContentLoaded', setupCartHandlers);
    document.addEventListener('turbo:load', setupCartHandlers);
    document.addEventListener('turbo:frame-load', function(e) {
      const frame = e.target;
      if (frame && frame.querySelector && frame.querySelector('#cart-items')) {
        setupCartHandlers();
      }
    });
  </script>
<% end %>