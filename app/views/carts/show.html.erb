<%= turbo_frame_tag "profile_content" do %>
  <div class="max-w-6xl mx-auto px-6 py-10 mb-24">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-10 border-b border-outline-variant/20 pb-6">
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-primary-fixed-dim text-3xl">shopping_cart</span>
        <h2 class="font-headline-md text-2xl font-bold text-on-surface"><%= t('cart.title', default: 'Giỏ hàng của bạn') %></h2>
      </div>
      <div class="flex items-center bg-surface-container-high/40 border border-outline-variant/30 rounded-xl px-4 py-2">
        <input type="checkbox" id="check_all" class="w-5 h-5 text-primary-fixed-dim bg-surface border-outline-variant rounded focus:ring-primary-fixed-dim cursor-pointer">
        <label for="check_all" class="ml-2.5 font-label-tech text-xs text-slate-text cursor-pointer uppercase tracking-wider"><%= t('cart.check_all', default: 'Chọn tất cả') %></label>
      </div>
    </div>

    <div id="voucher-data" data-discount="<%= @voucher&.discount_percent || 0 %>" class="hidden"></div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      
      <div class="lg:col-span-2 space-y-4">
        <%= form_with url: checkout_cart_path, method: :post, id: "cart-form" do %>
          <div id="cart-items" class="space-y-4">
            <%= render "cart_items", cart: @cart, selected_ids: @selected_ids %>
          </div>
        <% end %>
      </div>

      <div class="space-y-6">

        <div class="glass-card p-6 rounded-2xl border border-outline-variant/30">
          <h3 class="font-headline-sm text-base font-bold text-on-surface mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary-fixed-dim">sell</span>
            <span><%= t('cart.voucher_title', default: 'Mã giảm giá') %></span>
          </h3>

          <% if @voucher %>
            <div class="flex items-center justify-between bg-primary-fixed-dim/5 border border-primary-fixed-dim/20 p-4 rounded-xl">
              <div class="flex items-center space-x-3">
                <span class="text-on-primary font-bold font-label-tech bg-primary px-2.5 py-1 rounded text-xs select-all"><%= @voucher.code %></span>
                <span class="text-primary-fixed-dim text-xs font-semibold"><%= t('cart.voucher_discount', default: 'Giảm %{percent}%', percent: @voucher.discount_percent) %></span>
              </div>
              <%= button_to remove_voucher_cart_path, method: :delete, class: "text-red-400 hover:text-red-500 text-xs font-label-tech uppercase tracking-wider" do %>
                <span><%= t('cart.remove', default: 'Gỡ bỏ') %></span>
              <% end %>
            </div>
          <% else %>
            <%= form_with url: apply_voucher_cart_path, method: :post, local: true, html: { id: 'apply-voucher-form', class: 'flex gap-2' } do |f| %>
              <%= f.text_field :code, placeholder: t('cart.voucher_placeholder', default: 'Nhập mã (VD: SALE50)'), class: "border border-outline-variant bg-surface text-on-surface rounded-xl px-4 py-2 w-full uppercase text-sm focus:border-primary-fixed-dim outline-none placeholder:text-slate-text/50" %>
              <%= f.submit t('cart.apply', default: 'Áp dụng'), class: "glow-button text-xs font-semibold px-4 py-2.5 rounded-xl cursor-pointer uppercase font-label-tech" %>
            <% end %>
          <% end %>
        </div>

        <div class="glass-card p-6 rounded-2xl border border-outline-variant/30">
          <h3 class="font-headline-sm text-base font-bold text-on-surface mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-primary-fixed-dim">receipt_long</span>
            <span><%= t('cart.summary', default: 'Tóm tắt đơn hàng') %></span>
          </h3>

          <div class="space-y-3 pb-4 border-b border-outline-variant/20 font-body-md text-xs text-slate-text">
            <div class="flex justify-between">
              <span><%= t('cart.selected_prefix', default: 'Đã chọn') %> (<span id="selected_count" class="text-primary-fixed-dim font-bold">0</span>)</span>
              <span id="sub_total" class="font-bold text-on-surface"><%= format_vnd(0) %></span>
            </div>

            <div id="discount_row" class="flex justify-between text-emerald-400 font-semibold" style="display: none;">
              <span><%= t('cart.voucher_discount_label', default: 'Giảm giá Voucher:') %></span>
              <span id="discount_amount"><%= format_vnd(0) %></span>
            </div>
          </div>

          <div class="flex justify-between items-center mt-4 mb-6">
            <span class="font-semibold text-sm text-on-surface"><%= t('cart.total_label', default: 'Tổng cộng:') %></span>
            <span id="selected_total" class="font-bold text-xl text-primary-fixed-dim"><%= format_vnd(0) %></span>
          </div>

          <button type="submit" form="cart-form" class="w-full glow-button font-bold text-xs uppercase tracking-wider py-3.5 rounded-xl cursor-pointer shadow-[0_0_15px_rgba(0,229,255,0.2)]">
            <%= t('cart.checkout', default: 'Tiến hành thanh toán') %>
          </button>
        </div>

      </div>

    </div>
  </div>

  <script>
    function formatCurrency(amount) {
      const n = Number(amount) || 0;
      try {
        return new Intl.NumberFormat('vi-VN', { maximumFractionDigits: 0 }).format(n) + ' VNĐ';
      } catch (e) {
        return n.toString() + ' VNĐ';
      }
    }

    function updateSummary() {
      const container = document.getElementById('cart-items');
      if (!container) return;

      const itemBoxes = Array.from(container.querySelectorAll('.js-item-checkbox'));
      const checked = itemBoxes.filter(b => b.checked);
      
      // Tính tiền gốc
      const subtotal = checked.reduce((sum, b) => sum + Number(b.dataset.price || 0), 0);
      
      // Lấy phần trăm giảm giá từ HTML
      const voucherData = document.getElementById('voucher-data');
      const discountPercent = voucherData ? (Number(voucherData.dataset.discount) || 0) : 0;
      
      // Tính toán
      const discountAmount = Math.round(subtotal * (discountPercent / 100.0));
      const finalTotal = subtotal - discountAmount;

      // Cập nhật lên Giao diện
      document.getElementById('selected_count').textContent = checked.length;
      document.getElementById('sub_total').textContent = formatCurrency(subtotal);
      
      const discountRow = document.getElementById('discount_row');
      if (discountPercent > 0 && subtotal > 0) {
        discountRow.style.display = 'flex';
        document.getElementById('discount_amount').textContent = '-' + formatCurrency(discountAmount);
      } else {
        discountRow.style.display = 'none';
      }
      
      document.getElementById('selected_total').textContent = formatCurrency(finalTotal);
    }

    function setupCartHandlers() {
      const container = document.getElementById('cart-items');
      const checkAllBox = document.getElementById('check_all');
      if (!container) return;

      container.addEventListener('change', function(e) {
        if (e.target && e.target.matches('.js-item-checkbox')) {
          const itemBoxes = Array.from(container.querySelectorAll('.js-item-checkbox'));
          if (checkAllBox) checkAllBox.checked = itemBoxes.length > 0 && itemBoxes.every(b => b.checked);
          updateSummary();
        }
      });

      if (checkAllBox) {
        checkAllBox.addEventListener('change', function() {
          const itemBoxes = Array.from(container.querySelectorAll('.js-item-checkbox'));
          itemBoxes.forEach(box => box.checked = this.checked);
          updateSummary();
        });
      }

      updateSummary();
    }

    document.addEventListener('DOMContentLoaded', setupCartHandlers);
    document.addEventListener('turbo:load', setupCartHandlers);
    document.addEventListener('turbo:frame-load', function(e) {
      if (e.target && e.target.querySelector && e.target.querySelector('#cart-items')) {
        setupCartHandlers();
      }
    });

    // validate voucher against selected items before submitting the apply form
    (function attachVoucherFormHandler() {
      const form = document.getElementById('apply-voucher-form');
      if (!form) return;

      form.addEventListener('submit', function(e) {
        e.preventDefault();

        // gather selected items
        const container = document.getElementById('cart-items');
        if (!container) return;
        const checked = Array.from(container.querySelectorAll('.js-item-checkbox')).filter(b => b.checked);
        if (checked.length === 0) {
          alert('<%= j t("cart.errors.select_item", default: "Vui lòng chọn ít nhất một sản phẩm trước khi áp dụng mã giảm giá.") %>');
          return;
        }

        const codeInput = form.querySelector('input[name="code"]');
        const code = codeInput ? codeInput.value.trim() : '';
        if (!code) {
          alert('<%= j t("cart.errors.enter_code", default: "Vui lòng nhập mã giảm giá.") %>');
          return;
        }

        const formData = new FormData();
        formData.append('code', code);
        checked.forEach(box => formData.append('selected_items[]', box.value));

        const tokenEl = document.querySelector('meta[name="csrf-token"]');
        const token = tokenEl ? tokenEl.getAttribute('content') : '';

        fetch('<%= validate_voucher_cart_path %>', {
          method: 'POST',
          headers: {
            'X-CSRF-Token': token,
            'Accept': 'application/json'
          },
          body: formData
        }).then(async response => {
          const data = await response.json().catch(() => ({}));
          if (response.ok && data.allowed) {
            // append selected items as hidden inputs then submit the original form
            Array.from(form.querySelectorAll('input[name="selected_items[]"]')).forEach(el => el.remove());
            checked.forEach(box => {
              const input = document.createElement('input');
              input.type = 'hidden';
              input.name = 'selected_items[]';
              input.value = box.value;
              form.appendChild(input);
            });
            form.submit();
            } else {
            alert(data.message || '<%= j t("cart.errors.voucher_not_allowed", default: "Mã giảm giá không thể áp dụng cho các sản phẩm đã chọn.") %>');
          }
        }).catch(() => {
          // network error — fallback to submitting so server can validate
          Array.from(form.querySelectorAll('input[name="selected_items[]"]')).forEach(el => el.remove());
          checked.forEach(box => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'selected_items[]';
            input.value = box.value;
            form.appendChild(input);
          });
          form.submit();
        });
      });
    })();
  </script>
<% end %>