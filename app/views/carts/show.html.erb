<%= turbo_frame_tag "profile_content" do %>
  <div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex items-center mb-6 gap-5">
    <h2 class="text-2xl font-semibold"><%= t('cart.title') %></h2>
    <div class="flex items-center">
              <input 
                type="checkbox"
                id="check_all" 
                class="w-5 h-5 text-blue-600 border-gray-300 rounded focus:ring-blue-500 cursor-pointer"
              >
            </div>
  </div>
    <%= form_with url: checkout_cart_path, method: :post, id: "cart-form" do %>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <div class="lg:col-span-2 space-y-4">
          <% if @cart.cart_items.any? %>
          
            

            <% @cart.cart_items.each do |item| %>
              <div class="flex items-center justify-between bg-white p-4 rounded-2xl shadow-sm border">
                
                <div class="flex items-center gap-4">
                  <input 
                    type="checkbox"
                    name="selected_items[]"
                    value="<%= item.id %>"
                    class="js-item-checkbox w-5 h-5 text-blue-600 border-gray-300 rounded focus:ring-blue-500 cursor-pointer"
                  >
                  <div>
                    <p class="font-medium text-gray-800">
                      <%= item.course&.name %>
                    </p>
                  </div>
                </div>
                
                <div class="flex items-center gap-4">
                  <p class="font-semibold text-gray-700">
                    <%= number_to_currency(item.course&.price.to_i, unit: "₫", precision: 0, delimiter: ",") %>
                  </p>
                  <%= link_to t('cart.remove'),
                    cart_item_path(item),
                    data: { turbo_method: :delete, turbo_confirm: t('cart.remove_confirm') },
                    class: "text-red-500 hover:text-red-700 text-sm" %>
                </div>
              </div>
            <% end %>
            
          <% else %>
            <p class="text-gray-500"><%= t('cart.empty') %></p>
          <% end %>
        </div>

        <div class="bg-white p-6 rounded-2xl shadow-sm border h-fit">
          <h3 class="text-lg font-semibold mb-4"><%= t('cart.summary') %></h3>
          <div class="space-y-2 text-sm text-gray-600">
            <div class="flex justify-between">
                <span><%= t('cart.items_label') %></span>
              <span><%= @cart.cart_items.count %></span>
            </div>
            <div class="flex justify-between">
                <span><%= t('cart.total_label') %></span>
              <span class="font-semibold text-gray-800">
                <%= number_to_currency(
                      @cart.cart_items.sum { |i| i.course&.price.to_i },
                      unit: "₫",
                      precision: 0,
                      delimiter: ","
                    ) %>
              </span>
            </div>
          </div>
            <%= submit_tag t('cart.checkout'),
              class: "w-full mt-6 bg-blue-600 text-white py-2 rounded-xl hover:bg-blue-700 transition" %>
        </div>
        
      </div>
    <% end %>
  </div>

  <script>
    function initializeCheckAll() {
      const checkAllBox = document.getElementById('check_all');
      const itemBoxes = document.querySelectorAll('.js-item-checkbox');

      if (!checkAllBox) return;

      checkAllBox.addEventListener('change', function() {
        itemBoxes.forEach(box => {
          box.checked = this.checked;
        });
      });

      itemBoxes.forEach(box => {
        box.addEventListener('change', function() {
          const allChecked = Array.from(itemBoxes).every(b => b.checked);
          checkAllBox.checked = allChecked;
        });
      });
    }

    initializeCheckAll();
  </script>
<% end %>