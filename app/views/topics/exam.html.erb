<%= turbo_frame_tag "profile_content" do %>
<div class="max-w-5xl mx-auto px-4 py-8">
  <h2 class="text-xl font-bold text-white font-headline-sm uppercase tracking-wider mb-6"><%= t('admin.topics.exam.title', topic: @topic.name) %></h2>
  <%= form_with url: submit_exam_topic_path(@topic), method: :post, data: { controller: 'ensure-complete', 'ensure-complete-message-value': t('messages.assessments.complete_before_submit') }, class: "space-y-6" do %>
    <% @exams.each_with_index do |exam, index| %>
      <div class="p-5 rounded-2xl border border-white/10 bg-surface-container-high/40">
        <p class="font-medium text-white mb-3">
          <%= index + 1 %>. <%= exam.question %>
        </p>
        <% exam.answers.split(",").each do |ans| %>
          <label class="flex items-center gap-2 mb-2 text-slate-300">
            <%= radio_button_tag "answers[#{exam.id}]", ans.strip, false, class: "accent-primary-fixed-dim" %>
            <span><%= ans.strip %></span>
          </label>
        <% end %>
      </div>
    <% end %>
    <div class="flex flex-wrap gap-3 pt-2">
      <%= submit_tag t('admin.topics.exam.submit'), class: "glow-button font-label-tech text-xs uppercase tracking-wider px-6 py-2.5 rounded-xl cursor-pointer" %>
      <%= link_to t('devise.links.back'), learn_course_path(@topic.course, lesson_id: @lesson&.id), class: "inline-flex items-center px-4 py-2.5 rounded-xl border border-outline-variant text-slate-300 hover:text-primary-fixed-dim hover:border-primary-fixed-dim/50 transition font-label-tech text-xs uppercase tracking-wider" %>
    </div>
  <% end %>
</div>
<% end %>