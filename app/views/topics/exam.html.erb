<%= turbo_frame_tag "profile_content" do %>
<div class="container mx-auto m-6">
  <h2 class="text-xl font-semibold mb-6"><%= t('admin.topics.exam.title', topic: @topic.name) %></h2>
  <%= form_with url: submit_exam_topic_path(@topic), method: :post, data: { controller: 'ensure-complete', 'ensure-complete-message-value': t('messages.assessments.complete_before_submit') } do %>
    <% @exams.each_with_index do |exam, index| %>
      <div class="mb-6 p-4 border rounded-xl bg-white">
        <p class="font-medium mb-3">
          <%= index + 1 %>. <%= exam.question %>
        </p>
        <% exam.answers.split(",").each do |ans| %>
          <label class="block mb-2">
            <%= radio_button_tag "answers[#{exam.id}]", ans.strip %>
            <span class="ml-2"><%= ans.strip %></span>
          </label>
        <% end %>
      </div>
    <% end %>
    <%= submit_tag t('admin.topics.exam.submit'),
      class: "bg-blue-600 text-white px-6 py-2 rounded-xl cursor-pointer" %>
    <%= link_to t('devise.links.back'), learn_course_path(@topic.course, lesson_id: @lesson&.id), class: "bg-gray-500 text-white border-1 border-gray-500 px-4 py-2 rounded-xl hover:bg-white hover:text-gray-500 hover:border-1" %>
  <% end %>
  </div>
<% end %>