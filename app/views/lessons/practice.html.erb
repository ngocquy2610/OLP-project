<%= turbo_frame_tag "profile_content" do %>
  <h2 class="text-xl font-semibold mb-6"><%= t('admin.lessons.practice_title') %></h2>
  <%= form_with url: submit_practice_lesson_path(@lesson), method: :post, data: { controller: 'ensure-complete', 'ensure-complete-message-value': 'Hãy hoàn thành toàn bộ bài kiểm tra trước khi nộp bài.' } do %>
    <% @practices.each_with_index do |p, index| %>
      <div class="mb-6 p-4 border rounded-xl bg-white">
        <p class="font-medium mb-3">
          <%= index + 1 %>. <%= p.question %>
        </p>
        <% p.answers.split(",").each do |ans| %>
          <label class="block mb-2">
            <%= radio_button_tag "answers[#{p.id}]", ans.strip %>
            <span class="ml-2"><%= ans.strip %></span>
          </label>
        <% end %>
      </div>
    <% end %>
    <%= submit_tag t('admin.lessons.submit_practice'),
      class: "bg-blue-600 text-white px-6 py-2 rounded-xl" %>
    <%= link_to t('devise.links.back'), learn_course_path(@lesson.topic.course, lesson_id: @lesson.id), class: "bg-gray-500 text-white border-1 border-gray-500 px-4 py-2 rounded-xl hover:bg-white hover:text-gray-500 hover:border-1" %>
  <% end %>
<% end %>