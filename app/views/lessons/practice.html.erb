
<%= turbo_frame_tag "profile_content" do %>
<% practice_minutes = @practices.map { |p| p.time_limit_minutes.to_i }.select { |m| m > 0 } %>
<% practice_time_limit_seconds = practice_minutes.max.to_i * 60 %>
<div class="max-w-5xl mx-auto px-4 py-8">
  <h2 class="text-xl font-bold text-white font-headline-sm uppercase tracking-wider mb-6"><%= t('admin.lessons.practice_title') %></h2>
  <%= form_with url: submit_practice_lesson_path(@lesson), method: :post, data: { controller: 'ensure-complete', 'ensure-complete-message-value': t('messages.assessments.complete_before_submit'), 'ensure-complete-time-limit-value': practice_time_limit_seconds, 'ensure-complete-warning-value': 300 }, class: "space-y-6", id: "practice-form" do %>
    <div class="mb-6 flex items-center justify-between">
      <div class="flex-1"></div>
      <div id="practice-timer" data-ensure-complete-target="timerContainer" class="flex items-center gap-2 px-4 py-2 rounded-lg border border-cyan-400/30 bg-cyan-500/10">
        <span class="material-symbols-outlined text-cyan-400 text-lg">schedule</span>
        <span class="font-label-tech text-sm text-cyan-100">
          <span id="timer-display-practice" data-ensure-complete-target="timerDisplay">00:00</span>
        </span>
      </div>
    </div>
    <% @practices.each_with_index do |p, index| %>
      <div class="p-5 rounded-2xl border border-white/10 bg-surface-container-high/40">
        <p class="font-medium text-white mb-3">
          <%= index + 1 %>. <%= p.question %>
        </p>
        <% p.answers.split(",").each do |ans| %>
          <label class="flex items-center gap-2 mb-2 text-slate-300">
            <%= radio_button_tag "answers[#{p.id}]", ans.strip, false, class: "accent-primary-fixed-dim" %>
            <span><%= ans.strip %></span>
          </label>
        <% end %>
      </div>
    <% end %>
    <div class="flex flex-wrap gap-3 pt-2">
      <%= submit_tag t('admin.lessons.submit_practice'), class: "glow-button font-label-tech text-xs uppercase tracking-wider px-6 py-2.5 rounded-xl cursor-pointer" %>
      <%= link_to t('devise.links.back'), learn_course_path(@lesson.topic.course, lesson_id: @lesson.id), class: "inline-flex items-center px-4 py-2.5 rounded-xl border border-outline-variant text-slate-300 hover:text-primary-fixed-dim hover:border-primary-fixed-dim/50 transition font-label-tech text-xs uppercase tracking-wider" %>
    </div>
  <% end %>
</div>
<% end %>
